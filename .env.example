# microCMS
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
# 書き込み用（scripts/ で使用）
MICROCMS_WRITE_API_KEY=

# Gemini（api/gemini.js）
GEMINI_API_KEY=

# Instagram フィード（api/instagram.js）
# 取得方法は docs/instagram-setup.md を参照
#   node scripts/instagram-token.mjs --app-id <ID> --app-secret <SECRET> --token <短期トークン>
IG_USER_ID=
IG_ACCESS_TOKEN=
# Graph API のバージョン（任意・既定 v23.0）
# IG_GRAPH_VERSION=v23.0
