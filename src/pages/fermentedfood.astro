---
/**
 * 「発酵とは」解説記事
 *
 * 中身は microCMS の knowledge 記事 `fermentation`。
 * Wix 時代からこのURLで公開されており、ヘッダーの KNOWLEDGE メニューと
 * KNOWLEDGE ハブ（/knoweledge）からもこのURLで張られている。URLは変えない。
 *
 * 経緯（2026-09-05）:
 *   6つのナレッジ記事のうち、発酵だけ microCMS に記事が存在せず、
 *   このページは中身のない独自デザインのままだった（本文1,719字＝ほぼナビだけ）。
 *   Wix のバックアップ（wix記事バックアップ/発酵とは_原文.md）から記事を作成し、
 *   他の5記事と同じ KnowledgeArticle で描画するようにした。
 *
 * 文言の編集は microCMS 側で行う（Chie が触れる）。
 */
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import KnowledgeArticle from '../components/knowledge/KnowledgeArticle.astro';
import { getKnowledge } from '../lib/microcms';

const a = await getKnowledge('fermentation');
const url = 'https://www.andlabtokyo.com/fermentedfood';
---
<Layout
  title={a.seoTitle ?? a.title}
  description={a.seoDescription}
  canonical={url}
  ogImage={(a.ogImage ?? a.heroImage)?.url}
>
  <JsonLd slot="head" article={a} url={url} />
  <KnowledgeArticle article={a} />
</Layout>
