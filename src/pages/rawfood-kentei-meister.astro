---
/**
 * ローフードマイスター養成講座（JLBA認定）
 *
 * 本文は Wix の /rawfood-kentei-meister からそのまま移設。
 * このURLは 3か月 115クリック・954表示（サイト4位）。文言が検索を取っているため
 * 文章は変えず、見た目だけ新サイトの体裁に揃える（Chie 指示）。
 *
 * 文言・写真の指定は src/data/courses/rawfood-meister.json。
 */
import Layout from '../layouts/Layout.astro';
import FormGate from '../components/FormGate.astro';
import ApplyFields from '../components/ApplyFields.astro';
import d from '../data/courses/rawfood-meister.json';

const site = 'https://www.andlabtokyo.com';
const url = `${site}/rawfood-kentei-meister`;
const br = (s: string) => s.split('\n').join('<br>');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      '@id': `${url}#course`,
      name: 'ローフードマイスター養成講座',
      description: d.summary,
      url,
      image: `${site}${d.hero.image}`,
      inLanguage: 'ja',
      teaches: [
        'ローフードの基礎（酵素を生かす「生きた食」の考え方）',
        'スムージー・サラダ・スープ・寿司ロールなど14＋αのレシピ実習',
        'カリフラワーライス・アーモンドチャイミルクなどの応用',
        '栄養学・酵素栄養学',
        '簡単なロースイーツへの展開',
        'プロマシンの使い方',
        '体調改善症例のとり方（5人分）',
        '5コースディナーレシピの構成',
        '盛り付けとプレゼンテーション',
        'JLBA検定試験の対策',
      ],
      educationalCredentialAwarded: 'ローフードマイスター 2級／準1級／1級（日本リビングビューティー協会 JLBA 認定）',
      datePublished: d.dates.published,
      dateModified: d.dates.modified,
      author: { '@id': `${site}/instructor-chie-ando#person` },
      provider: { '@type': 'EducationalOrganization', name: '&LAB TOKYO', url: site },
      offers: [
        ...d.levels.map((l) => ({
          '@type': 'Offer',
          name: l.title,
          price: l.price.replace(/[^0-9]/g, ''),
          priceCurrency: 'JPY',
          category: '税別',
          availability: 'https://schema.org/InStock',
        })),
        ...d.pricing.sets.map((s) => ({
          '@type': 'Offer',
          name: s.name,
          price: s.price.replace(/[^0-9]/g, ''),
          priceCurrency: 'JPY',
          category: '税別',
          availability: 'https://schema.org/InStock',
        })),
      ],
      review: d.voices.items.map((v) => ({
        '@type': 'Review',
        reviewBody: v.body,
        author: { '@type': 'Person', name: v.who },
        itemReviewed: { '@id': `${url}#course` },
      })),
      hasCourseInstance: [
        {
          '@type': 'CourseInstance',
          courseMode: 'onsite',
          name: '対面レッスン（東京・表参道）',
          location: {
            '@type': 'Place',
            name: '&LAB TOKYO',
            address: {
              '@type': 'PostalAddress',
              streetAddress: '神宮前',
              addressLocality: '渋谷区',
              addressRegion: '東京都',
              addressCountry: 'JP',
            },
          },
        },
        { '@type': 'CourseInstance', courseMode: 'online', name: 'オンラインレッスン（全国・海外から受講可）' },
      ],
    },
    {
      '@type': 'Person',
      '@id': `${site}/instructor-chie-ando#person`,
      name: '安藤 千英',
      jobTitle: 'ローフード国際プロデューサー／ELLE gourmet 公認料理家',
      url: `${site}/instructor-chie-ando`,
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: d.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'ローフードマイスター養成講座', item: url },
      ],
    },
  ],
};
---

<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- ══ HERO ══ -->
  <section class="hero">
    <img src={d.hero.image} alt={d.hero.imageAlt} width="2000" height="1333" fetchpriority="high" />
    <div class="hero-veil"></div>
    <div class="hero-body">
      <span class="eyebrow eyebrow--light">{d.hero.eyebrow}</span>
      <h1>
        <span set:html={br(d.hero.title)} />
        <span class="h1-sub">{d.hero.subtitle}</span>
      </h1>
      <p class="hero-lead">{d.hero.lead}</p>
      <ul class="hero-steps">{d.hero.badges.map((b) => <li>{b}</li>)}</ul>
      <a href={d.hero.ctaHref} class="btn btn--solid">{d.hero.ctaLabel}</a>
    </div>
  </section>

  <section class="facts">
    <dl class="facts-grid">
      {d.hero.facts.map((f) => (<div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
    </dl>
  </section>

  <!-- ══ ABOUT ══ -->
  <section class="sec sec--linen">
    <div class="inner">
      <div class="about">
        <div class="about-body">
          <span class="eyebrow">{d.about.eyebrow}</span>
          <h2 set:html={br(d.about.title)} />
          {d.about.body.map((p) => <p class="prose-p">{p}</p>)}
        </div>
        <figure class="about-photo">
          <img src={d.about.image} alt={d.about.imageAlt} loading="lazy" decoding="async" />
        </figure>
      </div>
      <dl class="stats">
        {d.about.stats.map((s) => (<div class="stat"><dt>{s.num}</dt><dd>{s.label}</dd></div>))}
      </dl>
    </div>
  </section>

  <!-- ══ 選ばれる理由 ══ -->
  <section class="sec sec--cream">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.reasons.eyebrow}</span>
        <h2>{d.reasons.title}</h2>
      </header>
      <div class="cards-3">
        {d.reasons.items.map((c) => (
          <div class="card"><h3>{c.title}</h3><p>{c.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 3段階 ══ -->
  <section class="sec sec--linen" id="curriculum">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.curriculum.eyebrow}</span>
        <h2 set:html={br(d.curriculum.title)} />
      </header>
      <div class="steps-3">
        {d.curriculum.steps.map((s) => (
          <a class="step-card" href={s.href}>
            <span class="step-no">{s.no}</span>
            <h3>{s.label}</h3>
            <p>{s.body}</p>
            <span class="step-price">{s.price}<small>税別</small></span>
            <span class="step-more">詳しく見る →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 各級 ══ -->
  {d.levels.map((l, i) => (
    <section class={`sec ${i % 2 === 0 ? 'sec--cream' : 'sec--linen'}`} id={l.id}>
      <div class="inner">
        <header class="level-head">
          <span class="eyebrow">{l.step}</span>
          <h2>
            <span class="theme-badge">{l.label}</span>
            <span class="h2-text">{l.title}</span>
          </h2>
          <p class="sec-lead">{l.lead}</p>
        </header>

        <div class="level-top">
          <div class="list-box">
            <h3>{l.recipesTitle}</h3>
            <ul class="dots dots--2col">{l.recipes.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="price-card">
            <span class="price-card__label">{l.label} 受講料</span>
            <span class="price-card__price">{l.price}<small>（{l.priceNote}）</small></span>
            <ul class="price-card__specs">{l.specs.map((s) => <li>{s}</li>)}</ul>
          </div>
        </div>

        <div class={`gallery gallery--${l.photos.length}`}>
          {l.photos.map((p) => (
            <figure class="shot">
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>

        <div class="two">
          <div class="outcomes">
            <h3>この講座に含まれるもの</h3>
            <ul class="ticks">{l.features.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="outcomes">
            <h3>{l.forWhomTitle}</h3>
            <ul class="ticks">{l.forWhom.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ══ サポート ══ -->
  <section class="sec sec--accent">
    <div class="inner">
      <header class="sec-head"><h2>{d.support.title}</h2></header>
      <div class="cards-3">
        {d.support.items.map((c) => (<div class="card"><h3>{c.title}</h3><p>{c.body}</p></div>))}
      </div>
    </div>
  </section>

  <!-- ══ 講師 ══ -->
  <section class="sec sec--linen">
    <div class="inner">
      <div class="teacher">
        <figure class="teacher-photo">
          <img src={d.instructor.image} alt={d.instructor.imageAlt} loading="lazy" decoding="async" width="900" height="900" />
        </figure>
        <div class="teacher-body">
          <span class="eyebrow">{d.instructor.eyebrow}</span>
          <h2>{d.instructor.title}</h2>
          <p class="teacher-role">{d.instructor.role}</p>
          {d.instructor.body.map((p) => <p class="teacher-text">{p}</p>)}
          <p class="inline-link"><a href={d.instructor.linkHref}>{d.instructor.linkLabel} →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 受講生の声 ══ -->
  <section class="sec sec--cream">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.voices.eyebrow}</span>
        <h2>{d.voices.title}</h2>
      </header>
      <div class="voices">
        {d.voices.items.map((v) => (<blockquote class="voice"><p>{v.body}</p><cite>{v.who}</cite></blockquote>))}
      </div>
      <p class="note">{d.voices.note}</p>
    </div>
  </section>

  <!-- ══ 検定 ══ -->
  <section class="sec sec--linen" id="exam">
    <div class="inner">
      <header class="sec-head exam-head">
        <img class="jlba" src={d.exam.logo} alt={d.exam.logoAlt} loading="lazy" decoding="async" width="400" height="400" />
        <div>
          <span class="eyebrow">{d.exam.eyebrow}</span>
          <h2>{d.exam.title}</h2>
          <p class="sec-lead">{d.exam.lead}</p>
        </div>
      </header>
      <table class="spec">
        <tbody>{d.exam.rows.map((r) => (<tr><th scope="row">{r.k}</th><td>{r.v}</td></tr>))}</tbody>
      </table>
      <div class="two two--gap">
        <div class="outcomes">
          <h3>{d.exam.passTitle}</h3>
          <ul class="dots">{d.exam.pass.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="outcomes">
          <h3>{d.exam.submitTitle}</h3>
          <ul class="dots">{d.exam.submit.map((x) => <li>{x}</li>)}</ul>
          <p class="note">{d.exam.submitNote}</p>
        </div>
      </div>
      <p class="note">{d.exam.note}</p>
    </div>
  </section>

  <!-- ══ 受講方法 ══ -->
  <section class="sec sec--cream" id="access">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.access.eyebrow}</span>
        <h2>{d.access.title}</h2>
        <p class="sec-lead">{d.access.lead}</p>
      </header>
      <div class="access">
        {d.access.items.map((a) => (
          <div class="access-card">
            <h3>{a.title}</h3><p>{a.body}</p>
            <ul class="access-tags">{a.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 料金 ══ -->
  <section class="sec sec--linen">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.pricing.eyebrow}</span>
        <h2>{d.pricing.title}</h2>
      </header>
      <table class="pricing">
        <tbody>
          {d.pricing.rows.map((r) => (
            <tr><th scope="row">{r.name}<small>{r.note}</small></th><td>{r.price}<small>税別</small></td></tr>
          ))}
        </tbody>
      </table>
      <div class="sets">
        {d.pricing.sets.map((s) => (
          <div class="set">
            <h3>{s.name}</h3>
            <p>{s.body}</p>
            <p class="set-price"><span class="was">{s.regular}</span><span class="now">{s.price}<small>税別</small></span></p>
          </div>
        ))}
      </div>
      <ul class="notes">{d.pricing.notes.map((n) => <li>{n}</li>)}</ul>
      <p class="updated"><time datetime={d.dates.modified}>{d.dates.label}</time><span>この料金は上記時点のものです。</span></p>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="sec sec--cream">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.faq.eyebrow}</span>
        <h2>{d.faq.title}</h2>
      </header>
      <div class="faq">
        {d.faq.items.map((f, i) => (
          <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ NEXT ══ -->
  <section class="sec sec--linen">
    <div class="inner inner--narrow next-step">
      <span class="eyebrow">{d.next.eyebrow}</span>
      <h2>{d.next.title}</h2>
      <p class="sec-lead">{d.next.body}</p>
      <a href={d.next.linkHref} class="btn btn--outline">{d.next.linkLabel}</a>
    </div>
  </section>

  <!-- ══ 申し込み ══ -->
  <section class="sec sec--cream" id="entry">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.cta.eyebrow}</span>
        <h2>{d.cta.title}</h2>
        <p class="sec-lead">{d.cta.body}</p>
      </header>
      <FormGate
        subject="【ローフードマイスター養成講座】お申し込み・ご相談"
        class="form-grid"
      >
        <ApplyFields
          courses={[
          'ローフードマイスター2級',
          'ローフードマイスター準1級',
          'ローフードマイスター1級',
          '3ステップ 全コースセット',
          '2級＋準1級 2ステップ',
          ]}
          extraDates={true}
        />
      </FormGate>
    </div>
  </section>
</Layout>

<style is:global>
  body { background: #FAF9F6; }
</style>

<style>
  .hero, .facts, .sec {
    --linen:#FAF9F6; --cream:#F6F2EA; --accent:#EFE7D9;
    --ink:#221F1C; --ink-2:#3D3934; --ink-3:#6E6862;
    --amber:#A8794A; --amber-l:#C6A15B;
    --line:rgba(34,31,28,0.12); --sumi:#221C17;
    --fh:'Cormorant Garamond',serif; --fm:'Shippori Mincho','Noto Serif JP',serif;
  }

  .hero { position: relative; height: 74vh; min-height: 560px; max-height: 780px; display: flex; align-items: flex-end; overflow: hidden; }
  .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 46%; }
  .hero-veil { position: absolute; inset: 0; background:
      linear-gradient(to top, rgba(28,22,18,.80) 0%, rgba(28,22,18,.48) 34%, rgba(28,22,18,.08) 70%, transparent 100%),
      linear-gradient(to right, rgba(28,22,18,.44) 0%, rgba(28,22,18,.12) 52%, transparent 78%); }
  .hero-body { position: relative; z-index: 1; width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 32px 56px; }
  .hero h1 { font-family: var(--fm); font-size: clamp(30px, 4.6vw, 56px); font-weight: 600; line-height: 1.4; color: #fff; margin: 0 0 18px; text-shadow: 0 2px 18px rgba(0,0,0,.6), 0 1px 3px rgba(0,0,0,.35); }
  .h1-sub { display: block; margin-top: 14px; font-family: 'Noto Sans JP', sans-serif; font-size: clamp(13px, 1.2vw, 16px); font-weight: 400; letter-spacing: .08em; color: rgba(255,255,255,.94); }
  .hero-lead { font-size: clamp(14px, 1.15vw, 16px); line-height: 2; color: rgba(255,255,255,.94); max-width: 38em; margin: 0 0 22px; text-shadow: 0 1px 10px rgba(0,0,0,.65); }
  .hero-steps { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; padding: 0; }
  .hero-steps li { font-size: 12px; letter-spacing: .06em; color: #fff; border: 1px solid rgba(255,255,255,.5); border-radius: 999px; padding: 7px 15px; backdrop-filter: blur(4px); }

  .facts { background: var(--sumi); padding: 0 32px; }
  .facts-grid { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); }
  .fact { padding: 26px 22px; border-left: 1px solid rgba(255,255,255,.13); }
  .fact:first-child { border-left: 0; }
  .fact dt { font-size: 11px; letter-spacing: .16em; color: var(--amber-l); margin-bottom: 8px; }
  .fact dd { font-size: 15px; color: #F2EDE6; line-height: 1.6; font-weight: 500; }

  .sec { padding: 92px 32px; }
  .sec--linen { background: var(--linen); }
  .sec--cream { background: var(--cream); }
  .sec--accent { background: var(--accent); }
  .inner { max-width: 1080px; margin: 0 auto; }
  .inner--narrow { max-width: 780px; }
  .eyebrow { display: block; font-family: var(--fh); font-size: 12px; letter-spacing: .32em; text-transform: uppercase; color: var(--amber); margin-bottom: 14px; }
  .eyebrow--light { color: #F0DCC0; text-shadow: 0 1px 10px rgba(0,0,0,.55); }
  .sec-head, .level-head { margin-bottom: 44px; }
  h2 { font-family: var(--fm); font-size: clamp(24px, 2.9vw, 38px); font-weight: 600; line-height: 1.5; color: var(--ink); margin: 0 0 18px; text-wrap: balance; }
  .h2-text { display: block; }
  .sec-lead { font-size: 16px; line-height: 2; color: var(--ink-2); max-width: 46em; margin: 0; }
  .prose-p { font-size: 15.5px; line-height: 2.05; color: var(--ink-2); margin: 0 0 16px; }
  .note { font-size: 13px; line-height: 1.95; color: var(--ink-3); margin: 22px 0 0; }
  .inline-link { margin-top: 26px; }
  .inline-link a { font-size: 15px; color: var(--amber); text-decoration: none; border-bottom: 1px solid rgba(168,121,74,.4); padding-bottom: 3px; }

  .btn { display: inline-block; padding: 15px 40px; font-size: 15px; font-weight: 700; text-decoration: none; border-radius: 2px; letter-spacing: .05em; cursor: pointer; border: 0; font-family: inherit; }
  .btn--solid { background: var(--amber-l); color: #221C17; }
  .btn--outline { background: transparent; color: var(--amber); border: 1px solid var(--amber); }

  .about { display: grid; grid-template-columns: 1fr 360px; gap: 52px; align-items: start; margin-bottom: 56px; }
  .about-photo { margin: 0; }
  .about-photo img { width: 100%; height: auto; display: block; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; margin: 0; }
  .stat { background: #fff; padding: 30px 22px; text-align: center; border-top: 2px solid var(--amber-l); }
  .stat dt { font-family: var(--fm); font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; color: var(--ink); }
  .stat dd { font-size: 12.5px; color: var(--ink-3); margin: 8px 0 0; }

  .cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .card { background: #fff; padding: 32px 28px; border-top: 2px solid var(--amber-l); }
  .card h3 { font-family: var(--fm); font-size: 18px; font-weight: 600; color: var(--ink); margin: 0 0 12px; }
  .card p { font-size: 14px; line-height: 1.95; color: var(--ink-2); margin: 0; }

  .steps-3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16px; }
  .step-card { display: flex; flex-direction: column; gap: 10px; background: #fff; border: 1px solid var(--line); padding: 28px 24px 24px; text-decoration: none; transition: border-color .2s, transform .2s; }
  .step-card:hover { border-color: var(--amber-l); transform: translateY(-3px); }
  .step-no { font-family: var(--fh); font-size: 12px; letter-spacing: .16em; color: var(--amber); }
  .step-card h3 { font-family: var(--fm); font-size: 22px; font-weight: 600; color: var(--ink); margin: 0; }
  .step-card p { font-size: 13.5px; line-height: 1.9; color: var(--ink-2); margin: 0; flex: 1; }
  .step-price { font-family: var(--fh); font-size: 26px; font-style: italic; color: var(--amber); }
  .step-price small { font-family: 'Noto Sans JP', sans-serif; font-size: 11px; font-style: normal; color: var(--ink-3); margin-left: 6px; }
  .step-more { font-size: 12px; color: var(--amber); letter-spacing: .06em; }

