---
/**
 * ナッツフリーロースイーツ
 *
 * 本文は Wix の /rawchocolatier/nutfreerawsweets からそのまま移設。
 * 3か月 25クリック・597表示。文言は変えず、見た目だけ新サイトの体裁に。
 * 文言・写真は src/data/courses/nutfree.json。
 */
import Layout from '../../layouts/Layout.astro';
import CoursePage from '../../components/course/CoursePage.astro';
import { courseJsonLd } from '../../lib/course-jsonld';
import d from '../../data/courses/nutfree.json';

const url = 'https://www.andlabtokyo.com/rawchocolatier/nutfreerawsweets';
const jsonLd = courseJsonLd({
  path: '/rawchocolatier/nutfreerawsweets',
  name: 'ナッツフリーロースイーツ（ジェントル&ビーガンロースイーツ）',
  description: d.summary,
  image: d.meta.ogImage,
  teaches: [
    'ナッツを使わないロースイーツの作り方',
    'ココナッツオイルに頼らない固め方',
    'アレルゲンを除いた代用レシピの考え方',
    'プラントベースミルクの選び方',
    'チアシードのプディング・ヨーグルトバーク・ブリスボールなどの実習',
  ],
  offers: [{ name: 'ロースイーツマイスター 初級（ジェントルスイーツ）', price: '44000' }],
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [
    { name: 'ローショコラティエ協会', path: '/rawchocolatier' },
    { name: 'ナッツフリーロースイーツ' },
  ],
  online: true,
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
