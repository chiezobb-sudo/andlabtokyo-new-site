---
/**
 * ローショコラティエ® 資格取得コース
 * 本文は Wix からそのまま移設。ただし料金は 2026-08-30 の確定表に合わせている。
 * 文言・写真は src/data/courses/rawchocolatier-course.json。
 */
import Layout from '../../layouts/Layout.astro';
import CoursePage from '../../components/course/CoursePage.astro';
import { courseJsonLd } from '../../lib/course-jsonld';
import d from '../../data/courses/rawchocolatier-course.json';

const url = 'https://www.andlabtokyo.com/rawchocolatier/rawchocolatier-course';
const jsonLd = courseJsonLd({
  path: '/rawchocolatier/rawchocolatier-course',
  name: 'ローショコラティエ® 資格取得コース',
  description: d.summary,
  image: d.meta.ogImage,
  teaches: [
    'ローチョコレートの製造・加工スキル',
    'ボンボンショコラの成形とテンパリングの原理',
    '絞り・デコレーションの技術',
    'ロースイーツの基本と応用（初級〜上級）',
    'フェアトレード・オーガニック素材と天然着色料の選び方',
    'スクール・ショップ・カフェを想定したブランディングと課題制作',
    '教室開講と販売のための実務',
  ],
  credential: 'ローショコラティエ®（ローショコラティエ協会 認定・商標登録済み）',
  offers: [
    { name: 'ローパティシエ® 全課程', price: '294000' },
    { name: 'ジュニアローショコラティエ 全課程', price: '188000' },
    { name: 'ローショコラティエ®（最高峰・全課程）', price: '482000' },
  ],
  reviews: d.blocks.find((b: any) => b.type === 'voices')?.items.map((v: any) => ({ body: v.body, who: v.who })),
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [
    { name: 'ローショコラティエ協会', path: '/rawchocolatier' },
    { name: 'ローショコラティエ® 資格取得コース' },
  ],
  online: true,
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
