---
import Layout from '../../layouts/Layout.astro';

// Wix /rawchocolatier/rawchocolateconcierge の 2026-08-30 調整版を反映。
// 変更点: マイスター修了者割引 ¥33,000 -> ¥40,000／「作る人ではなく、伝える人へ」の位置づけ／
//         カカオパウダーの選び方を追加／講座概要と「次の一歩」を明記。
const HERO  = '/images/wix/857257_7e3ac6bac6b74440811e0ca8cde340a7-9c898149.jpg';
const CACAO = '/images/wix/857257_b443496df9b548d89bb0fee589783ace-b6a5b184.jpg';

const learn = [
  { n: '01', t: 'ローチョコレートの専門知識',
    b: 'カカオの起源や歴史、製造過程、発酵の役割まで幅広く習得します。「高温焙煎をしない」とはどういうことか、その定義から始めます。' },
  { n: '02', t: 'カカオの官能評価',
    b: '3種類のカカオ豆を食べ比べ、香り、酸味、苦み、余韻の違いを言葉にします。品種はクリオロ、フォラステロ、トリニタリオの3系統。テキストでは、産地9か国の特徴まで解説しています。' },
  { n: '03', t: 'ビーンズトゥーバー製法による体験',
    b: '3種類のカカオ豆から、豆を挽いてチョコレートに仕上げる工程を体験します。テンパリングは、なぜ必要かという仕組みまでを扱います。' },
  { n: '04', t: 'カカオパウダーの選び方',
    b: 'カカオパウダーとココアパウダーは、何が違うのか。売り場で見分ける方法をお伝えします。' },
  { n: '05', t: 'カカオのテロワールと持続可能性',
    b: '生産地の現状、フェアトレードと児童労働、そして沖縄で始まった日本のカカオ栽培について。' },
];

const gains = [
  'ローチョコレートに関する専門知識と、正確に伝える言葉',
  '産地と品種の違いを、自分の舌で判断する経験',
  'クラフト製法の実践体験',
  '持続可能性を意識した食の視点',
  'カカオの味を、自分の言葉で説明できるようになること',
  'ローショコラティエ協会認定 修了証',
];

const spec = [
  ['所要時間',   '約3時間'],
  ['開催形式',   '対面レッスンのみ（東京・&LAB TOKYO 会場）'],
  ['テキスト',   'オリジナルテキスト41ページ（受講料に含みます）'],
  ['お持ち帰り', 'ありません（その場で味わっていただきます）'],
  ['修了',       'ローショコラティエ協会認定 修了証を発行します'],
  ['お支払い',   'クレジットカード決済／銀行振込'],
];

const pillars = [
  { ja: '知識', en: 'knowledge' },
  { ja: '体験', en: 'experience' },
  { ja: '伝承', en: 'tradition' },
];
---
<Layout
  title="ローチョコレートコンシェルジュ｜ローショコラティエ協会認定講座 | &LAB TOKYO"
  description="ローチョコレートコンシェルジュ講座は、専門知識・官能評価・ビーンズトゥーバー体験を通じて体系的に学べる認定プログラムです。現在は対面レッスンのみ開催。受講料 ¥45,000（税別）／ローチョコレートマイスター®講座 受講済みの方 ¥40,000（税別）。"
  canonical="https://www.andlabtokyo.com/rawchocolatier/rawchocolateconcierge"
  ogImage={HERO}
>
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: #1A1715; --bg-2: #1E1B19; --bg-card: #24211E; --bg-dark: #110E0B;
  --amber: #C6A15B; --amber-d: #A8865A;
  --ink: #FAF5EC; --ink-2: #F3EEE5; --ink-3: #C0B6A8;
  --divider: rgba(243,238,229,0.12);
  --fh: 'Cormorant Garamond', serif;
}
body { background: var(--bg); color: var(--ink-2); font-family: 'Noto Sans JP', sans-serif; }
.hero { margin-top: 44px; position: relative; height: 62vh; min-height: 420px; overflow: hidden; display: flex; align-items: flex-end; }
.hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.9) 0%, rgba(0,0,0,.25) 60%, rgba(0,0,0,.15) 100%); }
.hero-body { position: relative; z-index: 1; padding: 0 24px 52px; max-width: 860px; margin: 0 auto; width: 100%; }
.hero-eye { font-family: var(--fh); font-size: 12px; letter-spacing: 4px; text-transform: uppercase; color: var(--amber); margin-bottom: 14px; display: block; }
.hero-lead { font-size: 13px; color: var(--amber); letter-spacing: .06em; margin-bottom: 10px; }
.hero h1 { font-size: clamp(24px, 3.5vw, 42px); font-weight: 700; color: #fff; line-height: 1.25; margin-bottom: 14px; }
.hero-sub { font-size: 15px; color: rgba(255,255,255,0.85); line-height: 1.8; }

.sec { padding: 68px 24px; }
.inner { max-width: 860px; margin: 0 auto; }
.sec-eye { font-family: var(--fh); font-size: 12px; letter-spacing: 4px; text-transform: uppercase; color: var(--amber-d); display: block; margin-bottom: 8px; }
h2 { font-size: clamp(20px, 2.8vw, 32px); font-weight: 700; color: var(--ink); margin-bottom: 24px; line-height: 1.4; }
.rule { width: 36px; height: 2px; background: var(--amber); margin: 20px 0 32px; }
.body-text { font-size: 15px; color: var(--ink-2); line-height: 1.95; margin-bottom: 16px; }
.pull { font-size: clamp(17px, 2.2vw, 22px); font-weight: 700; color: var(--amber); line-height: 1.7; margin-top: 26px; }

.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 32px; }
.pillar { background: var(--bg-card); padding: 26px 18px; text-align: center; }
.pillar-ja { font-size: 20px; font-weight: 700; color: var(--ink); }
.pillar-en { font-family: var(--fh); font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: var(--amber); margin-top: 6px; }

.curriculum { display: flex; flex-direction: column; gap: 2px; margin-top: 28px; }
.cur-item { background: var(--bg-card); padding: 24px 28px; display: flex; gap: 18px; }
.cur-num { font-family: var(--fh); font-size: 28px; color: var(--amber); font-style: italic; opacity: .55; flex-shrink: 0; line-height: 1; }
.cur-item h4 { font-size: 15.5px; font-weight: 700; color: var(--ink); margin-bottom: 8px; }
.cur-item p { font-size: 13.5px; color: var(--ink-3); line-height: 1.85; }

ul.gains { list-style: none; display: grid; gap: 11px; margin-top: 26px; }
ul.gains li { position: relative; padding-left: 26px; font-size: 15px; line-height: 1.85; }
ul.gains li::before { content: '✓'; position: absolute; left: 0; color: var(--amber); font-weight: 700; }

.figure { margin-top: 32px; }
.figure img { width: 100%; height: 300px; object-fit: cover; display: block; border-radius: 3px; }

.spec-box { background: var(--bg-card); padding: 26px 28px; margin-top: 28px; }
.spec-row { display: flex; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--divider); font-size: 14.5px; }
.spec-row:last-child { border-bottom: none; }
.spec-label { color: var(--amber-d); min-width: 92px; flex-shrink: 0; }
.spec-val { color: var(--ink-2); line-height: 1.8; }

.prices { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; margin-top: 24px; }
.price-box { background: var(--bg-card); padding: 30px 24px; text-align: center; }
.price-box h4 { font-size: 13px; color: var(--ink-3); margin-bottom: 10px; line-height: 1.6; }
.price-num { font-family: var(--fh); font-size: 40px; color: var(--amber); font-style: italic; }
.price-note { font-size: 12px; color: var(--ink-3); margin-top: 4px; }

.next { background: var(--bg-card); padding: 34px 30px; margin-top: 30px; border-left: 2px solid var(--amber); }
.next-eye { font-family: var(--fh); font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: var(--amber); display: block; margin-bottom: 10px; }
.next h3 { font-size: 18px; font-weight: 700; color: var(--ink); margin-bottom: 14px; line-height: 1.5; }
.next p { font-size: 14px; color: var(--ink-2); line-height: 1.95; margin-bottom: 12px; }
.next-days { display: flex; gap: 10px; flex-wrap: wrap; margin: 16px 0; }
.next-days span { font-size: 12.5px; color: var(--ink-2); border: 1px solid rgba(198,161,91,.4); border-radius: 999px; padding: 5px 14px; }
.next-price { font-family: var(--fh); font-size: 30px; color: var(--amber); font-style: italic; margin-top: 8px; }
.next-price small { font-family: 'Noto Sans JP', sans-serif; font-size: 12px; font-style: normal; color: var(--ink-3); margin-left: 6px; }
.next a { color: var(--amber); font-size: 13.5px; text-decoration: none; border-bottom: 1px solid rgba(198,161,91,.45); }

.cta-sec { background: var(--bg-dark); text-align: center; padding: 64px 24px; }
.cta-sec p { font-size: 15px; color: var(--ink-3); margin-bottom: 10px; }
.cta-price { font-size: 14px; color: var(--ink-2); line-height: 1.9; margin-bottom: 24px; }
.btn-primary { display: inline-block; background: var(--amber); color: #221C17; font-size: 15px; font-weight: 700; padding: 14px 34px; border-radius: 980px; text-decoration: none; }

@media (max-width: 640px) {
  .prices, .pillars { grid-template-columns: 1fr; }
  .spec-row { flex-direction: column; gap: 4px; }
}
</style>

<section class="hero">
  <img src={HERO} alt="ローチョコレートコンシェルジュ講座" />
  <div class="hero-body">
    <span class="hero-eye">Raw Chocolate Concierge</span>
    <p class="hero-lead">＼ ビーンズトゥーバーから官能評価、カカオを科学的に研究 ／</p>
    <h1>ローチョコレート<br />コンシェルジュ</h1>
    <p class="hero-sub">ローショコラティエ協会認定プログラム</p>
  </div>
</section>

<section class="sec">
  <div class="inner">
    <span class="sec-eye">About</span>
    <h2>コンシェルジュとは、案内人のこと。</h2>
    <div class="rule"></div>
    <p class="body-text">「ローチョコレートって、普通のチョコレートと何が違うの」——そう聞かれたときに、自分の言葉で答えられる人を育てる認定プログラムです。</p>
    <p class="body-text">ローチョコレートの専門知識からビーンズトゥーバー体験、持続可能性までを体系的に学びます。</p>
    <p class="pull">作る人ではなく、伝える人へ。</p>
    <div class="pillars">
      {pillars.map((p) => (
        <div class="pillar">
          <div class="pillar-ja">{p.ja}</div>
          <div class="pillar-en">{p.en}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec" style="background: var(--bg-2);">
  <div class="inner">
    <span class="sec-eye">Curriculum</span>
    <h2>学べること</h2>
    <div class="rule"></div>
    <div class="curriculum">
      {learn.map((l) => (
        <div class="cur-item">
          <div class="cur-num">{l.n}</div>
          <div>
            <h4>{l.t}</h4>
            <p>{l.b}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="figure">
      <img src={CACAO} alt="3種類のカカオ豆とローチョコレート" loading="lazy" />
    </div>
  </div>
</section>

<section class="sec">
  <div class="inner">
    <span class="sec-eye">What You Get</span>
    <h2>この講座で得られるもの</h2>
    <div class="rule"></div>
    <ul class="gains">{gains.map((g) => <li>{g}</li>)}</ul>
  </div>
</section>

<section class="sec" style="background: var(--bg-2);">
  <div class="inner">
    <span class="sec-eye">Info</span>
    <h2>講座概要</h2>
    <div class="rule"></div>
    <div class="spec-box">
      {spec.map(([k, v]) => (
        <div class="spec-row"><span class="spec-label">{k}</span><span class="spec-val" set:html={v} /></div>
      ))}
    </div>
    <div class="prices">
      <div class="price-box">
        <h4>受講料</h4>
        <div class="price-num">¥45,000</div>
        <div class="price-note">税別</div>
      </div>
      <div class="price-box">
        <h4>ローチョコレートマイスター®講座<br />受講済みの方</h4>
        <div class="price-num">¥40,000</div>
        <div class="price-note">税別</div>
      </div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="inner">
    <span class="sec-eye">Next Step</span>
    <h2>次の一歩</h2>
    <div class="rule"></div>
    <div class="next">
      <span class="next-eye">Raw Chocolate Meister</span>
      <h3>ローチョコレートマイスター®講座（1講座／3日間）</h3>
      <p>チョコレートは、うまくいかない理由がわかりにくいお菓子です。白く粉をふく。固まらない。つやが出ない。口の中で重い。なぜそうなったのかを、説明できるようになる講座です。</p>
      <div class="next-days">
        <span>1日目　理論</span><span>2日目　実習</span><span>3日目　実習</span>
      </div>
      <p>丸1日を、理論にあてます。カカオバターの結晶、ブルームの原因、素材ごとの油脂の性質。テキストは理論編と技術編、あわせて141ページ。</p>
      <p>実習では、基本のチョコレートから、ホワイト、ミルク、カラフル、ナッツペースト、トリュフ、生チョコ、ボンボン、ガナッシュまで。理論があるから、レシピを離れても作れます。</p>
      <p>修了された方は、ローチョコレートマイスター®を名乗れます。</p>
      <div class="next-price">¥103,000<small>税別</small></div>
      <p style="margin-top:14px"><a href="/rawchocolatier/rawchocolatemeister">ローチョコレートマイスター講座について詳しく見る →</a></p>
    </div>
  </div>
</section>

<section class="sec" style="background: var(--bg-2);">
  <div class="inner">
    <span class="sec-eye">Raw Chocolate Concierge</span>
    <h2>ローチョコレートコンシェルジュとは</h2>
    <div class="rule"></div>
    <p class="body-text">ローチョコレートに関する深い専門知識と技術を持ち、カカオの起源や歴史、製造方法、そしてカカオの持続可能性について熟知している人のこと。</p>
    <p class="body-text">さらに、カカオ豆からチョコレートを作る「ビーンズトゥーバー」の体験を提供し、その魅力や価値を多くの人に伝える役割を担っています。</p>
  </div>
</section>

<section class="cta-sec">
  <p>レッスンのお申し込みはこちら</p>
  <p class="cta-price">
    ローチョコレートコンシェルジュ講座　¥45,000（税別）<br />
    ローチョコレートマイスター®講座 受講済みの方　¥40,000（税別）
  </p>
  <a href="/contact" class="btn-primary">お申し込み・お問い合わせ</a>
</section>
</Layout>
