---
/**
 * ローショコラティエ協会 公式トップ
 * 本文は Wix の /rawchocolatier からそのまま移設。
 * ※効能表現の3ブロックのみ書き換え（詳細は data の _editNote）。
 */
import Layout from '../../layouts/Layout.astro';
import CoursePage from '../../components/course/CoursePage.astro';
import { courseJsonLd } from '../../lib/course-jsonld';
import d from '../../data/courses/association.json';

const url = 'https://www.andlabtokyo.com/rawchocolatier';
const jsonLd = courseJsonLd({
  path: '/rawchocolatier',
  name: 'ローショコラティエ協会 認定講座',
  description: d.summary,
  image: d.meta.ogImage,
  teaches: [
    'ローチョコレートの理論（カカオの生態・発酵のメカニズム・温度管理）',
    '高温焙煎をしない製法の考え方',
    'ロースイーツの基礎・応用・発展',
    'ナッツフリー／アレルギー対応の代用技術',
    'カカオ豆を使ったオリジナル味噌づくり',
    'ビーンズトゥバーの体験',
  ],
  credential: 'ローチョコレートマイスター®／ローパティシエ®／ローショコラティエ®（いずれも登録商標）',
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: 'ローショコラティエ協会' }],
  online: true,
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="website">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
