---
/**
 * ローパティシエ®養成講座
 *
 * 本文・写真の指定は src/data/courses/rawpatissier.json にある。
 * このファイルは「見た目」だけを持つ。文言の修正は JSON 側を触れば済む。
 */
import Layout from '../../layouts/Layout.astro';
import FormGate from '../../components/FormGate.astro';
import d from '../../data/courses/rawpatissier.json';

const site = 'https://www.andlabtokyo.com';
const url = `${site}/rawchocolatier/rawpatissier`;

/** 改行入りの見出しを <br> に */
const br = (s: string) => s.split('\n').join('<br>');

/** 構造化データ ── 検索とAI（生成エンジン）の両方に、事実をそのまま渡す */
const offers = [
  ...d.levels.map((l) => ({
    '@type': 'Offer',
    name: `${l.step.split('· ')[1]} · ${l.label}講座`,
    price: l.price.replace(/[^0-9]/g, ''),
    priceCurrency: 'JPY',
    category: '税別',
    availability: 'https://schema.org/InStock',
  })),
  {
    '@type': 'Offer',
    name: 'PRO · ローパティシエ® 養成講座',
    price: d.pro.price.replace(/[^0-9]/g, ''),
    priceCurrency: 'JPY',
    category: '税別',
    availability: 'https://schema.org/InStock',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      '@id': `${url}#course`,
      name: 'ローパティシエ®養成講座',
      alternateName: 'ロースイーツマイスター講座',
      description: d.summary,
      url,
      image: `${site}${d.hero.image}`,
      inLanguage: 'ja',
      teaches: [
        '五つの固め方（凍らせる・とろみ・油脂で固める・すりつぶす・吸わせる）',
        '砂糖・乳製品・小麦を使わない甘味料の選び方と、その判断基準',
        'ナッツフリーへの置き換えとアレルゲンの考え方',
        '三つのかたち（型で抜く・層にする・絞る）とナッツの浸水・乾燥',
        '割合で覚えるレシピ設計（クラスト＝ナッツ2〜4：デーツ1）',
        'アンチエイジング理論（酸化・糖化／AGE・油の選び方）',
        '焼かない焼き菓子 ― 低温乾燥で香ばしさと食感を設計する技術',
        '焼かないスポンジ・クリーム・絞りのデコレーション',
        'シン・リビングフード（Synergy／Symbiosis／Synbiotics）と腸内細菌の考え方',
        'ロースイーツを教えるための指導技術とレッスン設計',
        '卒業課題によるオリジナルレシピの開発',
      ],
      educationalCredentialAwarded: 'ローパティシエ®（ローショコラティエ協会 認定資格）',
      provider: {
        '@type': 'EducationalOrganization',
        name: '&LAB TOKYO',
        url: site,
        sameAs: 'https://www.instagram.com/chie_andlab/',
      },
      offers,
      hasCourseInstance: [
        {
          '@type': 'CourseInstance',
          courseMode: 'onsite',
          name: '対面レッスン（東京・表参道）',
          location: {
            '@type': 'Place',
            name: '&LAB TOKYO',
            address: {
              '@type': 'PostalAddress',
              streetAddress: '神宮前5-2-11',
              addressLocality: '渋谷区',
              addressRegion: '東京都',
              postalCode: '150-0001',
              addressCountry: 'JP',
            },
          },
        },
        {
          '@type': 'CourseInstance',
          courseMode: 'online',
          name: 'オンラインレッスン（全国・海外から受講可）',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: d.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: 'ローショコラティエ協会', item: `${site}/rawchocolatier` },
        { '@type': 'ListItem', position: 3, name: 'ローパティシエ®養成講座', item: url },
      ],
    },
  ],
};

const allLevels = [...d.levels];
---

<Layout
  title={d.meta.title}
  description={d.meta.description}
  canonical={url}
  ogImage={d.meta.ogImage}
  type="article"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- ══════════ HERO ══════════ -->
  <section class="hero">
    <img src={d.hero.image} alt={d.hero.imageAlt} width="2000" height="1125" fetchpriority="high" />
    <div class="hero-veil"></div>
    <div class="hero-body">
      <span class="eyebrow eyebrow--light">{d.hero.eyebrow}</span>
      <h1>
        <span set:html={br(d.hero.title)} />
        <span class="h1-sub">{d.hero.subtitle}</span>
      </h1>
      <p class="hero-lead">{d.hero.lead}</p>
      <a href={d.hero.ctaHref} class="btn btn--solid">{d.hero.ctaLabel}</a>
    </div>
  </section>

  <!-- 事実の帯：検索でもAIでも、まずここが読まれる -->
  <section class="facts">
    <dl class="facts-grid">
      {d.hero.facts.map((f) => (
        <div class="fact">
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ══════════ WHAT IS RAW SWEETS ══════════ -->
  <section class="sec sec--linen">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.whatIs.eyebrow}</span>
        <h2 set:html={br(d.whatIs.title)} />
        <p class="sec-lead">{d.whatIs.lead}</p>
      </header>
      <div class="cards-4">
        {d.whatIs.cards.map((c) => (
          <div class="card">
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
      <p class="inline-link">
        <a href={d.whatIs.linkHref}>{d.whatIs.linkLabel} →</a>
      </p>
    </div>
  </section>

  <!-- ══════════ CONCEPT · シン・リビングフード ══════════ -->
  <section class="sec sec--cream">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.concept.eyebrow}</span>
        <h2 set:html={br(d.concept.title)} />
        <p class="sec-lead">{d.concept.lead}</p>
      </header>
      <div class="prose">
        {d.concept.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="formula">
        <span class="formula-label">{d.concept.formulaLabel}</span>
        <p class="formula-body">{d.concept.formula}</p>
      </div>
      <div class="principles">
        {d.concept.principles.map((p) => (
          <div class="principle">
            <span class="principle-no">{p.no}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <div class="shin">
        <h3>{d.concept.shinMeaning.title}</h3>
        <div class="shin-grid">
          {d.concept.shinMeaning.items.map((s) => (
            <div class="shin-item">
              <span class="shin-en">{s.en}</span>
              <span class="shin-ja">{s.ja}</span>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="shin-note">{d.concept.shinMeaning.note}</p>
      </div>
      <p class="note">{d.concept.note}</p>
      <p class="sig-name">{d.concept.signature}</p>
    </div>
  </section>

  <!-- ══════════ ROADMAP ══════════ -->
  <section class="sec sec--linen" id="curriculum">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.roadmap.eyebrow}</span>
        <h2 set:html={br(d.roadmap.title)} />
        <p class="sec-lead">{d.roadmap.lead}</p>
      </header>
      <div class="steps-4">
        {allLevels.map((l) => (
          <a class="step-card" href={`#${l.id}`}>
            <span class="step-no">{l.no}｜{l.label}</span>
            <h3>{l.theme}</h3>
            <p>{l.lead.slice(0, 58)}…</p>
            <span class="step-price">{l.price}<small>税別</small></span>
            <span class="step-more">詳しく見る →</span>
          </a>
        ))}
        <a class="step-card step-card--pro" href="#pro">
          <span class="step-no">{d.pro.no}｜{d.pro.label}</span>
          <h3>{d.pro.theme}</h3>
          <p>{d.pro.lead[0].slice(0, 58)}…</p>
          <span class="step-price">{d.pro.price}<small>税別</small></span>
          <span class="step-more">詳しく見る →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════ 各級の詳細 ══════════ -->
  {allLevels.map((l, i) => (
    <section class={`sec level ${i % 2 === 0 ? 'sec--cream' : 'sec--linen'}`} id={l.id}>
      <div class="inner">
        <header class="level-head">
          <span class="eyebrow">{l.step}</span>
          <h2>
            <span class="theme-badge">{l.label}｜{l.theme}</span>
            <span class="h2-text" set:html={br(l.headline)} />
          </h2>
          <p class="sec-lead">{l.lead}</p>
        </header>

        <div class="level-top">
          <ul class="ticks">
            {l.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <div class="price-card">
            <span class="price-card__label">{l.label}講座 受講料</span>
            <span class="price-card__price">{l.price}<small>（{l.priceNote}）</small></span>
            <ul class="price-card__specs">
              {l.specs.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </div>

        <!-- どんなものを作るのか、写真で -->
        <h3 class="sub-head">この講座で作るもの</h3>
        <div class={`gallery gallery--${l.photos.length}`}>
          {l.photos.map((p) => (
            <figure class="shot">
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>

        <!-- この級の中核になる考え方 -->
        <div class="signature">
          <h3>{l.signature.title}</h3>
          <p class="signature-lead">{l.signature.lead}</p>
          <div class={`sig-grid sig-grid--${l.signature.items.length}`}>
            {l.signature.items.map((s) => (
              <div class="sig">
                <span class="sig-no">{s.no}</span>
                <span class="sig-en">{s.en}</span>
                <h4>{s.ja}</h4>
                <p>{s.body}</p>
              </div>
            ))}
          </div>
          {l.signature.note && <p class="signature-note">{l.signature.note}</p>}
        </div>

        <!-- 全4日間の流れ（上級のみ） -->
        {l.schedule && (
          <div class="schedule">
            <h3 class="sub-head">{l.schedule.title}</h3>
            <ol class="days">
              {l.schedule.days.map((day) => (
                <li class="day">
                  <span class="day-no">{day.day}</span>
                  <div class="day-body">
                    <h4>{day.theme}</h4>
                    <p class="day-menu">{day.body}</p>
                    <p class="day-point">▷ {day.point}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        <!-- 公式テキスト -->
        <div class="book">
          <figure class="book-cover">
            <img src={l.book.cover} alt={l.book.coverAlt} loading="lazy" decoding="async" />
          </figure>
          <div class="book-body">
            <span class="book-kicker">OFFICIAL TEXTBOOK</span>
            <h3>{l.book.title}</h3>
            <p class="book-sub">{l.book.subtitle}</p>
            <p class="book-spec">{l.book.spec}</p>
            <h4>{l.book.chaptersTitle}</h4>
            <ul class="chapters">{l.book.chapters.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>

        <div class="recipe-groups">
          <h3 class="sub-head">テキスト掲載レシピ</h3>
          <div class="rg-grid">
            {l.book.recipeGroups.map((g) => (
              <div class="rg">
                <h4>{g.title}</h4>
                <ul class="dots">{g.items.map((r) => <li>{r}</li>)}</ul>
              </div>
            ))}
          </div>
        </div>

        <div class="outcomes">
          <h3>{l.outcomesTitle}</h3>
          <ul class="ticks ticks--2col">
            {l.outcomes.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <!-- ══════════ PRO ══════════ -->
  <section class="sec sec--dark" id="pro">
    <div class="inner">
      <header class="level-head">
        <span class="eyebrow eyebrow--gold">{d.pro.eyebrow}</span>
        <span class="theme-badge theme-badge--gold">{d.pro.no}｜{d.pro.label}</span>
        <h2>{d.pro.title}</h2>
        <p class="sec-lead">{d.pro.subtitle}</p>
      </header>
      <div class="prose prose--light">
        {d.pro.lead.map((p) => <p>{p}</p>)}
      </div>

      <div class="cols-3">
        {d.pro.columns.map((c) => (
          <div class="col">
            <h3>{c.title}</h3>
            <ul class="dots dots--light">{c.items.map((i2) => <li>{i2}</li>)}</ul>
          </div>
        ))}
      </div>

      <div class="price-card price-card--gold">
        <span class="price-card__label">PRO · ローパティシエ® 養成講座</span>
        <span class="price-card__price">{d.pro.price}<small>（{d.pro.priceNote}）</small></span>
        <ul class="price-card__specs">
          {d.pro.specs.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <!-- 卒業課題 -->
      <h3 class="sub-head sub-head--light">{d.pro.graduation.title}</h3>
      <p class="prose--light" style="margin-bottom:26px"><span class="grad-lead">{d.pro.graduation.lead}</span></p>
      <div class="grads">
        {d.pro.graduation.items.map((g) => (
          <div class="grad">
            <h4>{g.name}</h4>
            <p>{g.body}</p>
          </div>
        ))}
      </div>

      <!-- 別冊テキスト -->
      <div class="book book--dark">
        <figure class="book-cover">
          <img src={d.pro.book.cover} alt={d.pro.book.coverAlt} loading="lazy" decoding="async" />
        </figure>
        <div class="book-body">
          <span class="book-kicker">OFFICIAL TEXTBOOK</span>
          <h3>{d.pro.book.title}</h3>
          <p class="book-sub">{d.pro.book.subtitle}</p>
          <p class="book-spec">{d.pro.book.spec}</p>
          <h4>{d.pro.book.chaptersTitle}</h4>
          <ul class="chapters">{d.pro.book.chapters.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>

      <!-- 教える技術 -->
      <h3 class="sub-head sub-head--light">{d.pro.teaching.title}</h3>
      <ul class="ticks ticks--2col ticks--light">
        {d.pro.teaching.items.map((t) => <li>{t}</li>)}
      </ul>

      <!-- 認定ステップ -->
      <h3 class="sub-head sub-head--light">{d.pro.steps.title}</h3>
      <div class="routes">
        {d.pro.steps.routes.map((r) => (
          <div class="route">
            <span class="route-label">{r.label}</span>
            <p>{r.body}</p>
          </div>
        ))}
      </div>

      <h3 class="sub-head sub-head--light">{d.pro.forWhomTitle}</h3>
      <ul class="chips">
        {d.pro.forWhom.map((w) => <li>{w}</li>)}
      </ul>
      <p class="note note--light">{d.pro.nextNote}</p>
    </div>
  </section>

  <!-- ══════════ VOICES ══════════ -->
  <section class="sec sec--linen">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.voices.eyebrow}</span>
        <h2>{d.voices.title}</h2>
        <p class="sec-lead">{d.voices.lead}</p>
      </header>
      <div class="voices">
        {d.voices.items.map((v) => (
          <blockquote class="voice">
            <p>{v.body}</p>
            <cite>{v.who}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ PATHWAY ══════════ -->
  <section class="sec sec--cream">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.pathway.eyebrow}</span>
        <h2>{d.pathway.title}</h2>
        <p class="sec-lead">{d.pathway.lead}</p>
      </header>
      <figure class="pathway">
        <img src={d.pathway.image} alt={d.pathway.imageAlt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <!-- ══════════ ASSOCIATION ══════════ -->
  <section class="sec sec--linen">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.association.eyebrow}</span>
        <h2>{d.association.title}</h2>
        <p class="sec-lead">{d.association.subtitle}</p>
      </header>
      <div class="prose">
        {d.association.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="benefits">
        <h3>{d.association.benefitsTitle}</h3>
        <ul class="ticks ticks--2col">
          {d.association.benefits.map((b) => <li>{b}</li>)}
        </ul>
      </div>
      <p class="inline-link">
        <a href={d.association.linkHref}>{d.association.linkLabel} →</a>
      </p>
    </div>
  </section>

  <!-- ══════════ PRICING ══════════ -->
  <section class="sec sec--cream">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.pricing.eyebrow}</span>
        <h2>{d.pricing.title}</h2>
        <p class="sec-lead">{d.pricing.lead}</p>
      </header>
      <table class="pricing">
        <tbody>
          {d.pricing.rows.map((r) => (
            <tr>
              <th scope="row">{r.name}</th>
              <td>{r.price}<small>税別</small></td>
            </tr>
          ))}
          <tr class="pricing__total">
            <th scope="row">{d.pricing.totalLabel}</th>
            <td>{d.pricing.total}<small>{d.pricing.totalNote}</small></td>
          </tr>
        </tbody>
      </table>
      <ul class="notes">
        {d.pricing.notes.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>

  <!-- ══════════ FAQ ══════════ -->
  <section class="sec sec--linen">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.faq.eyebrow}</span>
        <h2>{d.faq.title}</h2>
      </header>
      <div class="faq">
        {d.faq.items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════ NEXT STEP ══════════ -->
  <section class="sec sec--cream">
    <div class="inner inner--narrow next-step">
      <span class="eyebrow">{d.next.eyebrow}</span>
      <h2>{d.next.title}</h2>
      <p class="sec-lead">{d.next.body}</p>
      <a href={d.next.linkHref} class="btn btn--outline">{d.next.linkLabel}</a>
    </div>
  </section>

  <!-- ══════════ ENTRY ══════════ -->
  <section class="sec sec--linen" id="entry">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.cta.eyebrow}</span>
        <h2>{d.cta.title}</h2>
        <p class="sec-lead">{d.cta.body}</p>
      </header>
      <FormGate
        subject="【ローパティシエ®養成講座】お申し込み・ご相談"
        mailBody={'お名前：\nご希望コース（初級／中級／上級／プロ養成）：\nご希望の受講形式（対面／オンライン）：\n希望日程（第一〜第三希望）：\nご質問：\n'}
        class="form-grid"
      >
        <label>お名前<span>*</span><input type="text" name="name" required /></label>
        <label>メールアドレス<span>*</span><input type="email" name="email" required /></label>
        <label>お電話番号<input type="tel" name="tel" /></label>
        <label>ご希望コース<span>*</span>
          <select name="course" required>
            <option value="">選択してください</option>
            <option>BASIC・初級講座</option>
            <option>INTERMEDIATE・中級講座</option>
            <option>ADVANCE・上級講座</option>
            <option>PRO・ローパティシエ®養成講座</option>
            <option>全課程</option>
            <option>まだ決めていない／相談したい</option>
          </select>
        </label>
        <label>ご希望の受講形式
          <select name="mode">
            <option value="">選択してください</option>
            <option>対面（東京・表参道）</option>
            <option>オンライン</option>
          </select>
        </label>
        <label>希望日程（第一希望）<input type="text" name="date1" placeholder="例：10月中旬の平日" /></label>
        <label class="full">お問い合わせ・ご質問<textarea name="message" rows="5"></textarea></label>
        <button type="submit" class="btn btn--solid">送信する</button>
      </FormGate>
    </div>
