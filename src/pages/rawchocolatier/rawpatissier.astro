<style>
  /* ── このページのトーン。黒基調をやめ、明るいリネン地に統一する ── */
  .hero, .facts, .sec {
    --linen:  #FAF9F6;
    --cream:  #F6F2EA;
    --ink:    #221F1C;   /* 見出し。薄い文字をやめ、しっかり読める濃さに */
    --ink-2:  #3D3934;   /* 本文 */
    --ink-3:  #6E6862;   /* 補助。#8C8C8A より濃くしてコントラストを確保 */
    --amber:  #A8794A;
    --amber-l:#C6A15B;
    --line:   rgba(34,31,28,0.12);
    --sumi:   #221C17;
    --fh:     'Cormorant Garamond', serif;
    --fm:     'Shippori Mincho', 'Noto Serif JP', serif;
  }

  /* ══ HERO ══ */
  .hero {
    /* main 側に padding-top:73px（ヘッダー分）が既にある。ここで足すと二重に空く */
    position: relative;
    height: 66vh;
    min-height: 520px;
    max-height: 720px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  /* 文字が乗る左下だけを確実に暗く落とす。全面を暗くしないので写真は明るいまま */
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(28,22,18,.86) 0%, rgba(28,22,18,.55) 34%, rgba(28,22,18,.06) 68%, transparent 100%),
      linear-gradient(to right, rgba(28,22,18,.55) 0%, rgba(28,22,18,.12) 52%, transparent 78%);
  }
  .hero-body { position: relative; z-index: 1; width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 32px 56px; }
  .hero h1 {
    font-family: var(--fm);
    font-size: clamp(28px, 4.2vw, 52px);
    font-weight: 600;
    line-height: 1.42;
    color: #fff;
    margin: 0 0 20px;
    text-wrap: balance;
    text-shadow: 0 2px 20px rgba(0,0,0,.42);
  }
  .hero-lead {
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 2;
    color: rgba(255,255,255,.94);
    max-width: 40em;
    margin: 0 0 30px;
    text-shadow: 0 1px 12px rgba(0,0,0,.5);
  }

  /* ══ 事実の帯 ══ */
  .facts { background: var(--sumi); padding: 0 32px; }
  .facts-grid {
    max-width: 1080px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .fact { padding: 26px 22px; border-left: 1px solid rgba(255,255,255,.13); }
  .fact:first-child { border-left: 0; }
  .fact dt { font-size: 11px; letter-spacing: .16em; color: var(--amber-l); margin-bottom: 8px; }
  .fact dd { font-size: 15px; color: #F2EDE6; line-height: 1.6; font-weight: 500; }

  /* ══ セクション共通 ══ */
  .sec { padding: 92px 32px; }
  .sec--linen { background: var(--linen); }
  .sec--cream { background: var(--cream); }
  .sec--dark  { background: var(--sumi); }
  .inner { max-width: 1080px; margin: 0 auto; }
  .inner--narrow { max-width: 780px; }

  .eyebrow {
    display: block; font-family: var(--fh);
    font-size: 12px; letter-spacing: .32em; text-transform: uppercase;
    color: var(--amber); margin-bottom: 14px;
  }
  .eyebrow--light { color: #F0DCC0; text-shadow: 0 1px 10px rgba(0,0,0,.55); }
  .eyebrow--gold  { color: var(--amber-l); }

  .sec-head, .level-head { margin-bottom: 44px; }
  h2 {
    font-family: var(--fm);
    font-size: clamp(24px, 2.9vw, 38px);
    font-weight: 600; line-height: 1.5; color: var(--ink);
    margin: 0 0 18px; text-wrap: balance;
  }
  .sec--dark h2 { color: #F7F2EA; }
  .sec-lead { font-size: 16px; line-height: 2; color: var(--ink-2); max-width: 46em; margin: 0; }
  .sec--dark .sec-lead { color: #D8D0C6; }

  .prose p { font-size: 16px; line-height: 2.05; color: var(--ink-2); margin: 0 0 20px; }
  .prose--light p { color: #D8D0C6; }

  .note { font-size: 14px; line-height: 1.95; color: var(--ink-3); margin: 28px 0 0; }
  .note--light { color: #A79C8F; }
  .sig-name { font-size: 14px; color: var(--ink-3); margin-top: 12px; }

  /* ══ シンの3つの意味 ══ */
  .shin { margin-top: 46px; background: #fff; border: 1px solid var(--line); padding: 34px 32px; }
  .shin h3 { font-family: var(--fm); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 22px; }
  .shin-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  .shin-en { display: block; font-family: var(--fh); font-size: 19px; font-style: italic; color: var(--amber); }
  .shin-ja { display: block; font-size: 13px; font-weight: 700; color: var(--ink); margin: 4px 0 8px; }
  .shin-item p { font-size: 13.5px; line-height: 1.9; color: var(--ink-2); margin: 0; }
  .shin-note { font-size: 13px; color: var(--ink-3); margin: 22px 0 0; }

  /* ══ 各級の中核になる考え方 ══ */
  .signature { margin-bottom: 56px; background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--amber); padding: 36px 34px; }
  .signature h3 { font-family: var(--fm); font-size: 20px; font-weight: 600; color: var(--ink); margin: 0 0 14px; }
  .signature-lead { font-size: 15px; line-height: 2; color: var(--ink-2); margin: 0 0 28px; max-width: 46em; }
  .sig-grid { display: grid; gap: 24px; }
  .sig-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .sig-grid--5 { grid-template-columns: repeat(5, 1fr); }
  .sig { border-top: 1px solid var(--line); padding-top: 16px; }
  .sig-no { font-family: var(--fh); font-size: 15px; font-style: italic; color: var(--amber); }
  .sig-en { display: block; font-family: var(--fh); font-size: 15px; color: var(--ink-3); letter-spacing: .04em; margin-top: 2px; }
  .sig h4 { font-family: var(--fm); font-size: 15px; font-weight: 600; color: var(--ink); margin: 6px 0 8px; }
  .sig p { font-size: 12.5px; line-height: 1.85; color: var(--ink-2); margin: 0; }
  .signature-note { font-size: 13.5px; line-height: 1.95; color: var(--ink-3); margin: 26px 0 0; padding-top: 20px; border-top: 1px solid var(--line); }

  /* ══ 全4日間の流れ ══ */
  .schedule { margin-bottom: 56px; }
  .days { list-style: none; margin: 0; padding: 0; }
  .day { display: grid; grid-template-columns: 88px 1fr; gap: 22px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .day:first-child { border-top: 1px solid var(--line); }
  .day-no { font-family: var(--fh); font-size: 17px; font-style: italic; color: var(--amber); padding-top: 2px; }
  .day-body h4 { font-family: var(--fm); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 10px; }
  .day-menu { font-size: 14px; line-height: 1.9; color: var(--ink-2); margin: 0 0 8px; }
  .day-point { font-size: 13px; line-height: 1.85; color: var(--amber); margin: 0; }

  /* ══ 公式テキスト ══ */
  .book { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: start; background: #fff; border: 1px solid var(--line); padding: 36px; margin-bottom: 52px; }
  .book--dark { background: rgba(255,255,255,.05); border-color: rgba(255,255,255,.14); margin-top: 46px; }
  .book-cover { margin: 0; }
  .book-cover img { width: 100%; height: auto; display: block; box-shadow: 0 10px 34px rgba(34,28,23,.28); }
  .book-kicker { display: block; font-family: var(--fh); font-size: 11px; letter-spacing: .3em; color: var(--amber); margin-bottom: 10px; }
  .book--dark .book-kicker { color: var(--amber-l); }
  .book-body h3 { font-family: var(--fm); font-size: 21px; font-weight: 600; color: var(--ink); margin: 0 0 8px; }
  .book--dark .book-body h3 { color: #F7F2EA; }
  .book-sub { font-family: var(--fh); font-size: 16px; font-style: italic; color: var(--ink-3); margin: 0 0 6px; }
  .book-spec { font-size: 13px; color: var(--ink-2); margin: 0 0 26px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .book--dark .book-sub { color: #A79C8F; }
  .book--dark .book-spec { color: #C9C0B6; border-bottom-color: rgba(255,255,255,.14); }
  .book-body h4 { font-size: 13px; font-weight: 700; letter-spacing: .06em; color: var(--ink-3); margin: 0 0 14px; }
  .book--dark .book-body h4 { color: var(--amber-l); }
  .chapters { list-style: none; margin: 0; padding: 0; }
  .chapters li { font-size: 14px; line-height: 1.9; color: var(--ink-2); padding: 7px 0; border-bottom: 1px dotted var(--line); }
  .chapters li:last-child { border-bottom: 0; }
  .book--dark .chapters li { color: #D8D0C6; border-bottom-color: rgba(255,255,255,.1); }

  /* ══ 掲載レシピ ══ */
  .recipe-groups { margin-bottom: 52px; }
  .rg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 44px; }
  .rg h4 { font-family: var(--fm); font-size: 16px; font-weight: 600; color: var(--ink); margin: 0 0 14px; }

  /* ══ 卒業課題 ══ */
  .grad-lead { display: block; font-size: 15px; line-height: 2; color: #D8D0C6; max-width: 46em; }
  .grads { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 8px; }
  .grad { border: 1px solid rgba(198,161,91,.35); padding: 24px 22px; }
  .grad h4 { font-family: var(--fm); font-size: 17px; font-weight: 600; color: var(--amber-l); margin: 0 0 10px; }
  .grad p { font-size: 13px; line-height: 1.9; color: #C9C0B6; margin: 0; }

  .ticks--light li { color: #E8E1D8; }
  .ticks--light li::before { border-right-color: var(--amber-l); border-bottom-color: var(--amber-l); }

  /* ══ 認定ステップ ══ */
  .routes { display: grid; gap: 12px; }
  .route { background: rgba(255,255,255,.05); border-left: 2px solid var(--amber-l); padding: 20px 24px; }
  .route-label { display: block; font-size: 12px; font-weight: 700; letter-spacing: .1em; color: var(--amber-l); margin-bottom: 8px; }
  .route p { font-size: 14px; line-height: 1.95; color: #D8D0C6; margin: 0; }

  .inline-link { margin-top: 30px; }
  .inline-link a {
    font-size: 15px; color: var(--amber); text-decoration: none;
    border-bottom: 1px solid rgba(168,121,74,.4); padding-bottom: 3px;
  }
  .inline-link a:hover { border-bottom-color: var(--amber); }

  /* ══ ボタン ══ */
  .btn {
    display: inline-block; padding: 15px 40px; font-size: 15px; font-weight: 700;
    text-decoration: none; border-radius: 2px; letter-spacing: .05em; cursor: pointer;
    border: 0; font-family: inherit;
  }
  .btn--solid { background: var(--amber-l); color: #221C17; }
  .btn--solid:hover { background: #D6B472; }
  .btn--outline { background: transparent; color: var(--amber); border: 1px solid var(--amber); }
  .btn--outline:hover { background: var(--amber); color: #fff; }

  /* ══ 4枚カード ══ */
  .cards-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .card { background: #fff; padding: 34px 28px; border-top: 2px solid var(--amber-l); }
  .card h3 { font-family: var(--fm); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 12px; }
  .card p { font-size: 14px; line-height: 1.95; color: var(--ink-2); margin: 0; }

  /* ══ シン・リビングフード ══ */
  .formula { text-align: center; margin: 46px 0; padding: 34px 24px; background: #fff; border: 1px solid var(--line); }
  .formula-label { display: block; font-family: var(--fh); font-size: 11px; letter-spacing: .3em; color: var(--amber); margin-bottom: 12px; }
  .formula-body { font-family: var(--fm); font-size: clamp(17px, 2.1vw, 24px); color: var(--ink); margin: 0; line-height: 1.6; }
  .principles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; margin-top: 8px; }
  .principle { border-top: 1px solid var(--line); padding-top: 20px; }
  .principle-no { font-family: var(--fh); font-size: 13px; letter-spacing: .2em; color: var(--amber); }
  .principle h3 { font-family: var(--fm); font-size: 16px; font-weight: 600; color: var(--ink); margin: 8px 0 10px; }
  .principle p { font-size: 13.5px; line-height: 1.95; color: var(--ink-2); margin: 0; }

  /* ══ 4ステップ ══ */
  .steps-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step-card {
    display: flex; flex-direction: column; gap: 10px;
    background: #fff; border: 1px solid var(--line); padding: 28px 24px 24px;
    text-decoration: none; transition: border-color .2s, transform .2s;
  }
  .step-card:hover { border-color: var(--amber-l); transform: translateY(-3px); }
  .step-card--pro { background: var(--sumi); border-color: var(--sumi); }
  .step-no { font-size: 12px; letter-spacing: .14em; color: var(--amber); }
  .step-card--pro .step-no { color: var(--amber-l); }
  .step-card h3 { font-family: var(--fm); font-size: 19px; font-weight: 600; color: var(--ink); margin: 0; }
  .step-card--pro h3 { color: #F7F2EA; }
  .step-card p { font-size: 13px; line-height: 1.85; color: var(--ink-2); margin: 0; flex: 1; }
  .step-card--pro p { color: #C9C0B6; }
  .step-price { font-family: var(--fh); font-size: 25px; font-style: italic; color: var(--amber); }
  .step-price small { font-family: 'Noto Sans JP', sans-serif; font-size: 11px; font-style: normal; color: var(--ink-3); margin-left: 6px; }
  .step-card--pro .step-price { color: var(--amber-l); }
  .step-card--pro .step-price small { color: #A79C8F; }
  .step-more { font-size: 12px; color: var(--amber); letter-spacing: .06em; }
  .step-card--pro .step-more { color: var(--amber-l); }

  /* ══ 各級 ══ */
  .h1-sub {
    display: block; margin-top: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    font-size: clamp(12px, 1.1vw, 15px); font-weight: 400; letter-spacing: .08em;
    color: rgba(255,255,255,.9);
  }

  /* バッジは見出しの中に置く（SEO上「初級/中級/上級」をh2に含めるため）が、行は分ける */
  .h2-text { display: block; }
  .theme-badge {
    display: inline-block; margin-bottom: 16px; padding: 7px 18px;
    font-family: 'Noto Sans JP', sans-serif;
    background: var(--amber); color: #fff; font-size: 13px; font-weight: 700; letter-spacing: .08em;
  }
  .theme-badge--gold { background: var(--amber-l); color: #221C17; }

  .level-top { display: grid; grid-template-columns: 1fr 320px; gap: 40px; align-items: start; margin-bottom: 56px; }
  .price-card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--amber); padding: 28px 26px; }
  .price-card__label { display: block; font-size: 12px; letter-spacing: .1em; color: var(--ink-3); margin-bottom: 10px; }
  .price-card__price { display: block; font-family: var(--fh); font-size: 40px; font-style: italic; color: var(--amber); line-height: 1; }
  .price-card__price small { font-family: 'Noto Sans JP', sans-serif; font-size: 12px; font-style: normal; color: var(--ink-3); margin-left: 6px; }
  .price-card__specs { list-style: none; margin: 18px 0 0; padding: 0; }
  .price-card__specs li { font-size: 13px; color: var(--ink-2); line-height: 2; }
  .price-card--gold { background: rgba(255,255,255,.06); border-color: rgba(198,161,91,.4); border-top-color: var(--amber-l); margin: 40px 0; }
  .price-card--gold .price-card__label { color: #A79C8F; }
  .price-card--gold .price-card__price { color: var(--amber-l); }
  .price-card--gold .price-card__price small,
  .price-card--gold .price-card__specs li { color: #C9C0B6; }

  .ticks { list-style: none; margin: 0; padding: 0; }
  .ticks li { position: relative; padding-left: 26px; font-size: 15px; line-height: 2.05; color: var(--ink-2); margin-bottom: 6px; }
  /* チェックマーク（矢印に見えないよう縦長にする） */
  .ticks li::before { content: ''; position: absolute; left: 6px; top: 11px; width: 6px; height: 11px; border-right: 1.7px solid var(--amber); border-bottom: 1.7px solid var(--amber); transform: rotate(42deg); }
  .ticks--2col { columns: 2; column-gap: 40px; }
  .ticks--2col li { break-inside: avoid; }

  .sub-head { font-family: var(--fm); font-size: 19px; font-weight: 600; color: var(--ink); margin: 0 0 22px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .sub-head--light { color: #F7F2EA; border-bottom-color: rgba(255,255,255,.15); margin-top: 46px; }

  /* ══ 写真グリッド：どんなものを作るのか ══ */
  .gallery { display: grid; gap: 14px; margin-bottom: 56px; }
  .gallery--3 { grid-template-columns: repeat(3, 1fr); }
  .gallery--4 { grid-template-columns: repeat(4, 1fr); }
  .shot { margin: 0; }
  .shot img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; background: #EDE8E0; }
  .shot figcaption { font-size: 13px; line-height: 1.7; color: var(--ink-2); margin-top: 10px; }

  .lists-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; margin-bottom: 52px; }
  .list-box h3 { font-family: var(--fm); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 16px; }
  .dots { list-style: none; margin: 0; padding: 0; }
  .dots li { position: relative; padding-left: 18px; font-size: 14.5px; line-height: 1.95; color: var(--ink-2); margin-bottom: 8px; }
  .dots li::before { content: ''; position: absolute; left: 2px; top: 12px; width: 5px; height: 5px; border-radius: 50%; background: var(--amber-l); }
  .dots--muted li { font-size: 13.5px; color: var(--ink-3); }
  .dots--light li { color: #C9C0B6; }
  .dots--light li::before { background: var(--amber-l); }

  .outcomes { background: #fff; border: 1px solid var(--line); padding: 34px 32px; }
  .outcomes h3 { font-family: var(--fm); font-size: 18px; font-weight: 600; color: var(--ink); margin: 0 0 20px; }

  /* ══ PRO ══ */
  .cols-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px; margin-top: 44px; }
  .col h3 { font-family: var(--fm); font-size: 16px; font-weight: 600; color: var(--amber-l); margin: 0 0 16px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,.14); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; }
  .chips li { border: 1px solid rgba(198,161,91,.42); color: #E4DCD2; font-size: 13.5px; padding: 9px 18px; border-radius: 999px; }

  /* ══ VOICES ══ */
  .voices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .voice { background: #fff; border: 1px solid var(--line); padding: 30px 28px; margin: 0; position: relative; }
  .voice::before { content: '“'; position: absolute; top: 8px; left: 18px; font-family: var(--fh); font-size: 46px; color: rgba(198,161,91,.5); line-height: 1; }
  .voice p { font-size: 14px; line-height: 2; color: var(--ink-2); margin: 14px 0 16px; }
  .voice cite { font-style: normal; font-size: 12px; letter-spacing: .1em; color: var(--amber); }

  .pathway img { width: 100%; height: auto; display: block; border: 1px solid var(--line); background: #fff; }

  .benefits { margin-top: 40px; background: #fff; border: 1px solid var(--line); padding: 32px; }
  .benefits h3 { font-family: var(--fm); font-size: 17px; font-weight: 600; color: var(--ink); margin: 0 0 20px; }

  /* ══ 料金表 ══ */
  .pricing { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--line); }
  .pricing th, .pricing td { padding: 20px 24px; border-bottom: 1px solid var(--line); text-align: left; }
  .pricing th { font-size: 15px; font-weight: 500; color: var(--ink-2); }
  .pricing td { text-align: right; font-family: var(--fh); font-size: 26px; font-style: italic; color: var(--amber); white-space: nowrap; }
  .pricing td small { display: block; font-family: 'Noto Sans JP', sans-serif; font-size: 11px; font-style: normal; color: var(--ink-3); margin-top: 2px; }
  .pricing__total th { font-size: 16px; font-weight: 700; color: var(--ink); }
  .pricing__total td { font-size: 34px; color: var(--ink); }
  .pricing__total th, .pricing__total td { border-bottom: 0; background: #FBF7F0; }
  .notes { list-style: none; margin: 22px 0 0; padding: 0; }
  .notes li { font-size: 12.5px; line-height: 1.95; color: var(--ink-3); padding-left: 16px; position: relative; }
  .notes li::before { content: '※'; position: absolute; left: 0; }

  /* ══ FAQ ══ */
  .faq details { background: #fff; border: 1px solid var(--line); margin-bottom: 10px; }
