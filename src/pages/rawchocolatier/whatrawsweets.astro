---
/**
 * ロースイーツとは
 *
 * 中身は microCMS の knowledge 記事 `rawsweets`。
 * Wix 時代からこのURLが検索評価を持っている（3か月 291クリック・9,742表示＝
 * サイト最大の集客ページ）ため、記事はこのURLで出す。
 * /knowledge/rawsweets と /raw-sweets は vercel.json で 301。
 */
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import KnowledgeArticle from '../../components/knowledge/KnowledgeArticle.astro';
import { getKnowledge } from '../../lib/microcms';

const a = await getKnowledge('rawsweets');
const url = 'https://www.andlabtokyo.com/rawchocolatier/whatrawsweets';
---
<Layout
  title={a.seoTitle ?? a.title}
  description={a.seoDescription}
  canonical={url}
  ogImage={(a.ogImage ?? a.heroImage).url}
>
  <JsonLd slot="head" article={a} url={url} />
  <KnowledgeArticle article={a} />
</Layout>
