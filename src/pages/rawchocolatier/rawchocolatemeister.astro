---
import Layout from '../../layouts/Layout.astro';

const heroImage = "https://static.wixstatic.com/media/857257_379c3e3dce8046929166f5d2c1e24b5f~mv2.jpg";
const instructorImage = "https://static.wixstatic.com/media/857257_6a244d3ac66044b9a091293c8e91cd03~mv2.jpg/v1/fill/w_580,h_776,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/chieando_edited_edited.jpg";

const galleryImages = [
  { src: "/choco-real/01-beginner-flatlay.jpg", caption: "カカオポッドから学ぶ、ローチョコレートの基礎" },
  { src: "/choco-real/02-beginner-assorted.jpg", caption: "初級で習得する多彩な成形テクニック" },
  { src: "/choco-real/03-intermediate-mermaid.jpg", caption: "中級で学ぶマーメイドチョコのアレンジ成形" },
  { src: "/choco-real/04-intermediate-hearts.jpg", caption: "色とりどりに仕上げるハート型ボンボンショコラ" },
  { src: "/choco-real/05-advanced-assorted.jpg", caption: "上級で極める本格ボンボンショコラの数々" },
  { src: "/choco-real/06-junior-plating.jpg", caption: "ジュニア講座で学ぶ、お店レベルのプレーティング" },
];

const features = [
  { num: "01", title: "体系的なテキスト", body: "ローチョコの歴史・栄養・テンパリングを網羅した公式テキストで、確実に基礎が身につきます。" },
  { num: "02", title: "少人数制・直接指導", body: "テンパリングのコツと技術を講師が直接指導。疑問をその場で解決できる環境です。" },
  { num: "03", title: "30種類以上のレシピ", body: "アイス・ドリンク・カカオアレンジまで網羅。アレンジ力が自然と身につきます。" },
  { num: "04", title: "オリジナルレシピ力", body: "基本からアレンジまで学び、自分だけのレシピが作れる創作力を培います。" },
  { num: "05", title: "ヘルシー素材", body: "カカオ・ナッツなど美容食材を活用。自分にも地球にも優しいスイーツを学べます。" },
];

const steps = [
  {
    level: "初級", label: "基礎", price: "¥16,500（税別）",
    image: "/choco-real/07-step-beginner.jpg",
    goal: "ローチョコレートの基本を理解し、テンパリングを習得する",
    contents: ["ローチョコレートとは？歴史と栄養", "カカオバター・カカオパウダーの特徴", "基本のテンパリングと成功のポイント"],
    recipes: ["基本のローチョコレート", "パレ（フラワーチョコほかアレンジ）", "チョコレートカバーフルーツ", "スパイシーチョコレート", "アマンドショコラ　ほか"],
  },
  {
    level: "中級", label: "応用", price: "¥30,000（税別）",
    image: "/choco-real/08-step-intermediate.jpg",
    goal: "ホワイトチョコレート・ナッツバターを使った応用技術を習得する",
    contents: ["ホワイトチョコレートの基本", "ナッツバターの作り方", "成形技術の応用（トリュフなど）"],
    recipes: ["カラフルチョコレート（マーメイド・地球チョコ）", "ジャンドゥーヤ", "パヴェドジュネーブ（生チョコ）", "チョコレートトリュフ", "ローキャラメル　ほか"],
  },
  {
    level: "上級", label: "発展", price: "¥33,500（税別）",
    image: "/choco-real/09-step-advanced.jpg",
    goal: "ガナッシュ・ボンボンショコラなど本格技術とオリジナル創作力を習得する",
    contents: ["ガナッシュ・ボンボンショコラの製法", "基本の型取り・デコレーション技術", "カカオ素材の代用・応用テクニック"],
    recipes: ["ボンボンショコラ", "賞味期限15分のチョコレート", "ドバイチョコレート", "チョコレートファッジ", "Raw塩キャラメルソース　ほか"],
  },
];

const forWho = [
  "自分や家族のために、ヘルシーで安心できるスイーツを作りたい方",
  "趣味でローチョコレートを楽しみながら、レシピの幅を広げたい方",
  "将来的にローチョコレートを教えたり、販売したい方",
  "オリジナルのレッスンやブランドを作りたい方",
];

const faqs = [
  { q: "初心者でも受講できますか？", a: "はい、初級講座は初心者の方でも安心して取り組めるカリキュラムです。ローチョコレートの基礎から丁寧に学べます。" },
  { q: "対面・オンラインどちらで受講できますか？", a: "対面（東京・渋谷）とオンラインの両方に対応しています。お住まいの地域を問わず受講いただけます。" },
  { q: "3ステップを全部受講しないといけませんか？", a: "目的に応じて初級のみの受講も可能です。まずは初級から始め、その後のステップを検討される方が多いです。" },
  { q: "修了後に資格は取得できますか？", a: "3ステップ講座を修了後、ジュニアローショコラティエ養成講座でインストラクター資格が取得できます。公式ロゴの使用やSNS集客サポートなどの特典もあります。" },
];

const voices = [
  { initial: "A", label: "Aさんの場合", body: "休みを利用して対面受講しました！" },
  { initial: "B", label: "Bさんの場合", body: "子育てもひと段落、これからの自分磨きと将来の夢叶えるために。" },
  { initial: "C", label: "Cさんの場合", body: "家族のお世話の合間の時間でオンラインで！" },
  { initial: "D", label: "Dさんの場合", body: "子供が小さいのでオンラインで学びました。" },
  { initial: "E", label: "Eさんの場合", body: "昼間はカフェ運営があるため夜間の受講で対応していただきました。" },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "ローチョコレートマイスター養成講座",
  "description": "商標登録済みの本物のローチョコレート技術が学べる唯一の資格講座。初級〜上級の3ステップで、趣味からプロ志向まで対応。",
  "provider": { "@type": "EducationalOrganization", "name": "&LAB TOKYO", "sameAs": "https://www.andlabtokyo.com" },
  "hasCourseInstance": steps.map(s => ({
    "@type": "CourseInstance",
    "name": `${s.level}（${s.label}）`,
    "courseMode": ["onsite", "online"],
  })),
  "offers": steps.map(s => ({
    "@type": "Offer",
    "name": s.level,
    "price": s.price.replace(/[^\d]/g, ""),
    "priceCurrency": "JPY",
  })),
};
---

<Layout
  title="ローチョコレートマイスター養成講座"
  description="商標登録済みの本物のローチョコレート技術が学べる唯一の資格講座。初級〜上級の3ステップで、趣味からプロ志向まで対応。東京・渋谷、オンラインでも受講可能。"
  ogImage={heroImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} />
  </Fragment>

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    /* HERO */
    .hero { position: relative; height: 90vh; min-height: 540px; overflow: hidden; }
    .hero img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; display: block; }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(20,15,10,.82) 0%, rgba(20,15,10,.3) 55%, transparent 100%);
    }
    .hero-body { position: absolute; bottom: 0; left: 0; right: 0; padding: 0 6vw 5rem; max-width: 900px; }
    .hero-badge {
      display: inline-block; border: 1px solid var(--amber); color: var(--amber);
      font-family: var(--f-sans); font-size: .7rem; letter-spacing: .14em;
      padding: .3rem .9rem; border-radius: 2rem; margin-bottom: 1.2rem;
    }
    .hero-title {
      font-family: var(--f-serif); font-size: clamp(1.9rem, 4.5vw, 3.2rem);
      font-weight: 300; color: #fff; line-height: 1.3; letter-spacing: .06em; margin-bottom: 1rem;
    }
    .hero-sub {
      font-family: var(--f-sans); font-size: clamp(.85rem, 1.4vw, 1rem);
      color: rgba(255,255,255,.82); line-height: 1.9; max-width: 580px; margin-bottom: 2rem;
    }
    .hero-cta {
      display: inline-flex; align-items: center; gap: .5rem;
      background: var(--amber); color: #fff;
      font-family: var(--f-sans); font-size: .88rem; font-weight: 700; letter-spacing: .1em;
      padding: .9rem 2.2rem; border-radius: 2rem; text-decoration: none; transition: background .2s;
    }
    .hero-cta:hover { background: #d4a84a; }

    /* SECTIONS */
    section { padding: 5rem 6vw; }
    .section-inner { max-width: 900px; margin: 0 auto; }
    .eyebrow {
      font-family: var(--f-sans); font-size: .68rem; letter-spacing: .22em;
      text-transform: uppercase; color: var(--amber); display: block; margin-bottom: .8rem;
    }
    .sec-title {
      font-family: var(--f-serif); font-size: clamp(1.4rem, 3vw, 2rem);
      font-weight: 300; color: #2c2c2a; line-height: 1.4; letter-spacing: .04em; margin-bottom: 1rem;
    }
    .sec-lead { font-family: var(--f-sans); font-size: .93rem; color: #555; line-height: 1.9; max-width: 700px; }
    .divider { width: 40px; height: 1px; background: var(--amber); margin: 1.2rem 0 2.2rem; }

    /* FOR WHO */
    .bg-linen { background: #f7f4ef; }
    .forwho-list {
      list-style: none;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem; margin-top: 2rem;
    }
    .forwho-item {
      background: #fff; border-left: 3px solid var(--amber);
      padding: 1.1rem 1.4rem; font-family: var(--f-sans); font-size: .9rem;
      color: #333; line-height: 1.7; border-radius: 0 4px 4px 0;
    }

    /* FEATURES */
    .features-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 2rem; margin-top: 2.5rem;
    }
    .feature-card { border-top: 1px solid #e8e4dc; padding-top: 1.4rem; }
    .feature-num { font-family: var(--fh); font-size: 2.2rem; color: var(--amber); opacity: .55; display: block; margin-bottom: .4rem; }
    .feature-title { font-family: var(--f-serif); font-size: 1rem; font-weight: 400; color: #2c2c2a; margin-bottom: .5rem; }
    .feature-body { font-family: var(--f-sans); font-size: .84rem; color: #666; line-height: 1.8; }

    /* GALLERY */
    .gallery-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem;
    }
    .gallery-item { position: relative; aspect-ratio: 4/3; overflow: hidden; border-radius: 4px; }
    .gallery-item img {
      width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease;
    }
    .gallery-item:hover img { transform: scale(1.06); }
    .gallery-cap {
      position: absolute; inset: 0; display: flex; align-items: flex-end;
      padding: 1rem; background: linear-gradient(to top, rgba(20,15,10,.75) 0%, transparent 65%);
      opacity: 0; transition: opacity .25s;
    }
    .gallery-item:hover .gallery-cap { opacity: 1; }
    .gallery-cap span {
      font-family: var(--f-sans); font-size: .75rem; color: #fff; line-height: 1.6;
    }
    @media (max-width: 760px) {
      .gallery-grid { grid-template-columns: 1fr 1fr; }
    }

    /* STEPS */
    .bg-dark { background: var(--sumi); }
    .bg-dark .sec-title { color: #fff; }
    .bg-dark .sec-lead { color: rgba(255,255,255,.65); }
    .steps-wrap { display: flex; flex-direction: column; gap: 0; margin-top: 3rem; }
    .step-card {
      display: grid; grid-template-columns: 140px 180px 1fr; gap: 2.5rem; align-items: start;
      border-top: 1px solid rgba(255,255,255,.1); padding: 2.5rem 0;
    }
    .step-thumb {
      width: 140px; height: 140px; border-radius: 6px; overflow: hidden; flex-shrink: 0;
    }
    .step-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .step-level { font-family: var(--fh); font-size: 3rem; color: #E8C988; line-height: 1; display: block; }
    .step-label { font-family: var(--f-serif); font-size: 1.15rem; font-weight: 300; color: #fff; display: block; margin: .3rem 0 .8rem; }
    .step-price {
      display: inline-block; border: 1px solid var(--amber); color: var(--amber);
      font-family: var(--f-sans); font-size: .74rem; letter-spacing: .06em;
      padding: .2rem .75rem; border-radius: 2rem;
    }
    .step-goal {
      font-family: var(--f-sans); font-size: .84rem; color: rgba(255,255,255,.58);
      margin-bottom: 1.2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,.07);
    }
    .step-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .col-label {
      font-family: var(--f-sans); font-size: .68rem; letter-spacing: .16em;
      text-transform: uppercase; color: var(--amber); margin-bottom: .6rem;
    }
    .step-list { list-style: none; }
    .step-list li {
      font-family: var(--f-sans); font-size: .82rem; color: rgba(255,255,255,.75);
      padding: .3rem 0; border-bottom: 1px solid rgba(255,255,255,.05); line-height: 1.6;
    }
    .step-list li::before { content: '— '; color: var(--amber); opacity: .6; }

    /* FORMAT */
    .format-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2rem; }
    .online-feature {
      display: grid; grid-template-columns: 280px 1fr; gap: 2.2rem; align-items: center;
      margin-top: 1.5rem; background: #f7f4ef; border-radius: 4px; overflow: hidden;
    }
    .online-feature-img { height: 100%; min-height: 220px; }
    .online-feature-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .online-feature-body { padding: 1.8rem 1.8rem 1.8rem 0; }
    .online-feature-body .format-card-body { margin-top: .3rem; }
    .format-card { background: #f7f4ef; padding: 1.8rem; border-radius: 4px; }
    .format-card-label { font-family: var(--f-sans); font-size: .68rem; letter-spacing: .18em; color: var(--amber); margin-bottom: .6rem; }
    .format-card-title { font-family: var(--f-serif); font-size: 1.05rem; margin-bottom: .5rem; color: #2c2c2a; }
    .format-card-body { font-family: var(--f-sans); font-size: .84rem; color: #666; line-height: 1.8; }

    /* INSTRUCTOR */
    .instructor-wrap { display: grid; grid-template-columns: 260px 1fr; gap: 3rem; align-items: start; }
    .instructor-img { width: 100%; border-radius: 2px; display: block; }
    .instructor-name { font-family: var(--f-serif); font-size: 1.4rem; font-weight: 300; margin-bottom: .3rem; }
    .instructor-role { font-family: var(--f-sans); font-size: .76rem; letter-spacing: .12em; color: var(--amber); margin-bottom: 1.2rem; }
    .instructor-body { font-family: var(--f-sans); font-size: .9rem; color: #555; line-height: 1.9; }

    /* JUNIOR */
    .junior-thumb { width: 100%; max-width: 420px; border-radius: 6px; overflow: hidden; margin-bottom: 1.5rem; }
    .junior-thumb img { width: 100%; height: auto; display: block; }
    .junior-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
    .junior-card { background: #fff; padding: 2rem; border-radius: 4px; }
    .junior-card-title {
      font-family: var(--f-serif); font-size: 1rem; font-weight: 400; color: #2c2c2a;
      margin-bottom: 1rem; padding-bottom: .8rem; border-bottom: 1px solid #e8e4dc;
    }
    .junior-list { list-style: none; }
    .junior-list li {
      font-family: var(--f-sans); font-size: .85rem; color: #555;
      padding: .4rem 0; border-bottom: 1px solid #f0ede6; line-height: 1.6;
    }
    .junior-list li::before { content: '✓ '; color: var(--amber); }
    .junior-note { font-family: var(--f-sans); font-size: .8rem; color: #999; margin-top: 1.5rem; line-height: 1.9; }

    /* VOICES */
    .voice-grid {
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.2rem; margin-top: 2.5rem;
    }
    .voice-card {
      background: #fff; border-radius: 4px; padding: 1.6rem 1.2rem;
      text-align: center; box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }
    .voice-avatar {
      width: 52px; height: 52px; border-radius: 50%; margin: 0 auto .9rem;
      display: flex; align-items: center; justify-content: center;
      background: var(--linen-2); border: 1px solid var(--amber);
      font-family: var(--f-serif); font-size: 1.2rem; color: var(--amber);
    }
    .voice-label {
      font-family: var(--f-sans); font-size: .8rem; font-weight: 700; color: #2c2c2a; margin-bottom: .6rem;
    }
    .voice-body {
      font-family: var(--f-sans); font-size: .78rem; color: #666; line-height: 1.8;
    }
    @media (max-width: 760px) {
      .voice-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) {
      .voice-grid { grid-template-columns: 1fr; }
    }

    /* FAQ */
    .faq-list { margin-top: 2rem; }
    .faq-item { border-bottom: 1px solid #e8e4dc; padding: 1.4rem 0; }
    .faq-q {
      font-family: var(--f-sans); font-size: .92rem; font-weight: 700; color: #2c2c2a;
      cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    }
    .faq-q::after { content: '+'; font-size: 1.2rem; color: var(--amber); flex-shrink: 0; transition: transform .25s; }
    .faq-item.open .faq-q::after { transform: rotate(45deg); }
    .faq-a {
      font-family: var(--f-sans); font-size: .88rem; color: #666; line-height: 1.9;
      max-height: 0; overflow: hidden; transition: max-height .3s ease, padding .3s;
    }
    .faq-item.open .faq-a { max-height: 220px; padding-top: .9rem; }

    /* CTA */
    .cta-section { background: var(--sumi); text-align: center; padding: 6rem 6vw; }
    .cta-title {
      font-family: var(--f-serif); font-size: clamp(1.5rem, 3vw, 2.2rem);
      font-weight: 300; color: #fff; line-height: 1.5; margin-bottom: 1rem;
    }
    .cta-lead {
      font-family: var(--f-sans); font-size: .9rem; color: rgba(255,255,255,.6);
      line-height: 1.9; max-width: 480px; margin: 0 auto 2.5rem;
    }
    .cta-btns { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: .5rem;
      background: var(--amber); color: #fff;
      font-family: var(--f-sans); font-size: .88rem; font-weight: 700; letter-spacing: .1em;
      padding: 1rem 2.6rem; border-radius: 2rem; text-decoration: none; transition: background .2s;
    }
    .btn-primary:hover { background: #d4a84a; }
    .btn-outline {
      display: inline-flex; align-items: center; gap: .5rem;
      border: 1px solid rgba(255,255,255,.3); color: rgba(255,255,255,.85);
      font-family: var(--f-sans); font-size: .88rem; letter-spacing: .1em;
      padding: 1rem 2.2rem; border-radius: 2rem; text-decoration: none;
      transition: border-color .2s, color .2s;
    }
    .btn-outline:hover { border-color: var(--amber); color: var(--amber); }

    /* STICKY CTA */
    .sticky-cta {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: rgba(20,15,10,.95); backdrop-filter: blur(8px);
      padding: 1rem 6vw;
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      z-index: 100; transform: translateY(100%); transition: transform .3s ease;
    }
    .sticky-cta.visible { transform: translateY(0); }
    .sticky-cta-text { font-family: var(--f-sans); font-size: .8rem; color: rgba(255,255,255,.65); }
    .sticky-cta-text strong { display: block; color: #fff; font-size: .86rem; }
    .sticky-btn {
      flex-shrink: 0; background: var(--amber); color: #fff;
      font-family: var(--f-sans); font-size: .82rem; font-weight: 700; letter-spacing: .1em;
      padding: .7rem 1.8rem; border-radius: 2rem; text-decoration: none; white-space: nowrap;
      transition: background .2s;
    }
    .sticky-btn:hover { background: #d4a84a; }

    @media (max-width: 760px) {
      .step-card { grid-template-columns: 1fr; gap: 1rem; }
      .step-cols { grid-template-columns: 1fr; }
      .instructor-wrap { grid-template-columns: 1fr; }
      .junior-grid { grid-template-columns: 1fr; }
      .format-grid { grid-template-columns: 1fr; }
      .online-feature { grid-template-columns: 1fr; }
      .online-feature-img { min-height: 200px; }
      .online-feature-body { padding: 1.5rem; }
      .step-thumb { width: 100%; height: 200px; }
