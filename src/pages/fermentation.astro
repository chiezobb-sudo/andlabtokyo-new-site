---
/**
 * 発酵プランナー養成講座
 *
 * 本文は Wix の /fermentation からそのまま移設している。
 * このURLは 3か月 193クリック・3,217表示（サイト3位）で、文言が検索を取っている。
 * よって文章は変えず、見た目だけ新サイトの体裁に揃える方針（Chie 指示）。
 *
 * 文言・写真の指定は src/data/courses/fermentation.json。
 */
import Layout from '../layouts/Layout.astro';
import FormGate from '../components/FormGate.astro';
import d from '../data/courses/fermentation.json';

const site = 'https://www.andlabtokyo.com';
const url = `${site}/fermentation`;
const br = (s: string) => s.split('\n').join('<br>');

const offers = [
  ...d.levels.map((l) => ({
    '@type': 'Offer',
    name: `${l.title}`,
    price: l.price.replace(/[^0-9]/g, ''),
    priceCurrency: 'JPY',
    category: '税別',
    availability: 'https://schema.org/InStock',
  })),
  {
    '@type': 'Offer',
    name: d.soka.title,
    price: d.soka.price.replace(/[^0-9]/g, ''),
    priceCurrency: 'JPY',
    category: '税別',
    availability: 'https://schema.org/InStock',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Course',
      '@id': `${url}#course`,
      name: '発酵プランナー養成講座',
      description: d.summary,
      url,
      image: `${site}${d.hero.image}`,
      inLanguage: 'ja',
      teaches: [
        '発酵の基本と歴史（日本と世界の発酵文化）',
        '微生物（麹菌・酵母・乳酸菌）の働き',
        '発酵調味料の基礎と応用（塩麹・甘麹・もろみ醤油）',
        '麹づくりの基礎（種付け・培養・温度管理）',
        '酸・糖・塩による発酵制御',
        '世界の発酵文化と保存食',
        'うま味のメカニズムと酵素の働き',
        '黒麹・白麹の比較と温度管理',
        '酵母・乳酸菌の共生理論',
        '発酵講座の開講方法（集客・講座設計・SNS活用）',
      ],
      educationalCredentialAwarded: '発酵プランナー／発酵創家®（&LAB TOKYO 認定）',
      datePublished: d.dates.published,
      dateModified: d.dates.modified,
      author: { '@id': `${site}/instructor-chie-ando#person` },
      provider: { '@type': 'EducationalOrganization', name: '&LAB TOKYO', url: site },
      offers,
      review: d.voices.items.map((v) => ({
        '@type': 'Review',
        reviewBody: v.body,
        author: { '@type': 'Person', name: v.who },
        itemReviewed: { '@id': `${url}#course` },
      })),
      hasCourseInstance: [
        {
          '@type': 'CourseInstance',
          courseMode: 'onsite',
          name: '対面レッスン（東京・表参道）',
          location: {
            '@type': 'Place',
            name: '&LAB TOKYO',
            address: {
              '@type': 'PostalAddress',
              streetAddress: '神宮前',
              addressLocality: '渋谷区',
              addressRegion: '東京都',
              addressCountry: 'JP',
            },
          },
        },
        { '@type': 'CourseInstance', courseMode: 'online', name: 'オンラインレッスン' },
      ],
    },
    {
      '@type': 'Person',
      '@id': `${site}/instructor-chie-ando#person`,
      name: '安藤 千英',
      jobTitle: 'ELLE gourmet 認定クリエイター／発酵創家®',
      url: `${site}/instructor-chie-ando`,
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: d.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${site}/` },
        { '@type': 'ListItem', position: 2, name: '発酵プランナー養成講座', item: url },
      ],
    },
  ],
};
---

<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- ══ HERO ══ -->
  <section class="hero">
    <img src={d.hero.image} alt={d.hero.imageAlt} width="1400" height="1837" fetchpriority="high" />
    <div class="hero-veil"></div>
    <div class="hero-body">
      <span class="eyebrow eyebrow--light">{d.hero.eyebrow}</span>
      <h1>
        <span set:html={br(d.hero.title)} />
        <span class="h1-sub">{d.hero.subtitle}</span>
      </h1>
      <p class="hero-lead">{d.hero.lead}</p>
      <ul class="hero-steps">{d.hero.steps.map((s) => <li>{s}</li>)}</ul>
      <a href={d.hero.ctaHref} class="btn btn--solid">{d.hero.ctaLabel}</a>
    </div>
  </section>

  <section class="facts">
    <dl class="facts-grid">
      {d.hero.facts.map((f) => (
        <div class="fact"><dt>{f.label}</dt><dd>{f.value}</dd></div>
      ))}
    </dl>
  </section>

  <!-- ══ FOR YOU ══ -->
  <section class="sec sec--linen">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.forYou.eyebrow}</span>
        <h2>{d.forYou.title}</h2>
      </header>
      <div class="cards-3">
        {d.forYou.cards.map((c) => (
          <div class="card">
            <span class="card-en">{c.en}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
      <p class="pull">{d.forYou.note}</p>
    </div>
  </section>

  <!-- ══ カリキュラム ══ -->
  <section class="sec sec--cream" id="curriculum">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.curriculum.eyebrow}</span>
        <h2>{d.curriculum.title}</h2>
        <p class="sec-lead">{d.curriculum.lead}</p>
      </header>
      <p class="flow">{d.curriculum.flow}</p>
      <div class="steps-4">
        {d.curriculum.steps.map((s) => (
          <a class="step-card" href={s.href}>
            <span class="step-no">{s.no}</span>
            <h3>{s.label}</h3>
            <span class="step-verb">{s.verb}</span>
            <p>{s.body}</p>
            <span class="step-price">{s.price}<small>税別</small></span>
            <span class="step-more">詳しく見る →</span>
          </a>
        ))}
      </div>
      <p class="note">{d.curriculum.note}</p>
    </div>
  </section>

  <!-- ══ 各ステップ ══ -->
  {d.levels.map((l, i) => (
    <section class={`sec level ${i % 2 === 0 ? 'sec--linen' : 'sec--cream'}`} id={l.id}>
      <div class="inner">
        <header class="level-head">
          <span class="eyebrow">{l.step}</span>
          <h2>
            <span class="theme-badge">{l.label}</span>
            <span class="h2-text">{l.title}</span>
          </h2>
          <p class="verb">{l.verb}</p>
          <p class="sec-lead">{l.lead}</p>
        </header>

        <div class="level-top">
          <div class="two">
            <div class="list-box">
              <h3>学べること</h3>
              <ul class="ticks">{l.learn.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="list-box">
              <h3>実習レシピ例</h3>
              <ul class="dots">{l.recipes.map((x) => <li>{x}</li>)}</ul>
            </div>
          </div>
          <div class="price-card">
            <span class="price-card__label">{l.label}講座 受講料</span>
            <span class="price-card__price">{l.price}<small>（{l.priceNote}）</small></span>
            <ul class="price-card__specs">
              {l.specs.map((s) => <li>{s}</li>)}
              <li>{l.priceExtra}</li>
            </ul>
          </div>
        </div>

        <p class="theme">{l.theme}</p>

        <div class={`gallery gallery--${l.photos.length}`}>
          {l.photos.map((p) => (
            <figure class="shot">
              <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>

        <div class="after">
          <h3>修了後には</h3>
          <p>{l.after}</p>
        </div>

        <div class="lunch">
          <h3 class="sub-head">{l.lunchTitle}</h3>
          <p class="lunch-lead">{l.lunchLead}</p>
          <ul class="dots dots--2col">{l.lunch.map((x) => <li>{x}</li>)}</ul>
        </div>

        <div class="book">
          <figure class="book-cover">
            <img src={l.book.cover} alt={l.book.coverAlt} loading="lazy" decoding="async" />
          </figure>
          <div class="book-body">
            <span class="book-kicker">TEXTBOOK</span>
            <h3>{l.book.title}</h3>
            <p>{l.book.spec}</p>
            {l.onlineNote && <p class="online-note">※ {l.onlineNote}</p>}
          </div>
        </div>

        <div class="outcomes">
          <h3>{l.label}講座はこんな方に</h3>
          <ul class="ticks ticks--2col">{l.forWhom.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </section>
  ))}

  <!-- ══ 短期集中 ══ -->
  <section class="sec sec--linen">
    <div class="inner inner--narrow">
      <div class="intensive">
        <h2>{d.intensive.title}</h2>
        <p class="sec-lead">{d.intensive.body}</p>
        <div class="intensive-price">
          <span class="was">{d.intensive.regular}<small>{d.intensive.regularNote}</small></span>
          <span class="now">{d.intensive.price}<small>{d.intensive.priceNote}</small></span>
        </div>
        <p class="note">{d.intensive.extra}</p>
      </div>
    </div>
  </section>

  <!-- ══ 発酵創家® ══ -->
  <section class="sec sec--accent" id="soka">
    <div class="inner">
      <header class="level-head">
        <span class="eyebrow">{d.soka.step}</span>
        <h2>
          <span class="theme-badge">師範</span>
          <span class="h2-text">{d.soka.title}</span>
        </h2>
        <p class="verb">{d.soka.verb}</p>
        <p class="sec-lead">{d.soka.lead}</p>
      </header>
      <div class="cols-2">
        {d.soka.columns.map((c) => (
          <div class="col">
            <h3>{c.title}</h3>
            <ul class="ticks">{c.items.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="two two--gap">
        <div class="list-box">
          <h3>{d.soka.learnTitle}</h3>
          <ul class="dots">{d.soka.learn.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="list-box">
          <h3>{d.soka.afterTitle}</h3>
          <ul class="ticks">{d.soka.after.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
      <div class="price-card">
        <span class="price-card__label">師範講座 受講料</span>
        <span class="price-card__price">{d.soka.price}<small>（{d.soka.priceNote}）</small></span>
        <ul class="price-card__specs">{d.soka.specs.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ══ 講師 ══ -->
  <section class="sec sec--cream">
    <div class="inner">
      <div class="teacher">
        <figure class="teacher-photo">
          <img src={d.instructor.image} alt={d.instructor.imageAlt} loading="lazy" decoding="async" width="900" height="900" />
        </figure>
        <div class="teacher-body">
          <span class="eyebrow">{d.instructor.eyebrow}</span>
          <h2>{d.instructor.title}</h2>
          <p class="teacher-text">{d.instructor.body}</p>
          <div class="vegan">
            <h3>{d.vegan.title}</h3>
            <p>{d.vegan.body}</p>
          </div>
          <p class="inline-link"><a href={d.instructor.linkHref}>{d.instructor.linkLabel} →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 受講生の声 ══ -->
  <section class="sec sec--linen">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">{d.voices.eyebrow}</span>
        <h2>{d.voices.title}</h2>
      </header>
      <div class="voices">
        {d.voices.items.map((v) => (
          <blockquote class="voice"><p>{v.body}</p><cite>{v.who}</cite></blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 受講方法 ══ -->
  <section class="sec sec--cream" id="access">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.access.eyebrow}</span>
        <h2>{d.access.title}</h2>
        <p class="sec-lead">{d.access.lead}</p>
      </header>
      <div class="access">
        {d.access.items.map((a) => (
          <div class="access-card">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <ul class="access-tags">{a.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 料金 ══ -->
  <section class="sec sec--linen">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.pricing.eyebrow}</span>
        <h2>{d.pricing.title}</h2>
      </header>
      <table class="pricing">
        <tbody>
          {d.pricing.rows.map((r) => (
            <tr>
              <th scope="row">{r.name}{r.note && <small>{r.note}</small>}</th>
              <td>{r.price}<small>税別</small></td>
            </tr>
          ))}
        </tbody>
      </table>
      <ul class="notes">{d.pricing.notes.map((n) => <li>{n}</li>)}</ul>
      <p class="updated"><time datetime={d.dates.modified}>{d.dates.label}</time><span>この料金は上記時点のものです。</span></p>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="sec sec--cream">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.faq.eyebrow}</span>
        <h2>{d.faq.title}</h2>
      </header>
      <div class="faq">
        {d.faq.items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ 申し込み ══ -->
  <section class="sec sec--linen" id="entry">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">{d.cta.eyebrow}</span>
        <h2>{d.cta.title}</h2>
        <p class="sec-lead">{d.cta.body}</p>
      </header>
      <FormGate
        subject="【発酵プランナー養成講座】お申し込み・ご相談"
        mailBody={'お名前：\nご希望のステップ（基礎／中級／上級／師範／短期集中）：\nご希望の受講形式（対面／オンライン）：\n希望日程：\nご質問：\n'}
        class="form-grid"
      >
        <label>お名前<span>*</span><input type="text" name="name" required /></label>
        <label>メールアドレス<span>*</span><input type="email" name="email" required /></label>
        <label>お電話番号<input type="tel" name="tel" /></label>
        <label>ご希望のステップ<span>*</span>
          <select name="course" required>
            <option value="">選択してください</option>
            <option>Step 1｜基礎（ベーシック）</option>
            <option>Step 2｜中級（アドバンス）</option>
            <option>Step 3｜上級（マスター）</option>
            <option>Step 4｜発酵創家®（師範）</option>
            <option>短期集中（基礎＋中級・3日間）</option>
            <option>まだ決めていない／相談したい</option>
          </select>
        </label>
        <label>ご希望の受講形式
          <select name="mode">
            <option value="">選択してください</option>
            <option>対面（東京・表参道）</option>
            <option>オンライン</option>
          </select>
        </label>
        <label>希望日程<input type="text" name="date1" placeholder="例：10月中旬の平日" /></label>
        <label class="full">お問い合わせ・ご質問<textarea name="message" rows="5"></textarea></label>
        <button type="submit" class="btn btn--solid">送信する</button>
      </FormGate>
    </div>
  </section>
</Layout>

<style is:global>
  body { background: #FAF9F6; }
</style>

<style>
  .hero, .facts, .sec {
    --linen:#FAF9F6; --cream:#F6F2EA; --accent:#EFE7D9;
    --ink:#221F1C; --ink-2:#3D3934; --ink-3:#6E6862;
    --amber:#A8794A; --amber-l:#C6A15B;
    --line:rgba(34,31,28,0.12); --sumi:#221C17;
    --fh:'Cormorant Garamond',serif; --fm:'Shippori Mincho','Noto Serif JP',serif;
  }

  /* HERO ── 全面。写真は縦長なので、器と手が入る上寄りを見せる */
  .hero { position: relative; height: 74vh; min-height: 560px; max-height: 780px; display: flex; align-items: flex-end; overflow: hidden; }
  .hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
  .hero-veil { position: absolute; inset: 0; background:
      linear-gradient(to top, rgba(28,22,18,.80) 0%, rgba(28,22,18,.48) 34%, rgba(28,22,18,.08) 70%, transparent 100%),
      linear-gradient(to right, rgba(28,22,18,.44) 0%, rgba(28,22,18,.12) 52%, transparent 78%); }
  .hero-body { position: relative; z-index: 1; width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 32px 56px; }
  .hero h1 { font-family: var(--fm); font-size: clamp(30px, 4.6vw, 56px); font-weight: 600; line-height: 1.4; color: #fff; margin: 0 0 18px; text-shadow: 0 2px 18px rgba(0,0,0,.6), 0 1px 3px rgba(0,0,0,.35); }
  .h1-sub { display: block; margin-top: 14px; font-family: 'Noto Sans JP', sans-serif; font-size: clamp(13px, 1.2vw, 16px); font-weight: 400; letter-spacing: .08em; color: rgba(255,255,255,.94); }
  .hero-lead { font-size: clamp(14px, 1.15vw, 16px); line-height: 2; color: rgba(255,255,255,.94); max-width: 38em; margin: 0 0 22px; text-shadow: 0 1px 10px rgba(0,0,0,.65); }
  .hero-steps { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; padding: 0; }
  .hero-steps li { font-size: 12px; letter-spacing: .06em; color: #fff; border: 1px solid rgba(255,255,255,.5); border-radius: 999px; padding: 7px 15px; backdrop-filter: blur(4px); }

  /* 事実の帯 */
  .facts { background: var(--sumi); padding: 0 32px; }
  .facts-grid { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); }
  .fact { padding: 26px 22px; border-left: 1px solid rgba(255,255,255,.13); }
  .fact:first-child { border-left: 0; }
  .fact dt { font-size: 11px; letter-spacing: .16em; color: var(--amber-l); margin-bottom: 8px; }
  .fact dd { font-size: 15px; color: #F2EDE6; line-height: 1.6; font-weight: 500; }

  /* セクション共通 */
  .sec { padding: 92px 32px; }
  .sec--linen { background: var(--linen); }
  .sec--cream { background: var(--cream); }
  .sec--accent { background: var(--accent); }
  .inner { max-width: 1080px; margin: 0 auto; }
  .inner--narrow { max-width: 780px; }
  .eyebrow { display: block; font-family: var(--fh); font-size: 12px; letter-spacing: .32em; text-transform: uppercase; color: var(--amber); margin-bottom: 14px; }
  .eyebrow--light { color: #F0DCC0; text-shadow: 0 1px 10px rgba(0,0,0,.55); }
  .sec-head, .level-head { margin-bottom: 44px; }
  h2 { font-family: var(--fm); font-size: clamp(24px, 2.9vw, 38px); font-weight: 600; line-height: 1.5; color: var(--ink); margin: 0 0 18px; text-wrap: balance; }
  .h2-text { display: block; }
  .sec-lead { font-size: 16px; line-height: 2; color: var(--ink-2); max-width: 46em; margin: 0; }
  .verb { font-family: var(--fm); font-size: 18px; color: var(--amber); margin: 0 0 14px; }
  .note { font-size: 13.5px; line-height: 1.95; color: var(--ink-3); margin: 26px 0 0; }
  .pull { font-family: var(--fm); font-size: clamp(19px, 2.4vw, 27px); color: var(--ink); text-align: center; margin: 44px 0 0; }
  .flow { font-size: 14px; letter-spacing: .06em; color: var(--amber); margin: 0 0 28px; }
  .theme { font-size: 14px; color: var(--ink-3); margin: 0 0 24px; padding-left: 14px; border-left: 2px solid var(--amber-l); }
  .inline-link { margin-top: 26px; }
  .inline-link a { font-size: 15px; color: var(--amber); text-decoration: none; border-bottom: 1px solid rgba(168,121,74,.4); padding-bottom: 3px; }

  .btn { display: inline-block; padding: 15px 40px; font-size: 15px; font-weight: 700; text-decoration: none; border-radius: 2px; letter-spacing: .05em; cursor: pointer; border: 0; font-family: inherit; }
  .btn--solid { background: var(--amber-l); color: #221C17; }
  .btn--solid:hover { background: #D6B472; }

  /* FOR YOU */
