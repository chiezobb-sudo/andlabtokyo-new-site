---
/**
 * はじめての方へ
 *
 * 本文は Wix の /beginner からそのまま移設。3か月 11クリック。
 * 旧版はほぼ空だったので、Wix の文章（モットー・安心できる理由）を全て入れ、
 * トライアルレッスンへの動線を追加した。
 *
 * 文言・写真の指定は src/data/pages/beginner.json。
 */
import Layout from '../layouts/Layout.astro';
import CoursePage from '../components/course/CoursePage.astro';
import { articleJsonLd } from '../lib/article-jsonld';
import d from '../data/pages/beginner.json';

const url = 'https://www.andlabtokyo.com/beginner';
const jsonLd = articleJsonLd({
  path: '/beginner',
  headline: 'はじめての方へ ─ ローフード・発酵がはじめての方に',
  description: d.summary,
  image: d.meta.ogImage,
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: 'はじめての方へ' }],
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
