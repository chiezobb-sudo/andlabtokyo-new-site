---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = ['すべて', 'レシピ', 'お知らせ', 'ナレッジ', 'ブログ'];
---

<Layout
  title="ブログ | &LAB TOKYO"
  description="安藤千恵のレシピ・発酵食・ローフード・スピルリナなど、食と健康に関する記事一覧"
>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .blog-hero {
      background: #f7f4ef;
      padding: 5rem 5vw 3.5rem;
      text-align: center;
    }
    .blog-hero-eyebrow {
      font-family: var(--f-sans);
      font-size: .72rem;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--green);
      display: block;
      margin-bottom: 1rem;
    }
    .blog-hero-title {
      font-family: var(--f-serif);
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 300;
      color: #2c2c2a;
      letter-spacing: .06em;
    }
    .blog-hero-sub {
      font-family: var(--f-sans);
      font-size: .9rem;
      color: #888;
      margin-top: 1rem;
      letter-spacing: .04em;
    }

    .filter-bar {
      display: flex;
      justify-content: center;
      gap: .6rem;
      flex-wrap: wrap;
      padding: 2rem 5vw;
      background: #fff;
      border-bottom: 1px solid #e8e4dc;
    }
    .filter-btn {
      font-family: var(--f-sans);
      font-size: .75rem;
      letter-spacing: .12em;
      border: 1px solid #d4ceC4;
      background: transparent;
      color: #666;
      padding: .45rem 1.1rem;
      border-radius: 2rem;
      cursor: pointer;
      transition: all .2s;
    }
    .filter-btn:hover,
    .filter-btn.active {
      background: #2c2c2a;
      color: #fff;
      border-color: #2c2c2a;
    }

    .grid-wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 5vw 6rem;
    }
    .post-count {
      font-family: var(--f-sans);
      font-size: .8rem;
      color: #aaa;
      letter-spacing: .08em;
      margin-bottom: 2rem;
    }

    .blog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2.5rem;
    }

    .post-card {
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      transition: transform .2s;
    }
    .post-card:hover { transform: translateY(-4px); }

    .post-img-wrap {
      position: relative;
      aspect-ratio: 4/3;
      overflow: hidden;
      background: #f0ede6;
      border-radius: 2px;
      margin-bottom: 1.1rem;
    }
    .post-img-wrap img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center;
      display: block;
      transition: transform .4s ease;
    }
    .post-card:hover .post-img-wrap img { transform: scale(1.04); }

    .post-no-img {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--f-serif);
      font-size: 2rem;
      color: #C2A878;
      opacity: .5;
    }

    .post-cat {
      font-family: var(--f-sans);
      font-size: .68rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--green);
      margin-bottom: .5rem;
      display: block;
    }
    .post-title {
      font-family: var(--f-serif);
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.5;
      color: #2c2c2a;
      margin-bottom: .5rem;
    }
    .post-date {
      font-family: var(--f-sans);
      font-size: .73rem;
      color: #aaa;
      letter-spacing: .06em;
    }
    .post-desc {
      font-family: var(--f-sans);
      font-size: .82rem;
      color: #666;
      line-height: 1.7;
      margin-top: .4rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .hidden { display: none !important; }

    @media (max-width: 600px) {
      .blog-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
      .grid-wrap { padding: 2rem 1.2rem 4rem; }
    }
    @media (max-width: 400px) {
      .blog-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="blog-hero">
    <span class="blog-hero-eyebrow">Journal</span>
    <h1 class="blog-hero-title">ブログ</h1>
    <p class="blog-hero-sub">{posts.length}件の記事</p>
  </div>

  <div class="filter-bar">
    {categories.map(cat => (
      <button class={`filter-btn${cat === 'すべて' ? ' active' : ''}`} data-cat={cat}>
        {cat}
      </button>
    ))}
  </div>

  <div class="grid-wrap">
    <p class="post-count" id="count">{posts.length}件表示中</p>
    <div class="blog-grid" id="grid">
      {posts.map(post => {
        const slug = post.id.replace(/\.md$/, '');
        const date = new Date(post.data.date).toLocaleDateString('ja-JP', {
          year: 'numeric', month: 'long', day: 'numeric'
        });
        return (
          <a href={`/post/${slug}`} class="post-card" data-cat={post.data.category}>
            <div class="post-img-wrap">
              {post.data.image
                ? <img src={post.data.image} alt={post.data.title} loading="lazy" />
                : <div class="post-no-img">✿</div>
              }
            </div>
            <span class="post-cat">{post.data.category}</span>
            <h2 class="post-title">{post.data.title}</h2>
            <span class="post-date">{date}</span>
            {post.data.description && (
              <p class="post-desc">{post.data.description}</p>
            )}
          </a>
        );
      })}
    </div>
  </div>

  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    const countEl = document.getElementById('count');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat!;
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        let visible = 0;
        cards.forEach(card => {
          const show = cat === 'すべて' || card.dataset.cat === cat;
          card.classList.toggle('hidden', !show);
          if (show) visible++;
        });
        if (countEl) countEl.textContent = `${visible}件表示中`;
      });
    });
  </script>
</Layout>
