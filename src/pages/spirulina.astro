---
/**
 * スピルリナとは
 *
 * 中身は microCMS の knowledge 記事 `spirulina`。
 * Wix 時代からこのURLが検索評価を持つ（3か月 215クリック・24,676表示＝
 * 表示回数はサイト最大）ため、記事はこのURLで出す。
 * /knowledge/spirulina は vercel.json で 301。
 */
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import KnowledgeArticle from '../components/knowledge/KnowledgeArticle.astro';
import { getKnowledge } from '../lib/microcms';

const a = await getKnowledge('spirulina');
const url = 'https://www.andlabtokyo.com/spirulina';
---
<Layout
  title={a.seoTitle ?? a.title}
  description={a.seoDescription}
  canonical={url}
  ogImage={(a.ogImage ?? a.heroImage).url}
>
  <JsonLd slot="head" article={a} url={url} />
  <KnowledgeArticle article={a} />
</Layout>
