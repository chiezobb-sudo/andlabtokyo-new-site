---
/**
 * ローフードの教科書（&RAW LIVING Step1）
 *
 * 本文は Wix の /rawfood-book からそのまま移設。3か月 10クリック。
 * Amazonリンクはアソシエイト・リンク（tag=rawlivingstore-22）なので
 * ステマ規制対応として本文に表示を入れている。
 *
 * 文言・写真の指定は src/data/pages/rawfood-book.json。
 */
import Layout from '../layouts/Layout.astro';
import CoursePage from '../components/course/CoursePage.astro';
import { articleJsonLd } from '../lib/article-jsonld';
import d from '../data/pages/rawfood-book.json';

const url = 'https://www.andlabtokyo.com/rawfood-book';
const reviews = d.blocks.find((b: any) => b.type === 'voices')?.items ?? [];
const jsonLd = articleJsonLd({
  path: '/rawfood-book',
  headline: '『&RAW LIVING Step1 ─ ローフードの教科書』',
  description: d.summary,
  image: d.meta.ogImage,
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: 'ローフードの教科書' }],
  published: d.dates.published,
  modified: d.dates.modified,
  book: {
    name: '&RAW LIVING Step1 ─ ローフードの教科書',
    author: '安藤千英',
    url: 'https://amzn.to/4lDUU9r',
    // aggregateRating は入れない。4.7★ は Amazon 側の集計で、
    // レビュー件数をこちらで確認できないため、数字を構造化データに書くと誤情報になる。
    reviews,
  },
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
