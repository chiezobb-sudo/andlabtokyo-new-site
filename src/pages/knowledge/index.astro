---
import Layout from '../../layouts/Layout.astro';
import { getKnowledgeList } from '../../lib/microcms';

const articles = await getKnowledgeList();
---
<Layout
  title="KNOWLEDGE｜知る・学ぶ リビングフード｜&LAB TOKYO"
  description="ローフード・発酵・ローチョコレート・ロースイーツを、根拠から解説します。&LAB TOKYO の知識アーカイブ。"
>
  <main class="hub">
    <header class="hub__head">
      <p class="label" data-reveal>Knowledge</p>
      <h1 class="hub__title" data-reveal style="--reveal-delay:110ms">知る・学ぶ<br />リビングフード</h1>
      <p class="hub__lead" data-reveal style="--reveal-delay:200ms">
        「なんとなく体にいい」で終わらせないために。<br />
        ローフード、発酵、カカオについて、根拠から解説します。
      </p>
    </header>

    <ul class="hub__list">
      {articles.map((a, i) => (
        <li class="card" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 90}ms`}>
          <a href={`/knowledge/${a.id}`}>
            <span class="card__media">
              <img src={a.heroImage.url} alt="" width="640" height="400" loading="lazy" decoding="async" />
            </span>
            <span class="card__title">{a.title}</span>
            <span class="card__lead">{a.lead.slice(0, 62)}…</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .hub { width: min(100% - 2.4rem, 78rem); margin: 0 auto; padding: clamp(5rem, 12vw, 10rem) 0 var(--gap-section); }
  .hub__head { margin-bottom: clamp(4rem, 10vw, 8rem); }
  .hub__title { font-size: var(--fs-h1); font-weight: 400; line-height: 1.36; letter-spacing: .05em; margin: 1.6rem 0 0; }
  .hub__lead { font-size: var(--fs-lead); line-height: 2.4; color: var(--ink-soft); margin: 2.4rem 0 0; }

  .hub__list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: clamp(2.6rem, 5vw, 4.5rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .card a { display: grid; gap: 1.4rem; color: inherit; text-decoration: none; }
  .card__media { display: block; overflow: hidden; }
  .card__media img {
    width: 100%; aspect-ratio: 16 / 10; object-fit: cover;
    transition: transform 1.1s var(--ease);
  }
  .card a:hover .card__media img { transform: scale(1.04); }
  .card__title { font-size: 1.02rem; line-height: 1.85; letter-spacing: .03em; transition: color .5s var(--ease); }
  .card a:hover .card__title { color: var(--accent); }
  .card__lead { font-size: .85rem; line-height: 2; color: var(--ink-faint); }
</style>
