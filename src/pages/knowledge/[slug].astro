---
import Layout from '../../layouts/Layout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import KnowledgeArticle from '../../components/knowledge/KnowledgeArticle.astro';
import { getKnowledgeList, getKnowledge } from '../../lib/microcms';
import { CUSTOM_ROUTES } from '../../lib/knowledge-routes';

export async function getStaticPaths() {
  const list = await getKnowledgeList();
  // 実URL（Wix時代から検索評価のあるURL）を持つ記事は、そちらで描画するのでここでは出さない。
  // /knowledge/<id> は vercel.json で 301 させる。
  return list.filter((c) => !CUSTOM_ROUTES[c.id]).map((c) => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const a = await getKnowledge(slug!);
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Layout
  title={a.seoTitle ?? a.title}
  description={a.seoDescription}
  ogImage={(a.ogImage ?? a.heroImage).url}
  noindex={a.noindex}
>
  <JsonLd slot="head" article={a} url={url} />
  <KnowledgeArticle article={a} />
</Layout>
