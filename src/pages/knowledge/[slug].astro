---
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/knowledge/Toc.astro';
import CourseCta from '../../components/knowledge/CourseCta.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { getKnowledgeList, getKnowledge } from '../../lib/microcms';
import { buildToc } from '../../lib/toc';

export async function getStaticPaths() {
  const list = await getKnowledgeList();
  return list.map((c) => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const a = await getKnowledge(slug!);
const toc = buildToc(a.body);
const url = new URL(Astro.url.pathname, Astro.site).href;
---
<Layout
  title={a.seoTitle ?? a.title}
  description={a.seoDescription}
  ogImage={(a.ogImage ?? a.heroImage).url}
  noindex={a.noindex}
>
  <JsonLd slot="head" article={a} url={url} />

  <main>
    <!-- ヒーロー：説明より先に、世界を見せる -->
    <header class="hero">
      <div class="hero__media">
        <img
          src={a.heroImage.url}
          alt={a.heroImageAlt ?? a.title}
          width={a.heroImage.width}
          height={a.heroImage.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__inner">
        {a.eyebrow && <p class="label hero__label" data-reveal>{a.eyebrow}</p>}
        <h1 class="hero__title" data-reveal style="--reveal-delay:120ms">{a.title}</h1>
      </div>

      <div class="hero__cue" aria-hidden="true"><span></span></div>
    </header>

    <article class="kb">
      <nav class="crumb" aria-label="パンくず">
        <a href="/">ホーム</a><span>／</span><a href="/knowledge">KNOWLEDGE</a>
      </nav>

      <p class="kb__lead" data-reveal>{a.lead}</p>

      {toc.length > 0 && <div data-reveal><Toc items={toc} /></div>}

      <div class="kb-body" set:html={a.body} />
    </article>

    {a.ctaUrl && (
      <CourseCta cta={{ heading: a.ctaHeading, text: a.ctaText, buttonLabel: a.ctaLabel, buttonUrl: a.ctaUrl }} />
    )}
  </main>
</Layout>

<style>
  /* ── ヒーロー ─────────────────────────── */
  .hero {
    position: relative;
    /* 固定ヘッダーぶんを引く。height でなく min-height にして、
       見出しが2行になっても切り取られないようにする */
    /* ヘッダーが約146pxあるため、フルハイトにすると見出しが折り返しで画面外に出る */
    min-height: clamp(26rem, 70svh, 44rem);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: var(--ink);
  }
  .hero__media { position: absolute; inset: 0; }
  .hero__media img {
    width: 100%; height: 100%; object-fit: cover;
    animation: heroZoom 18s var(--ease) forwards;
  }
  @keyframes heroZoom { from { transform: scale(1.06); } to { transform: scale(1); } }

  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(20,10,12,.88) 0%, rgba(20,10,12,.62) 32%, rgba(20,10,12,.22) 62%, rgba(20,10,12,0) 88%);
  }

  .hero__inner {
    position: relative;
    width: min(100% - 2.4rem, 74rem);
    margin: 0 auto;
    padding-bottom: clamp(3.5rem, 9vh, 7rem);
    color: #fff;
  }
  .hero__label { color: rgba(255,255,255,.88); margin-bottom: 1.4em; }
  .hero__title {
    font-family: var(--font-jp);
    font-size: var(--fs-h1);
    font-weight: 400;
    line-height: 1.34;
    letter-spacing: .04em;
    margin: 0;
    max-width: 22em;
    text-shadow: 0 1px 30px rgba(0,0,0,.28);
  }

  .hero__cue { position: absolute; left: 50%; bottom: 1.6rem; translate: -50% 0; }
  .hero__cue span {
    display: block; width: 1px; height: 3.2rem;
    background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,.85));
    animation: cue 2.6s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0%   { transform: scaleY(0); opacity: 0; }
    35%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__media img { animation: none; }
    .hero__cue { display: none; }
  }

  /* ── 記事本体 ─────────────────────────── */
  .kb {
    width: min(100% - 2.4rem, 74rem);
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 6rem) 0 var(--gap-section);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 60rem) {
    .kb { padding-left: 6vw; }
  }

  .crumb { font-family: var(--font-ui); font-size: .74rem; letter-spacing: .12em; color: var(--ink-faint); margin: 0 0 clamp(2.5rem, 5vw, 4rem); }
  .crumb a { color: var(--ink-faint); text-decoration: none; transition: color .4s var(--ease); }
  .crumb a:hover { color: var(--ink); }
  .crumb span { margin: 0 .6em; }

  .kb__lead {
    max-width: var(--measure);
    font-size: var(--fs-lead);
    line-height: 2.4;
    letter-spacing: .03em;
    color: var(--ink);
    margin: 0 0 var(--gap-block);
  }
</style>
