---
// &RAW LIVING Step1 読者限定特典ページ
// アクセスキー：書籍裏表紙バーコード横の数字（90000）
const geminiApiKey = import.meta.env.GEMINI_API_KEY || (typeof process !== "undefined" ? process.env.GEMINI_API_KEY : "") || "";
---
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>&RAW LIVING Step1 読者限定特典 | &LAB TOKYO</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CHR2SG5835"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-CHR2SG5835');
    </script>
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap');

        :root {
            --color-bg: #FBF5E9;
            --color-paper: #FFFDF8;
            --color-primary: #5C6E45; /* Olive / Raw Leaf Green */
            --color-secondary: #C9A227; /* Book Gold */
            --color-ink: #3A2E1F; /* Deep Brown Ink */
            --color-line: #E3D8BE;
        }

        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: var(--color-bg);
            background-image: radial-gradient(circle at 1px 1px, rgba(92,110,69,0.06) 1px, transparent 0);
            background-size: 26px 26px;
            color: var(--color-ink);
            margin: 0;
            padding: 0;
        }

        h1, h2, h3, h4 {
            font-family: 'Noto Serif JP', serif;
        }

        .gold-line {
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--color-secondary), transparent);
        }

        .book-card {
            background: var(--color-paper);
            border: 1px solid var(--color-line);
            box-shadow: 0 10px 40px rgba(58,46,31,0.08);
        }

        .tab-btn.active {
            background: var(--color-primary);
            color: white;
            box-shadow: 0 6px 16px rgba(92,110,69,0.25);
        }

        .tab-btn:not(.active) {
            background: white;
            color: var(--color-ink);
            border: 1px solid var(--color-line);
        }

        .pill {
            transition: all 0.2s;
        }

        .spinner {
            border: 3px solid rgba(92,110,69,0.15);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: var(--color-primary);
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

        #gate-screen {
            min-height: 100vh;
        }

        .stamp {
            border: 2px solid var(--color-secondary);
            color: var(--color-secondary);
        }
    </style>
</head>
<body class="overflow-x-hidden">

    <div id="gemini-api-config" data-api-key={geminiApiKey} style="display:none;"></div>

    <!-- ================= ゲート画面（鍵入力） ================= -->
    <section id="gate-screen" class="flex items-center justify-center px-4 py-16">
        <div class="max-w-md w-full text-center">
            <div class="inline-block stamp rounded-full px-4 py-1 text-xs font-bold tracking-widest uppercase mb-6">
                Readers Only
            </div>
            <h1 class="text-2xl md:text-3xl font-bold mb-3 leading-snug">
                &RAW LIVING Step1<br>読者限定特典
            </h1>
            <div class="gold-line w-24 mx-auto mb-6"></div>
            <p class="text-sm text-gray-600 leading-relaxed mb-8">
                本書をお読みいただいた方への、<br>
                特別な特典をご用意しました。<br>
                お手元の書籍、裏表紙のバーコード横にある<br>
                <span class="font-bold text-[#5C6E45]">5桁の番号</span>を入力してください。
            </p>

            <div class="book-card rounded-2xl p-6 md:p-8">
                <label class="block text-xs font-bold text-gray-500 mb-2 tracking-widest uppercase">読者キー</label>
                <input type="text" id="isbn-input" placeholder="5桁の数字を入力" class="w-full px-4 py-3 border border-[#E3D8BE] rounded-lg text-center text-lg tracking-wider focus:outline-none focus:ring-2 focus:ring-[#5C6E45]/40 mb-4">
                <button id="unlock-btn" class="w-full bg-[#5C6E45] hover:bg-[#475636] text-white py-3.5 rounded-lg font-bold tracking-widest transition-colors">
                    特典をひらく
                </button>
                <p id="gate-error" class="hidden text-xs text-red-500 mt-3">番号が一致しません。もう一度ご確認ください。</p>
            </div>

            <p class="text-[11px] text-gray-400 mt-8">
                その番号は、書籍裏表紙のバーコード（ISBN）の右側、QRコードの下に記載されています。
            </p>
        </div>
    </section>

    <!-- ================= 特典コンテンツ（解放後表示） ================= -->
    <main id="bonus-content" class="hidden">

        <!-- ヒーロー -->
        <section class="relative pt-20 pb-16 px-4 text-center overflow-hidden">
            <div class="absolute -right-24 -top-24 w-[420px] h-[420px] bg-[#5C6E45]/5 rounded-full blur-3xl"></div>
            <div class="absolute -left-24 -bottom-24 w-[380px] h-[380px] bg-[#C9A227]/10 rounded-full blur-3xl"></div>
            <div class="max-w-3xl mx-auto relative z-10">
                <div class="inline-block stamp rounded-full px-4 py-1 text-xs font-bold tracking-widest uppercase mb-5">
                    &RAW LIVING Step1 Bonus
                </div>
                <h1 class="text-3xl md:text-5xl font-bold mb-5 leading-tight">
                    本の続きを、<br><span class="text-[#5C6E45] italic">ここから。</span>
                </h1>
                <p class="text-sm md:text-base text-gray-600 leading-relaxed max-w-xl mx-auto">
                    「&RAW LIVING Step1」でご紹介した理論をもとに、<br class="hidden md:block">
                    あなただけのスムージー・ドレッシングづくりや、<br class="hidden md:block">
                    ローフードのお悩み相談ができる特典ラボです。
                </p>
                <p class="text-[11px] text-gray-400 mt-6 italic font-serif">
                    "人は自然から遠ざかるほど病気に近づく" — ヒポクラテス
                </p>
            </div>
        </section>

        <div class="gold-line max-w-4xl mx-auto"></div>

        <!-- ラボ本体 -->
        <section class="py-16 px-4">
            <div class="max-w-5xl mx-auto">

                <div class="flex flex-wrap justify-center gap-3 mb-10" id="step1-tabs">
                    <button id="tab-smoothie-btn" class="tab-btn active px-5 py-2.5 rounded-full font-bold text-sm transition-all">🥬 スムージー生成</button>
                    <button id="tab-dressing-btn" class="tab-btn px-5 py-2.5 rounded-full font-bold text-sm transition-all">🫙 発酵ドレッシング生成</button>
                    <button id="tab-soudan-btn" class="tab-btn px-5 py-2.5 rounded-full font-bold text-sm transition-all">💬 ローフードお悩み相談</button>
                </div>

                <p class="text-center text-[11px] text-gray-400 mb-6">✦ 最新のAIを搭載しています</p>

                <div class="book-card rounded-2xl p-6 md:p-10">

                    <!-- スムージー生成パネル -->
                    <div id="panel-smoothie" class="space-y-6">
                        <h3 class="font-bold text-xl">あなただけのグリーンスムージー</h3>
                        <p class="text-sm text-gray-500">本書の「野菜と果物の黄金バランス」理論にもとづいてレシピを作ります。</p>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">1. 慣れ具合を選択：</span>
                            <div class="flex flex-wrap gap-2" id="smoothie-level-pills">
                                <button class="pill bg-[#5C6E45] text-white text-xs px-4 py-2 rounded-full font-bold border border-transparent" data-val="初心者（野菜4：果物6）">🌱 初心者（甘め）</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="慣れてきた（野菜6：果物4）">🌿 慣れてきた（整え重視）</button>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">2. 使いたい野菜・果物（任意）：</span>
                            <div class="flex flex-wrap gap-2" id="smoothie-ingredient-pills">
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="小松菜">小松菜</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="ほうれん草">ほうれん草</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="ケール">ケール</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="セロリ">セロリ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="りんご">りんご</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="バナナ">バナナ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="レモン">レモン</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="生姜">生姜</button>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">🍃 今が旬のフルーツ（任意）：</span>
                            <div class="flex flex-wrap gap-2" id="smoothie-seasonal-pills"></div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">✦ スーパーフードを加える（任意）：</span>
                            <div class="flex flex-wrap gap-2" id="smoothie-superfood-pills">
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="スピルリナ">スピルリナ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="チアシード">チアシード</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="ビーポーレン">ビーポーレン</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="カカオ">カカオ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="抹茶">抹茶</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="ターメリック">ターメリック</button>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">🎯 目的（任意）：</span>
                            <div class="flex flex-wrap gap-2" id="smoothie-goal-pills">
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="デトックス・むくみ巡り">デトックス・巡り</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="美肌・エイジングケア">美肌・エイジングケア</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="腸活・便通">腸活・便通</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="疲労回復・元気チャージ">疲労回復・元気チャージ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="リフレッシュ・気分転換">リフレッシュ・気分転換</button>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-2">3. その他に加えたい食材（任意）：</span>
                            <input type="text" id="smoothie-custom" placeholder="例: ミント, キウイ" class="w-full px-4 py-3 border border-[#E3D8BE] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C6E45]/40 text-sm bg-white">
                        </div>

                        <button id="generate-smoothie-btn" class="w-full bg-[#5C6E45] hover:bg-[#475636] text-white py-4 px-6 rounded-xl font-bold text-sm tracking-widest shadow-lg transition-transform hover:-translate-y-0.5">
                            スムージーレシピを作る ✨
                        </button>

                        <div id="smoothie-output" class="hidden mt-6 bg-[#FBF5E9] border border-[#E3D8BE] p-6 md:p-8 rounded-xl space-y-4">
                            <h5 class="font-bold text-xl" id="smoothie-out-title">...</h5>
                            <p class="text-sm text-[#5C6E45] bg-white/60 p-4 rounded-lg italic leading-relaxed" id="smoothie-out-concept">...</p>
                            <p class="hidden text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-3" id="smoothie-out-ingredient-note"></p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <h6 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">材料</h6>
                                    <ul class="list-disc list-inside text-sm text-gray-700 space-y-1.5" id="smoothie-out-ingredients"></ul>
                                </div>
                                <div>
                                    <h6 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">作り方</h6>
                                    <ol class="list-decimal list-inside text-sm text-gray-700 space-y-1.5" id="smoothie-out-steps"></ol>
                                </div>
                            </div>
                            <div class="pt-2 border-t border-[#E3D8BE]">
                                <h6 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3 text-center">栄養・甘さのバランス</h6>
                                <div class="max-w-xs mx-auto" style="height: 220px;">
                                    <canvas id="smoothie-balance-chart"></canvas>
                                </div>
                                <div class="mt-5 bg-[#C9A227]/10 border border-[#C9A227]/30 rounded-lg p-4 flex items-start gap-3">
                                    <span class="text-lg">🍃</span>
                                    <p class="text-xs text-gray-700 leading-relaxed" id="smoothie-out-seasonal"></p>
                                </div>
                            </div>
                            <p class="text-[11px] text-gray-400 text-right pt-1" id="smoothie-out-chapter"></p>
                        </div>
                    </div>

                    <!-- ドレッシング生成パネル -->
                    <div id="panel-dressing" class="space-y-6 hidden">
                        <h3 class="font-bold text-xl">あなただけの発酵ドレッシング</h3>
                        <p class="text-sm text-gray-500">本書「楽しむ7つのドレッシング」のレシピをベースに、お好みのタイプを作ります。</p>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">好みのタイプを選択：</span>
                            <div class="flex flex-wrap gap-2" id="dressing-type-pills">
                                <button class="pill bg-[#5C6E45] text-white text-xs px-4 py-2 rounded-full font-bold border border-transparent" data-val="塩麹×シトラスの和風発酵系">和風発酵系</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="メイプル×バルサミコのまろやか系">まろやか系</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="タヒニや野菜のクリーミー系">クリーミー系</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="ゴジベリーや玉ねぎの彩りアクセント系">彩りアクセント系</button>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-3">合わせたい野菜・料理（任意）：</span>
                            <div class="flex flex-wrap gap-2" id="dressing-vegetable-pills">
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="葉物サラダ">葉物サラダ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="生春巻き">生春巻き</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="アボカド">アボカド</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="蒸し野菜">蒸し野菜</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="トマト">トマト</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="スプラウト">スプラウト</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="根菜の温サラダ">根菜の温サラダ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="きのこ">きのこ</button>
                                <button class="pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent" data-val="海藻サラダ">海藻サラダ</button>
                            </div>
                        </div>

                        <div>
                            <span class="block text-xs font-bold text-gray-700 mb-2">その他に合わせたいもの（任意）：</span>
                            <input type="text" id="dressing-custom" placeholder="例: 玄米, 豆腐" class="w-full px-4 py-3 border border-[#E3D8BE] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#5C6E45]/40 text-sm bg-white">
                        </div>

                        <button id="generate-dressing-btn" class="w-full bg-[#5C6E45] hover:bg-[#475636] text-white py-4 px-6 rounded-xl font-bold text-sm tracking-widest shadow-lg transition-transform hover:-translate-y-0.5">
                            ドレッシングレシピを作る ✨
                        </button>

                        <div id="dressing-output" class="hidden mt-6 bg-[#FBF5E9] border border-[#E3D8BE] p-6 md:p-8 rounded-xl space-y-4">
                            <h5 class="font-bold text-xl" id="dressing-out-title">...</h5>
                            <p class="text-sm text-[#5C6E45] bg-white/60 p-4 rounded-lg italic leading-relaxed" id="dressing-out-concept">...</p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <h6 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">材料</h6>
                                    <ul class="list-disc list-inside text-sm text-gray-700 space-y-1.5" id="dressing-out-ingredients"></ul>
                                </div>
                                <div>
                                    <h6 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-2">作り方</h6>
                                    <ol class="list-decimal list-inside text-sm text-gray-700 space-y-1.5" id="dressing-out-steps"></ol>
                                </div>
                            </div>
                            <div class="bg-[#C9A227]/10 border border-[#C9A227]/30 rounded-lg p-4 flex items-start gap-3">
                                <span class="text-lg">🍃</span>
                                <p class="text-xs text-gray-700 leading-relaxed" id="dressing-out-seasonal"></p>
                            </div>
                            <p class="text-[11px] text-gray-400 text-right pt-1" id="dressing-out-chapter"></p>
                        </div>
                    </div>

                    <!-- お悩み相談パネル -->
                    <div id="panel-soudan" class="space-y-6 hidden flex-col">
                        <h3 class="font-bold text-xl">ローフードお悩み相談</h3>
                        <p class="text-sm text-gray-500">本書 Chapter7「よくある質問」をベースに、安藤千英AIがお答えします。</p>

                        <div class="border border-[#E3D8BE] rounded-xl bg-[#FBF5E9] p-4 h-[320px] overflow-y-auto space-y-4 shadow-inner" id="soudan-chat-box">
                            <div class="flex items-start gap-3">
                                <div class="w-8 h-8 rounded-full bg-[#5C6E45] text-white flex items-center justify-center font-bold text-xs shrink-0 shadow">AI</div>
                                <div class="bg-white p-3.5 rounded-2xl rounded-tl-none shadow-sm max-w-[85%] border border-[#E3D8BE]">
                                    <p class="text-sm text-gray-700 leading-relaxed">
                                        こんにちは。「&RAW LIVING Step1」のお悩み相談室です。冷え・タンパク質・好転反応など、本の内容に基づいてお答えします。
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-wrap gap-2">
                            <button class="soudan-shortcut text-xs bg-white hover:bg-gray-100 border border-[#E3D8BE] px-4 py-2 rounded-full text-gray-600 transition-colors shadow-sm" data-msg="ローフードを始めると体が冷えるって本当ですか？">❄️ 体が冷えるって本当？</button>
