            const gateError = document.getElementById('gate-error');

            function normalizeIsbn(v) {
                return v.replace(/[^0-9]/g, '');
            }

            function unlock() {
                gateScreen.classList.add('hidden');
                bonusContent.classList.remove('hidden');
                window.scrollTo(0, 0);
            }

            if (localStorage.getItem(UNLOCK_KEY) === 'true') {
                unlock();
            }

            unlockBtn.addEventListener('click', () => {
                const value = normalizeIsbn(isbnInput.value);
                if (value === VALID_ISBN) {
                    localStorage.setItem(UNLOCK_KEY, 'true');
                    gateError.classList.add('hidden');
                    unlock();
                } else {
                    gateError.classList.remove('hidden');
                }
            });

            isbnInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') unlockBtn.click();
            });

            // ==========================================
            // タブ制御
            // ==========================================
            const tabSmoothieBtn = document.getElementById('tab-smoothie-btn');
            const tabDressingBtn = document.getElementById('tab-dressing-btn');
            const tabSoudanBtn = document.getElementById('tab-soudan-btn');
            const panelSmoothie = document.getElementById('panel-smoothie');
            const panelDressing = document.getElementById('panel-dressing');
            const panelSoudan = document.getElementById('panel-soudan');

            function setActiveTab(activeBtn, activePanel) {
                [tabSmoothieBtn, tabDressingBtn, tabSoudanBtn].forEach(b => b.classList.remove('active'));
                [panelSmoothie, panelDressing, panelSoudan].forEach(p => p.classList.add('hidden'));
                activeBtn.classList.add('active');
                activePanel.classList.remove('hidden');
            }

            tabSmoothieBtn.addEventListener('click', () => setActiveTab(tabSmoothieBtn, panelSmoothie));
            tabDressingBtn.addEventListener('click', () => setActiveTab(tabDressingBtn, panelDressing));
            tabSoudanBtn.addEventListener('click', () => setActiveTab(tabSoudanBtn, panelSoudan));

            // ==========================================
            // ピル選択制御（共通）
            // ==========================================
            function setupSinglePillGroup(containerId) {
                const container = document.getElementById(containerId);
                if (!container) return { getValue: () => "" };
                let selected = container.querySelector('.pill').getAttribute('data-val');
                container.querySelectorAll('.pill').forEach(pill => {
                    pill.addEventListener('click', () => {
                        container.querySelectorAll('.pill').forEach(p => {
                            p.className = "pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent";
                        });
                        pill.className = "pill bg-[#5C6E45] text-white text-xs px-4 py-2 rounded-full font-bold border border-transparent";
                        selected = pill.getAttribute('data-val');
                    });
                });
                return { getValue: () => selected };
            }

            function setupMultiPillGroup(containerId) {
                const container = document.getElementById(containerId);
                if (!container) return { getValues: () => [] };
                const selectedSet = new Set();
                container.querySelectorAll('.pill').forEach(pill => {
                    pill.addEventListener('click', () => {
                        const val = pill.getAttribute('data-val');
                        if (selectedSet.has(val)) {
                            selectedSet.delete(val);
                            pill.className = "pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent";
                        } else {
                            selectedSet.add(val);
                            pill.className = "pill bg-[#5C6E45] text-white text-xs px-4 py-2 rounded-full font-bold border border-transparent";
                        }
                    });
                });
                return { getValues: () => Array.from(selectedSet) };
            }

            function setupOptionalSinglePillGroup(containerId) {
                const container = document.getElementById(containerId);
                if (!container) return { getValue: () => "" };
                let selected = "";
                container.querySelectorAll('.pill').forEach(pill => {
                    pill.addEventListener('click', () => {
                        const val = pill.getAttribute('data-val');
                        if (selected === val) {
                            selected = "";
                            pill.className = "pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent";
                        } else {
                            container.querySelectorAll('.pill').forEach(p => {
                                p.className = "pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent";
                            });
                            pill.className = "pill bg-[#5C6E45] text-white text-xs px-4 py-2 rounded-full font-bold border border-transparent";
                            selected = val;
                        }
                    });
                });
                return { getValue: () => selected };
            }

            // 今が旬のフルーツピルを月ごとに生成
            const SEASONAL_FRUITS_BY_MONTH = {
                1: ['みかん', 'いちご', 'キウイ'],
                2: ['いちご', 'みかん', 'キウイ'],
                3: ['いちご', 'デコポン', 'グレープフルーツ'],
                4: ['いちご', 'グレープフルーツ', 'びわ'],
                5: ['びわ', 'メロン', 'いちご'],
                6: ['すいか', 'メロン', 'プラム'],
                7: ['すいか', 'もも', 'ブルーベリー'],
                8: ['すいか', 'もも', 'ぶどう'],
                9: ['ぶどう', 'なし', 'いちじく'],
                10: ['ぶどう', 'りんご', 'かき'],
                11: ['りんご', 'かき', 'みかん'],
                12: ['みかん', 'りんご', 'ゆず']
            };
            const seasonalContainer = document.getElementById('smoothie-seasonal-pills');
            const currentMonthForFruit = new Date().getMonth() + 1;
            (SEASONAL_FRUITS_BY_MONTH[currentMonthForFruit] || []).forEach(fruit => {
                const btn = document.createElement('button');
                btn.className = "pill bg-gray-100 hover:bg-gray-200 text-xs px-4 py-2 rounded-full font-medium border border-transparent";
                btn.setAttribute('data-val', fruit);
                btn.innerText = fruit;
                seasonalContainer.appendChild(btn);
            });

            const smoothieLevel = setupSinglePillGroup('smoothie-level-pills');
            const smoothieIngredients = setupMultiPillGroup('smoothie-ingredient-pills');
            const smoothieSeasonalFruit = setupMultiPillGroup('smoothie-seasonal-pills');
            const smoothieSuperfoods = setupMultiPillGroup('smoothie-superfood-pills');
            const smoothieGoal = setupOptionalSinglePillGroup('smoothie-goal-pills');
            const dressingType = setupSinglePillGroup('dressing-type-pills');
            const dressingVegetables = setupMultiPillGroup('dressing-vegetable-pills');

            // ==========================================
            // Gemini API 連携
            // ==========================================
            const apiConfigEl = document.getElementById('gemini-api-config');
            let apiKey = apiConfigEl ? apiConfigEl.getAttribute('data-api-key') : "";
            let MODEL_NAME = "gemini-2.5-flash";
            let isPreview = false;

            if (window.location.protocol === 'blob:' || window.location.hostname.includes('usercontent') || window.location.hostname === 'localhost') {
                apiKey = "";
                MODEL_NAME = "gemini-2.5-flash-preview-09-2025";
                isPreview = true;
            }

            const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL_NAME}:generateContent?key=${apiKey}`;

            const DAILY_LIMIT = 10;
            function checkUsageLimit() {
                const today = new Date().toDateString();
                let usage = JSON.parse(localStorage.getItem('step1bonus_ai_usage') || '{"date": "", "count": 0}');
                if (usage.date !== today) usage = { date: today, count: 0 };
                if (usage.count >= DAILY_LIMIT) return false;
                usage.count++;
                localStorage.setItem('step1bonus_ai_usage', JSON.stringify(usage));
                return true;
            }

            function rollbackUsageLimit() {
                const today = new Date().toDateString();
                let usage = JSON.parse(localStorage.getItem('step1bonus_ai_usage') || '{"date": "", "count": 0}');
                if (usage.date === today && usage.count > 0) {
                    usage.count--;
                    localStorage.setItem('step1bonus_ai_usage', JSON.stringify(usage));
                }
            }

            async function callGeminiApi(payload) {
                if (!isPreview && (!apiKey || apiKey === "")) {
                    throw new Error("本番環境用のAPIキーが設定されていません。");
                }
                let attempt = 0;
                const maxAttempts = 5;
                while (attempt < maxAttempts) {
                    try {
                        const response = await fetch(API_URL, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        if (!response.ok) throw new Error(`通信エラーが発生しました (HTTP ${response.status})。`);
                        return await response.json();
                    } catch (error) {
                        attempt++;
                        if (attempt >= maxAttempts) throw error;
                        const delay = Math.pow(2, attempt - 1) * 1000;
                        await new Promise(res => setTimeout(res, delay));
                    }
                }
            }

            const loadingIndicator = document.getElementById('step1-loading');
            const errorIndicator = document.getElementById('step1-error');
            const errorText = document.getElementById('step1-error-text');

            function showLoading() {
                loadingIndicator.classList.remove('hidden');
                loadingIndicator.classList.add('flex');
                errorIndicator.classList.add('hidden');
            }
            function hideLoading() {
                loadingIndicator.classList.add('hidden');
                loadingIndicator.classList.remove('flex');
            }
            function showError(message) {
                hideLoading();
                errorIndicator.classList.remove('hidden');
                errorText.innerText = message;
            }

            const dressingRecipeSchema = {
                type: "OBJECT",
                properties: {
                    name: { type: "STRING" },
                    concept: { type: "STRING" },
                    ingredients: { type: "ARRAY", items: { type: "STRING" } },
                    steps: { type: "ARRAY", items: { type: "STRING" } },
                    seasonalTip: { type: "STRING", description: "今の季節の旬野菜を使ったアレンジ提案" },
                    chapterRef: { type: "STRING", description: "本書のどの章・レシピを参考にしたかの一言" }
                },
                required: ["name", "concept", "ingredients", "steps", "seasonalTip", "chapterRef"]
            };

            const smoothieRecipeSchema = {
                type: "OBJECT",
                properties: {
                    name: { type: "STRING" },
                    concept: { type: "STRING" },
                    ingredients: { type: "ARRAY", items: { type: "STRING" } },
                    steps: { type: "ARRAY", items: { type: "STRING" } },
                    balance: {
                        type: "OBJECT",
                        properties: {
                            sweetness: { type: "INTEGER", description: "甘さの指数 1〜5" },
                            fiber: { type: "INTEGER", description: "食物繊維の量 1〜5" },
                            vitaminC: { type: "INTEGER", description: "ビタミンCの量 1〜5" },
                            detox: { type: "INTEGER", description: "整え・デトックス度 1〜5" }
                        },
                        required: ["sweetness", "fiber", "vitaminC", "detox"]
                    },
                    seasonalTip: { type: "STRING", description: "今の季節に合わせたアレンジ提案" },
                    ingredientNote: { type: "STRING", description: "ユーザー希望食材のうち、本書の理論上使用しなかったものがあれば、その理由をやさしく説明。問題なければ空文字。" },
                    chapterRef: { type: "STRING", description: "本書のどの章・コラムを参考にしたかの一言" }
                },
                required: ["name", "concept", "ingredients", "steps", "balance", "seasonalTip", "ingredientNote", "chapterRef"]
            };

            let smoothieChartInstance = null;

            // ---- スムージー生成 ----
            const SMOOTHIE_SYSTEM_PROMPT = `
あなたは書籍「&RAW LIVING Step1 ローフードの教科書」（著者：安藤千英）の理論だけに基づいてスムージーレシピを提案するアシスタントです。書籍に書かれていない独自の理論や、他の流派の主張を混ぜないでください。

【本書のスムージー理論（厳守ルール）】
1. 黄金バランス：初心者は「野菜4：果物6」、慣れてきた人は「野菜6：果物4」。全体量の目安は約300ml。
2. スムージーに適した野菜：小松菜、ほうれん草（シュウ酸を含むため摂取量に注意）、ケール、水菜、レタス類、セロリ（少量）、ミント・大葉などのハーブ。これらは本書でも互いに代用可能とされているので、毎回同じ野菜に偏らず、バリエーションを持たせること（小松菜ばかりにしない）。
3. スムージーに適さない野菜（提案しない）：ごぼう・蓮根・にんじん・とうもろこし・ビーツ等の根菜類（発酵しやすくガスの原因）、キャベツ・白菜・ブロッコリー・カリフラワー（FODMAP食材）、玉ねぎ・長ねぎ・にらなどのネギ類。
4. 甘酒は糖度が高く血糖値を急上昇させるため使わない。ナッツ類は消化に時間がかかるため朝のスムージーには使わない。
5. 朝、水分補給後に少しずつ飲むのが基本。作り置きは冷蔵で6時間以内、レモンを使うと酸化対策になる。
6. 甘味料は加えず、果物本来の甘さを活かす。
7. ユーザーが希望した食材が3の「適さない野菜」に該当する場合は、レシピには含めず、ingredientNoteで理由をやさしく説明し、代わりに使った野菜を伝えること。希望食材がすべて使える場合はingredientNoteは空文字でよい。

【本書に実在するスーパーフード入りスムージー（参考レシピ）】
- 「スピルリナグリーンのスムージー」：バナナ、りんご、ケール、レモン果汁、スピルリナ小さじ1/3〜1/2、水。スピルリナは少量ずつ加えるのがポイント。
- 「整える、朝のスムージー」：ミックスベリー、セロリ、バナナ、水、レモン果汁。
- ユーザーがスーパーフード（スピルリナ、チアシード、ビーポーレン、カカオ、抹茶、ターメリック等）を希望した場合、上記レシピを参考に少量から加える形で取り入れてよい。チアシードやビーポーレンはトッピングとして仕上げに加える形が本書の流儀。

【目的別のアレンジ指針】
- 「デトックス・むくみ巡り」：セロリ、レモン、きゅうり系の要素を意識する。
- 「美肌・エイジングケア」：ビタミンCが豊富なベリー類や柑橘、抗酸化のカカオ・スピルリナを意識する。
- 「腸活・便通」：食物繊維の多い葉野菜とりんご（皮ごと）を意識する。
- 「疲労回復・元気チャージ」：バナナなど自然な糖質とビタミンB群を意識する。
- 「リフレッシュ・気分転換」：ミントや柑橘系の爽やかな香りを意識する。
- 目的が「おまかせ」の場合は、上記を踏まえつつバランスよく提案する。

【表現上の注意（重要）】
- スムージーはブレンダーで滑らかにした飲み物です。「シャキシャキ」「歯ごたえ」など固形物の食感を表す言葉は絶対に使わないでください。
- 代わりに「なめらか」「すっきり」「飲みやすい」「爽やか」など、飲み物にふさわしい表現を使ってください。

【季節のフルーツ提案における安全ルール（重要）】
- 生食に適さない、または処理をしないと有毒な果物は絶対に提案しないこと。特に「梅（未熟な生梅はアミグダリンを含み中毒のおそれがあり、必ず梅酒・梅干し等の加工が必要なため生食NG）」「銀杏（生食・多量摂取で中毒のおそれ）」「あんず・びわ等の種」は提案禁止。
- 季節のフルーツは、りんご・柑橘類（みかん・グレープフルーツ等）・いちご・桃・ぶどう・柿・すいか・メロン・キウイ・バナナ・ベリー類など、生のまま安全に食べられる一般的な果物の中から、旬のものを提案すること。

【スイカ・メロンの扱い（重要）】
- 本書の「消化スピード別に食べる順番」理論（水分やフルーツは20〜30分という最速で消化される）に基づくと、スイカ・メロンは特に消化が早く、他の食材と混ぜると未消化のまま留まりガスや膨満感の原因になりやすい。
- ユーザーがスイカまたはメロンを希望した場合は、葉野菜や他の果物と混ぜず、スイカ（またはメロン）単体、もしくはレモンや少量のミントのみを加えた「単体スムージー」として提案すること。concept内でその理由も簡潔に伝えること。

ユーザーの要望（レベル・食材・旬のフルーツ・スーパーフード・目的・現在の季節）を踏まえ、上記ルールの範囲内でレシピをJSONで返してください。conceptには、栄養面の効果を本書のトーンに合わせて簡潔に書いてください。
balanceには、出来上がるスムージーの特徴を1〜5の整数で評価してください（sweetness=甘さ、fiber=食物繊維量、vitaminC=ビタミンC量、detox=整え・デトックス度）。
seasonalTipには、伝えられた現在の季節（月）に合わせた一言アレンジ提案を書いてください（例：冷凍フルーツで冷たく、生姜を増やして温め効果を高める、旬の果物に差し替える、など）。本書の理論の範囲内で提案してください。
chapterRefには、このレシピが本書のどの内容を参考にしているかを一言で書いてください（例：「本書 Lesson1『スムージーは"整える朝の一杯"』より」「本書 比率別スムージー例チャートより」など）。
            `;

            document.getElementById('generate-smoothie-btn').addEventListener('click', async () => {
                if (!checkUsageLimit()) {
                    showError("本日のAI利用回数（10回）の上限に達しました。また明日お試しください。");
                    return;
                }
                const level = smoothieLevel.getValue();
                const ingredients = smoothieIngredients.getValues();
                const seasonalFruit = smoothieSeasonalFruit.getValues();
                const superfoods = smoothieSuperfoods.getValues();
                const goal = smoothieGoal.getValue();
                const custom = document.getElementById('smoothie-custom').value.trim();

                document.getElementById('smoothie-output').classList.add('hidden');
                showLoading();

                const currentMonth = new Date().getMonth() + 1;
                const userPrompt = `レベル: ${level}\n使いたい食材: ${ingredients.join(', ') || 'おまかせ'}\n旬のフルーツ希望: ${seasonalFruit.join(', ') || 'なし'}\nスーパーフード希望: ${superfoods.join(', ') || 'なし'}\n目的: ${goal || 'おまかせ'}\n追加要望: ${custom || 'なし'}\n現在の季節: ${currentMonth}月`;
                const payload = {
                    contents: [{ parts: [{ text: userPrompt }] }],
                    systemInstruction: { parts: [{ text: SMOOTHIE_SYSTEM_PROMPT }] },
                    generationConfig: { responseMimeType: "application/json", responseSchema: smoothieRecipeSchema }
                };

                try {
                    const result = await callGeminiApi(payload);
                    let text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (!text) throw new Error("応答データが不正です。");
                    text = text.replace(/```json\n?/g, '').replace(/```\n?/g, '').trim();
                    const data = JSON.parse(text);

                    document.getElementById('smoothie-out-title').innerText = data.name;
                    document.getElementById('smoothie-out-concept').innerText = data.concept;
                    const ul = document.getElementById('smoothie-out-ingredients');
                    ul.innerHTML = "";
                    data.ingredients.forEach(i => { const li = document.createElement('li'); li.innerText = i; ul.appendChild(li); });
                    const ol = document.getElementById('smoothie-out-steps');
                    ol.innerHTML = "";
                    data.steps.forEach(s => { const li = document.createElement('li'); li.innerText = s; ol.appendChild(li); });

                    document.getElementById('smoothie-out-seasonal').innerText = data.seasonalTip || '';

                    const noteEl = document.getElementById('smoothie-out-ingredient-note');
                    if (data.ingredientNote) {
                        noteEl.innerText = "⚠️ " + data.ingredientNote;
                        noteEl.classList.remove('hidden');
                    } else {
                        noteEl.classList.add('hidden');
                    }
                    document.getElementById('smoothie-out-chapter').innerText = data.chapterRef || '';

                    const balance = data.balance || { sweetness: 3, fiber: 3, vitaminC: 3, detox: 3 };
                    const chartCtx = document.getElementById('smoothie-balance-chart').getContext('2d');
                    if (smoothieChartInstance) smoothieChartInstance.destroy();
                    smoothieChartInstance = new Chart(chartCtx, {
                        type: 'bar',
                        data: {
                            labels: ['甘さ', '食物繊維', 'ビタミンC', '整え度'],
                            datasets: [{
                                data: [balance.sweetness, balance.fiber, balance.vitaminC, balance.detox],
                                backgroundColor: ['#C9A227', '#5C6E45', '#8FA876', '#4A5C3A'],
                                borderRadius: 6
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { min: 0, max: 5, ticks: { stepSize: 1 } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });

                    hideLoading();
                    document.getElementById('smoothie-output').classList.remove('hidden');
                } catch (err) {
                    rollbackUsageLimit();
                    showError("レシピの生成中にエラーが発生しました（回数は消費されていません）。詳細: " + err.message);
                }
            });

            // ---- ドレッシング生成 ----
            const DRESSING_SYSTEM_PROMPT = `
あなたは書籍「&RAW LIVING Step1 ローフードの教科書」（著者：安藤千英）に掲載されている「楽しむ7つのドレッシング」をベースに、新しい発酵ドレッシングを提案するアシスタントです。

【本書に実在する7つのドレッシング（必ずこれらの技法・食材カテゴリーの範囲内で発想すること）】
1. 塩麹×レモンのシトラスドレッシング：塩麹、レモン果汁、オリーブオイル、こしょう
2. メイプル×バルサミコのまろやかドレッシング：バルサミコ酢、メイプルシロップ、オリーブオイル、粒マスタード、塩
3. パプリカドレッシング：パプリカ、オリーブオイル、レモン果汁、メイプルシロップ、塩、水
4. タヒニドレッシング：タヒニ（ごまペースト）、レモン果汁、オリーブオイル、メイプルシロップ、にんにく、水、塩
5. 玉ねぎとオリーブのドレッシング：紫玉ねぎ、オリーブオイル、醤油、メイプルシロップ、レモン果汁、にんにく
6. ゴジベリードレッシング：ゴジベリー、紫玉ねぎ、オリーブオイル、レモン汁、塩麹
7. ローナッツマヨネーズ：生カシューナッツ、レモン果汁、白味噌、メイプルシロップ、オリーブオイル

【厳守ルール】
- 必ず「発酵調味料（塩麹・醤油・味噌など）」または「酸（レモン・バルサミコ酢）」のいずれかを軸に使うこと。
- 甘みはメイプルシロップのみを使用し、白砂糖は使わない。
- オイルは基本的にオリーブオイルを使用する。
- 上記7レシピの技法を参考に、ユーザーの好みのタイプ・要望に合わせたオリジナルの組み合わせを提案する。架空の珍しい食材は使わず、家庭で手に入るものに限定する。
- 合わせるサラダの野菜については、本書に明確な制限はないため、旬の野菜を含め自由に提案してよい。毎回同じ野菜（トマトやアボカドなど）に偏らず、季節感のあるバリエーションを意識すること。
- ただし、生食に適さない、または処理をしないと有毒な食材（例：生梅、銀杏、あんず・びわ等の種）は絶対に提案しないこと。

レシピをJSONで返してください。conceptには、発酵や栄養面の効果を本書のトーンに合わせて簡潔に書いてください。
seasonalTipには、伝えられた現在の季節（月）の旬の野菜を使ったサラダのアレンジ提案を一言で書いてください。
chapterRefには、このレシピが本書のどの内容を参考にしているかを一言で書いてください（例：「本書 Lesson2『楽しむ7つのドレッシング』より」など）。
            `;

            document.getElementById('generate-dressing-btn').addEventListener('click', async () => {
                if (!checkUsageLimit()) {
                    showError("本日のAI利用回数（10回）の上限に達しました。また明日お試しください。");
                    return;
                }
                const type = dressingType.getValue();
                const vegetables = dressingVegetables.getValues();
                const custom = document.getElementById('dressing-custom').value.trim();

                document.getElementById('dressing-output').classList.add('hidden');
                showLoading();

                const currentMonth = new Date().getMonth() + 1;
                const userPrompt = `好みのタイプ: ${type}\n合わせたい野菜・料理: ${vegetables.join(', ') || 'おまかせ'}\nその他に合わせたいもの: ${custom || 'なし'}\n現在の季節: ${currentMonth}月`;
                const payload = {
                    contents: [{ parts: [{ text: userPrompt }] }],
                    systemInstruction: { parts: [{ text: DRESSING_SYSTEM_PROMPT }] },
                    generationConfig: { responseMimeType: "application/json", responseSchema: dressingRecipeSchema }
                };

                try {
                    const result = await callGeminiApi(payload);
                    let text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                    if (!text) throw new Error("応答データが不正です。");
                    text = text.replace(/```json\n?/g, '').replace(/```\n?/g, '').trim();
                    const data = JSON.parse(text);

                    document.getElementById('dressing-out-title').innerText = data.name;
                    document.getElementById('dressing-out-concept').innerText = data.concept;
                    const ul = document.getElementById('dressing-out-ingredients');
                    ul.innerHTML = "";
                    data.ingredients.forEach(i => { const li = document.createElement('li'); li.innerText = i; ul.appendChild(li); });
                    const ol = document.getElementById('dressing-out-steps');
                    ol.innerHTML = "";
                    data.steps.forEach(s => { const li = document.createElement('li'); li.innerText = s; ol.appendChild(li); });

                    document.getElementById('dressing-out-seasonal').innerText = data.seasonalTip || '';
                    document.getElementById('dressing-out-chapter').innerText = data.chapterRef || '';

                    hideLoading();
                    document.getElementById('dressing-output').classList.remove('hidden');
                } catch (err) {
                    rollbackUsageLimit();
                    showError("レシピの生成中にエラーが発生しました（回数は消費されていません）。詳細: " + err.message);
                }
            });

            // ---- お悩み相談チャット ----
            const SOUDAN_SYSTEM_PROMPT = `
あなたは書籍「&RAW LIVING Step1 ローフードの教科書」（著者：安藤千英）のChapter7「ローフードのよくある質問」、および本書の知識のみに基づいて回答するお悩み相談AIです。本書に書かれていない医学的助言や、他の流派の理論は答えないでください。

【本書のQ&A知識ベース】
・サラダばかりではない：ラザニアやナッツチーズ、スイーツなど多様なレシピがある。
・100%生でなくてよい：加熱食や発酵食と組み合わせてOK。バランスが目的。
・体が冷える対策：食材や摂り方の工夫で冷えにくくなる。常温に戻す、発酵食やスパイスと組み合わせる。
・タンパク質：ナッツ・豆・スプラウトで植物性たんぱく質を十分摂れる。
・スムージーは体に悪いという説：飲み方次第。葉野菜ベース＋常温でゆっくり飲めば良い習慣になる。
・食中毒リスク：野菜・果物も衛生管理が大切。鮮度の良いものを選び、よく洗えばリスクは低い。
・料理が苦手でも続けられる：切る・混ぜるが中心で簡単。
・ダイエット効果：食物繊維が豊富で満腹感あり、代謝アップやデトックス効果も期待できる。
・デメリット・注意点：冷えや栄養不足に注意。温かい飲み物や発酵食でバランスを。
・家族と一緒に：一品から取り入れてOK。朝のスムージーやドレッシングがおすすめ。
・スムージーの作り置き：密閉・冷蔵で6時間以内が目安。レモンで酸化対策。
・外食が多い場合：サラダを選ぶ、食べる順番（水分→生野菜→メイン→デザート）を意識する。
・冬でも続けられる：常温に戻す、温かい飲み物を使う、発酵食と組み合わせる。
・好転反応：開始後数日〜1週間は倦怠感／眠気／頭痛／便秘または下痢／肌荒れが出ることがある。これは老廃物が排出される過程で一時的なもの。無理せずゆるやかに継続する。
・3週間プログラム：1週目は朝だけスムージー、2週目は昼もローフード中心＋発酵活用、3週目は3食中2食をローフード＋1食調整型。
・水分摂取目安：1日1.5〜2リットル。
・控えたいもの：アルコール、揚げ物・動物性脂肪の多い食品、白砂糖・精製甘味料、カフェイン、小麦製品（完全除去は不要、量の調整）。
・Chapter12「"代謝の未来"を変える3つの鍵」（吉田医師の知見）：
　- Spermidine（スペルミジン）：細胞内のオートファジー（不要物を分解・再利用する仕組み）を活性化し、細胞のクリアリングや再生を促す自然由来のポリアミン。発酵食品に豊富に含まれ、ローフードの食事と相性が良い。
　- NAD（ニコチンアミド・アデニン・ジヌクレオチド）：体内でエネルギーを生み出す重要な補酵素。加齢で減少するが、ローフードやファスティングで自然に補える。ナイアシンやトリプトファンから生成される。
　- Metabolic Flexibility（代謝の柔軟性）：糖（グルコース）と脂肪（脂肪酸）を状況に応じて使い分ける体の能力。整っていると痩せやすく、血糖・インスリンも安定しやすい。
　- これら3つは医師である吉田先生の体験をもとに、心不全（HFpEF）の改善可能性なども含めて本書で紹介されている。

【知識ベースにない質問への対応】
- 上記の知識ベースに直接の記載がない質問については、「断定はできませんが」と前置きしつつ、本書全体の精神（生と発酵の力で内側から整える）に基づいた一般的な範囲で答える。「本書に記載がない」と安易に決めつけず、まず本書の全体テーマに関連しそうか考えること。

【回答のスタンス】
- 安藤千英として、温かく励ますような口調で答える。
- 本書の内容に基づいた範囲でのみ答え、過度な医学的断定は避け、心配な症状は医師に相談するよう優しく案内する。
- 簡潔に、3〜5文程度で答える。
- 回答の最後に、参考にした本書の章を一言添える（例：「（本書 Chapter7『ローフードのよくある質問』参照）」「（本書 Chapter8『ローフードの実践ステップ』参照）」など）。質問内容に応じて、関連する章を選ぶこと。
            `;

            const chatBox = document.getElementById('soudan-chat-box');
            const soudanInput = document.getElementById('soudan-input');
            const soudanSendBtn = document.getElementById('soudan-send-btn');

            const addMessage = (sender, text) => {
                const msgDiv = document.createElement('div');
                msgDiv.className = "flex items-start gap-3 " + (sender === 'user' ? "justify-end" : "");
                let avatarHTML = '';
                let bubbleClass = '';
                if (sender === 'user') {
                    avatarHTML = `<div class="w-8 h-8 rounded-full bg-[#C9A227] text-white flex items-center justify-center font-bold text-xs shrink-0 order-2 shadow">ME</div>`;
                    bubbleClass = "bg-[#C9A227] text-white rounded-tr-none shadow-sm order-1";
                } else {
                    avatarHTML = `<div class="w-8 h-8 rounded-full bg-[#5C6E45] text-white flex items-center justify-center font-bold text-xs shrink-0 order-1 shadow">AI</div>`;
                    bubbleClass = "bg-white text-gray-700 rounded-tl-none shadow-sm border border-[#E3D8BE] order-2";
                }
                msgDiv.innerHTML = `${avatarHTML}<div class="p-3.5 rounded-2xl max-w-[85%] ${bubbleClass}"><p class="text-sm leading-relaxed whitespace-pre-wrap">${text}</p></div>`;
                chatBox.appendChild(msgDiv);
                chatBox.scrollTop = chatBox.scrollHeight;
                return msgDiv;
            };

            const handleSoudan = async (message) => {
                if (!message) return;
                addMessage('user', message);
                soudanInput.value = "";

                if (!checkUsageLimit()) {
                    addMessage('ai', "本日のAI利用回数（10回）の上限に達しました。また明日ご相談ください。");
                    return;
                }

                const typingMsg = addMessage('ai', '思考中...');
                typingMsg.id = 'soudan-typing-indicator';

                const payload = {
                    contents: [{ parts: [{ text: message }] }],
                    systemInstruction: { parts: [{ text: SOUDAN_SYSTEM_PROMPT }] }
                };

                try {
                    const result = await callGeminiApi(payload);
                    const text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                    document.getElementById('soudan-typing-indicator').remove();
                    if (text) {
                        addMessage('ai', text);
                    } else {
                        throw new Error("応答が空でした。");
                    }
                } catch (err) {
                    document.getElementById('soudan-typing-indicator').remove();
                    rollbackUsageLimit();
                    addMessage('ai', "申し訳ありません、通信エラーが発生しました（利用回数は消費されていません）。少し時間をおいて再度お試しください。");
                }
            };

            soudanSendBtn.addEventListener('click', () => handleSoudan(soudanInput.value.trim()));
            soudanInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleSoudan(soudanInput.value.trim()); });
            document.querySelectorAll('.soudan-shortcut').forEach(btn => {
                btn.addEventListener('click', () => handleSoudan(btn.getAttribute('data-msg')));
            });

        });
    </script>
</body>
