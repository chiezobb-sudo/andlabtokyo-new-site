---
import Layout from '../layouts/Layout.astro';
import { getPage, getKnowledgeList } from '../lib/microcms';
import HeroBlock from '../components/blocks/HeroBlock.astro';
import ConceptBandBlock from '../components/blocks/ConceptBandBlock.astro';
import CourseGridBlock from '../components/blocks/CourseGridBlock.astro';
import KnowledgeGridBlock from '../components/blocks/KnowledgeGridBlock.astro';
import ProfileBandBlock from '../components/blocks/ProfileBandBlock.astro';
import RichSectionBlock from '../components/blocks/RichSectionBlock.astro';
import SliderAreaBlock from '../components/blocks/SliderAreaBlock.astro';
import type { HeroBlock as HeroBlockType, ConceptBandBlock as ConceptBandBlockType, CourseGridBlock as CourseGridBlockType, KnowledgeGridBlock as KnowledgeGridBlockType, ProfileBandBlock as ProfileBandBlockType, RichSectionBlock as RichSectionBlockType, SliderAreaBlock as SliderAreaBlockType } from '../lib/microcms';

const page = await getPage('home');

// knowledgeGrid が1つでもあれば記事を取得
const needsArticles = page?.blocks.some((b) => b.fieldId === 'knowledgeGrid') ?? false;
const allArticles = needsArticles ? await getKnowledgeList() : [];
---

<Layout
  title={page?.metaTitle ?? '東京・渋谷のローフード×発酵料理教室 | &LAB TOKYO'}
  description={page?.metaDescription ?? '東京・渋谷発のローフード×発酵専門料理教室。ローチョコレート・ロースイーツ・発酵プランナーなど本格資格講座を開講。ELLE gourmet認定料理家・安藤千英主宰。'}
  canonical="https://www.andlabtokyo.com/"
  type="website"
  ogImage={page?.ogImage?.url}
>

{page?.blocks.map((block) => (
  <>
    {block.fieldId === 'hero'         && <HeroBlock        block={block as HeroBlockType} />}
    {block.fieldId === 'conceptBand'  && <ConceptBandBlock  block={block as ConceptBandBlockType} />}
    {block.fieldId === 'courseGrid'   && <CourseGridBlock   block={block as CourseGridBlockType} />}
    {block.fieldId === 'knowledgeGrid'&& <KnowledgeGridBlock block={block as KnowledgeGridBlockType} articles={allArticles.slice(0, (block as KnowledgeGridBlockType).count ?? 3)} />}
    {block.fieldId === 'profileBand'  && <ProfileBandBlock  block={block as ProfileBandBlockType} />}
    {block.fieldId === 'richSection'  && <RichSectionBlock  block={block as RichSectionBlockType} />}
    {block.fieldId === 'sliderArea'   && <SliderAreaBlock   block={block as SliderAreaBlockType} />}
  </>
))}

</Layout>
