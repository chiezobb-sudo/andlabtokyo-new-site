---
/**
 * 体験レッスン一覧
 *
 * 本文は Wix の /experiencelessons からそのまま移設。3か月 13クリック。
 * 各体験レッスンへの動線（ローフード／発酵／UMAMI & KOJI LAB）を追加している。
 *
 * 文言・写真の指定は src/data/pages/experiencelessons.json。
 */
import Layout from '../layouts/Layout.astro';
import CoursePage from '../components/course/CoursePage.astro';
import { articleJsonLd } from '../lib/article-jsonld';
import d from '../data/pages/experiencelessons.json';

const url = 'https://www.andlabtokyo.com/experiencelessons';
const jsonLd = articleJsonLd({
  path: '/experiencelessons',
  headline: '東京のローフード・発酵体験レッスン',
  description: d.summary,
  image: d.meta.ogImage,
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: '体験レッスン' }],
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
