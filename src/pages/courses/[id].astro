---
import Layout from '../../layouts/Layout.astro';
import { getCourseList, getCourse } from '../../lib/microcms';

export async function getStaticPaths() {
  const list = await getCourseList();
  return list.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const c = await getCourse(id!);
if (!c) return Astro.redirect('/listofcourses');

const hasGallery = c.gallery && c.gallery.length > 0;
---

<Layout title={c.title} description={c.subtitle ?? c.title} ogImage={c.main_image?.url}>
<main class="lp">

<!-- ════════════════════════════
  §1  HERO — CMS
════════════════════════════ -->
<section class="hero">
  {c.main_image
    ? <img class="hero__bg"
        src={`${c.main_image.url}?w=1920&q=85`} alt=""
        width={c.main_image.width} height={c.main_image.height}
        fetchpriority="high" decoding="async" />
    : <div class="hero__bg hero__bg--fallback" aria-hidden="true"></div>
  }
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner">
    <p class="eyebrow eyebrow--gold hero__pre">COURSE</p>
    <h1 class="hero__title">{c.title}</h1>
    {c.subtitle && <p class="hero__sub">{c.subtitle}</p>}
    <div class="hero__btns">
      <a href="#form" class="btn btn--gold">今すぐ申し込む</a>
      <a href="#curriculum" class="btn btn--ghost">カリキュラムを見る</a>
    </div>
  </div>
  <div class="hero__cue" aria-hidden="true"><span></span></div>
</section>

<!-- ════════════════════════════
  §2  TARGET — CMS
════════════════════════════ -->
{c.target && (
<section class="sec sec--warm target-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">FOR YOU</p>
      <h2 class="sec__title">こんな方へ</h2>
      <p class="sec__lead">あなたの「学びたい」に、この講座は応えます。</p>
    </header>
    <div class="prose prose--target" set:html={c.target} />
  </div>
</section>
)}

<!-- ════════════════════════════
  §3  DESCRIPTION — CMS
════════════════════════════ -->
{c.description && (
<section class="sec sec--offwhite">
  <div class="sec__inner">
    <header class="sec__hd">
      <p class="eyebrow">ABOUT</p>
      <h2 class="sec__title sec__title--dark">講座について</h2>
    </header>
    <div class="prose prose--desc" set:html={c.description} />
  </div>
</section>
)}

<!-- ════════════════════════════
  §4  GALLERY — CMS（gallery[]）
════════════════════════════ -->
{hasGallery && (
<section class="sec sec--dark gallery-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--dim">GALLERY</p>
      <h2 class="sec__title sec__title--light">講座で作るローチョコレートの世界</h2>
    </header>
    <div class="gallery">
      {c.gallery!.map((img, i) => (
        <figure class={`gallery__item gallery__item--${(i % 5) + 1}`}>
          <img
            src={`${img.url}?w=900&q=85`}
            alt={`作品 ${i + 1}`}
            width={img.width}
            height={img.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
)}

<!-- ════════════════════════════
  §5  CURRICULUM — CMS（3ステップカード型）
════════════════════════════ -->
{c.curriculum && (
<section class="sec sec--white curr-sec" id="curriculum">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">CURRICULUM</p>
      <h2 class="sec__title sec__title--dark">3ステップで確実に身につくカリキュラム</h2>
      <p class="sec__lead sec__lead--dark">基礎から段階を踏んで、プロレベルの知識と技術を習得します。</p>
    </header>
    <div class="prose prose--curr" set:html={c.curriculum} />
  </div>
</section>
)}

<!-- ════════════════════════════
  §6  INSTRUCTOR — ハードコード（共通）
════════════════════════════ -->
<section class="sec sec--warm instructor-sec">
  <div class="sec__inner instructor-sec__layout">
    <div class="instructor-sec__img-wrap">
      <div class="instructor-sec__img-bg" aria-hidden="true">
        <span class="instructor-sec__monogram">CA</span>
      </div>
    </div>
    <div class="instructor-sec__body">
      <header class="sec__hd">
        <p class="eyebrow eyebrow--warm">INSTRUCTOR</p>
        <h2 class="sec__title sec__title--dark">講師紹介</h2>
      </header>
      <p class="instructor-sec__name-en">Chie Ando</p>
      <p class="instructor-sec__name-jp">安藤 千英</p>
      <p class="instructor-sec__tags">
        <span class="tag">ELLE gourmet 認定料理家</span>
        <span class="tag">&LAB TOKYO 主宰</span>
        <span class="tag">食と哲学のプロデューサー</span>
      </p>
      <div class="instructor-sec__bio">
        <p>ローチョコレート・ロースイーツ・発酵料理の専門家。ELLE gourmet認定料理家として、食と哲学を融合させたユニークなアプローチで、食の本質と身体への深い理解を伝えています。</p>
        <p>ローショコラティエ協会主宰として、ローチョコレートマイスター®・ローショコラティエ®・ローパティシエ®・発酵創家®の各認定資格を監修。1,000名以上の受講生を輩出し、その哲学は国内外で支持されています。</p>
      </div>
      <ul class="instructor-sec__awards">
        <li>ローチョコレートマイスター® 登録商標取得</li>
        <li>ローショコラティエ® 登録商標取得</li>
        <li>発酵創家® 登録商標取得</li>
        <li>NHK・雑誌・ウェブメディア多数掲載</li>
      </ul>
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §7  VOICES — ハードコード（共通）
════════════════════════════ -->
<section class="sec sec--dark voices-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--dim">VOICES</p>
      <h2 class="sec__title sec__title--light">生徒さんの声</h2>
    </header>
    <ul class="voices" role="list">
      <li class="voice">
        <div class="voice__stars" aria-label="評価5">★★★★★</div>
        <blockquote class="voice__body">
          <p>チョコレートがこんなに奥深いものだと知らなかった。安藤先生の哲学的な視点から食を学ぶことで、料理への向き合い方が根本から変わりました。認定を取得してから自分のアトリエを開くことができ、今では毎月満席です。</p>
        </blockquote>
        <footer class="voice__footer">
          <p class="voice__name">K.M. さん</p>
          <p class="voice__attr">ローチョコレートマイスター® 取得／東京都</p>
        </footer>
      </li>
      <li class="voice">
        <div class="voice__stars" aria-label="評価5">★★★★★</div>
        <blockquote class="voice__body">
          <p>食と身体の繋がりを科学的かつ哲学的に学べる唯一無二の講座。素材選びから発酵の仕組みまで、「なぜ」を徹底的に教えてくれるので、応用が効く本物の知識が身につきます。仕事にする自信がつきました。</p>
        </blockquote>
        <footer class="voice__footer">
          <p class="voice__name">A.T. さん</p>
          <p class="voice__attr">発酵創家® 取得／神奈川県</p>
        </footer>
      </li>
      <li class="voice">
        <div class="voice__stars" aria-label="評価5">★★★★★</div>
        <blockquote class="voice__body">
          <p>ローフードという言葉のイメージを完全に覆された講座でした。難しそう・ストイックというイメージが、「おいしく・美しく・続けられる」食哲学へ。家族の食生活も変わり、自分自身も健康的になりました。</p>
        </blockquote>
        <footer class="voice__footer">
          <p class="voice__name">Y.S. さん</p>
          <p class="voice__attr">ローパティシエ® 取得／大阪府</p>
        </footer>
      </li>
    </ul>
  </div>
</section>

<!-- ════════════════════════════
  §8  INFO — CMS（開催情報 & 料金）
════════════════════════════ -->
{(c.schedule || c.price) && (
<section class="sec sec--offwhite info-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">INFO</p>
      <h2 class="sec__title sec__title--dark">開催情報 & 受講料一覧</h2>
    </header>
    <div class="info-grid">
      {c.schedule && (
        <div class="info-card">
          <div class="info-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <p class="info-card__label">開催日程</p>
          <p class="info-card__val">{c.schedule}</p>
        </div>
      )}
      {c.price && (
        <div class="info-card info-card--price">
          <div class="info-card__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <p class="info-card__label">受講料金</p>
          <p class="info-card__price">{c.price}</p>
          <p class="info-card__note">
            ※お支払いはクレジットカード決済もしくはお振込のみとなります。<br />
            （分割払いは対応しておりません）
          </p>
        </div>
      )}
    </div>
    <div class="info-sec__cta">
      <a href="#form" class="btn btn--gold btn--lg">このコースに申し込む</a>
    </div>
  </div>
</section>
)}

<!-- ════════════════════════════
  §9  FAQ — CMS（アコーディオン）
════════════════════════════ -->
{c.faq && (
<section class="sec sec--white faq-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">FAQ</p>
      <h2 class="sec__title sec__title--dark">よくあるご質問</h2>
    </header>
    <div class="faq__src" aria-hidden="true" style="display:none" set:html={c.faq} />
    <dl class="faq__list" id="faqList"></dl>
  </div>
</section>
)}

<!-- ════════════════════════════
  §10  NEXT STEP — ハードコード（共通）
════════════════════════════ -->
<section class="sec sec--dark nextstep-sec">
  <div class="sec__inner nextstep-sec__inner">
    <div class="road">
      <header class="sec__hd sec__hd--center">
        <p class="eyebrow eyebrow--dim">STEP UP</p>
        <h2 class="sec__title sec__title--light">次のステップへ</h2>
        <p class="sec__lead">基礎から着実に積み上げ、協会認定プロへ。</p>
      </header>
      <ol class="road__steps">
        <li class="road__step">
          <div class="road__num">01</div>
          <div class="road__body">
            <p class="road__tag">BASIC</p>
            <p class="road__name">初級講座</p>
            <p class="road__desc">基礎理論・素材・基本レシピを体系的に習得</p>
          </div>
        </li>
        <li class="road__step">
          <div class="road__num">02</div>
          <div class="road__body">
            <p class="road__tag">INTERMEDIATE</p>
            <p class="road__name">中級講座</p>
            <p class="road__desc">応用技術・商品化レベルのデザイン性を習得</p>
          </div>
        </li>
        <li class="road__step">
          <div class="road__num">03</div>
          <div class="road__body">
            <p class="road__tag">ADVANCE</p>
            <p class="road__name">上級講座</p>
            <p class="road__desc">独自開発・ブランディング・指導力を習得</p>
          </div>
        </li>
        <li class="road__step road__step--cert">
          <div class="road__num road__num--cert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <circle cx="12" cy="8" r="6"/>
              <path d="M8.2 14.3 7 22l5-3 5 3-1.2-7.7"/>
            </svg>
          </div>
          <div class="road__body">
            <p class="road__tag">CERTIFICATE</p>
            <p class="road__name">認定資格取得</p>
            <p class="road__desc">協会認定プロとして教室・販売・講師活動が可能に</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §11  FORM — ハードコード（共通）
════════════════════════════ -->
<section class="sec sec--ink form-sec" id="form">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--dim">APPLY</p>
      <h2 class="sec__title sec__title--light">お申し込み・お問い合わせ</h2>
      <p class="form-sec__lead">下記フォームよりご連絡ください。2営業日以内にご返信いたします。</p>
    </header>
    <form
      class="form-sec__form"
      name={`course-apply-${c.id}`}
      method="POST"
      data-netlify="true"
      novalidate
    >
      <input type="hidden" name="form-name" value={`course-apply-${c.id}`} />
      <input type="hidden" name="course" value={c.title} />

      <div class="form-row">
        <div class="form-field">
          <label class="form-label" for="f-name">お名前 <span class="req">必須</span></label>
          <input class="form-input" type="text" id="f-name" name="name"
            placeholder="安藤 千英" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label class="form-label" for="f-kana">フリガナ</label>
          <input class="form-input" type="text" id="f-kana" name="kana"
            placeholder="アンドウ チエ" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label class="form-label" for="f-email">メールアドレス <span class="req">必須</span></label>
          <input class="form-input" type="email" id="f-email" name="email"
            placeholder="your@email.com" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label class="form-label" for="f-tel">電話番号</label>
          <input class="form-input" type="tel" id="f-tel" name="tel"
            placeholder="090-0000-0000" autocomplete="tel" />
        </div>
      </div>
      <div class="form-field">
        <label class="form-label" for="f-when">ご希望の日程・時期</label>
        <input class="form-input" type="text" id="f-when" name="schedule"
          placeholder="例：9月以降の週末を希望" />
      </div>
      <div class="form-field">
        <label class="form-label" for="f-msg">お問い合わせ内容</label>
        <textarea class="form-textarea" id="f-msg" name="message"
          rows="5" placeholder="ご質問・ご要望などをご記入ください。"></textarea>
      </div>
      <div class="form-submit">
        <button class="btn btn--gold btn--lg" type="submit">送信する</button>
        <p class="form-privacy">
          送信いただくことで
          <a href="/privacy" target="_blank" rel="noopener">プライバシーポリシー</a>
          に同意したものとみなします。
        </p>
      </div>
    </form>
  </div>
</section>

</main>
</Layout>

<!-- FAQ アコーディオン生成 -->
<script>
(function () {
  const src = document.querySelector<HTMLElement>('.faq__src');
  const list = document.getElementById('faqList');
  if (!src || !list) return;

  src.querySelectorAll('h2').forEach((h2, i) => {
    const q = h2.textContent?.trim() ?? '';
    const answerNodes: Node[] = [];
    let sib = h2.nextElementSibling;
    while (sib && sib.tagName !== 'H2') {
      answerNodes.push(sib.cloneNode(true));
      sib = sib.nextElementSibling;
    }

    const dt = document.createElement('dt');
    dt.className = 'faq-q';
    dt.setAttribute('role', 'button');
    dt.setAttribute('tabindex', '0');
    dt.setAttribute('aria-expanded', 'false');
    dt.setAttribute('aria-controls', `faq-a-${i}`);
    dt.innerHTML = `<span class="faq-q__text">${q}</span>
      <span class="faq-q__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </span>`;

    const dd = document.createElement('dd');
    dd.className = 'faq-a';
    dd.id = `faq-a-${i}`;
    dd.hidden = true;
    const inner = document.createElement('div');
    inner.className = 'faq-a__inner';
    answerNodes.forEach(n => inner.appendChild(n));
    dd.appendChild(inner);

    const toggle = () => {
      const open = dt.getAttribute('aria-expanded') === 'true';
      dt.setAttribute('aria-expanded', String(!open));
      dd.hidden = open;
    };
    dt.addEventListener('click', toggle);
    dt.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });

    list.appendChild(dt);
    list.appendChild(dd);
  });
})();
</script>

<style>
/* ═══════════════════════════════════════════
   DESIGN TOKENS
═══════════════════════════════════════════ */
.lp {
  --gold:     #a68a6d;
  --gold-lt:  #c4a882;
  --gold-dim: rgba(166,138,109,.55);
  --gold-bg:  rgba(166,138,109,.09);
  --dark:     #141413;
  --ink:      #1a1917;
  --sub:      #3a3835;
  --muted:    #6b6560;
  --warm:     #f4ede3;
  --offwhite: #fafaf8;
  --line:     rgba(26,25,23,.1);
  --r:        0.75rem;
}

/* ═══════════════════════════════════════════
   SHARED: BUTTONS
═══════════════════════════════════════════ */
.btn {
  display: inline-block;
  font-family: var(--font-ui, sans-serif);
  font-size: .8rem; letter-spacing: .18em; text-transform: uppercase;
  text-decoration: none; padding: 1rem 2.6rem;
  border: 1px solid transparent;
  cursor: pointer; transition: opacity .28s, background .28s, border-color .28s, color .28s;
  white-space: nowrap;
}
.btn--gold  { background: var(--gold); color: #0a0808; border-color: var(--gold); }
.btn--gold:hover { opacity: .78; }
.btn--ghost { background: transparent; color: rgba(240,236,230,.65); border-color: rgba(240,236,230,.28); }
.btn--ghost:hover { background: rgba(240,236,230,.07); border-color: rgba(240,236,230,.55); color: rgba(240,236,230,.9); }
.btn--lg { padding: 1.15rem 3.2rem; font-size: .86rem; }

/* ═══════════════════════════════════════════
   SHARED: SECTION SCAFFOLD
═══════════════════════════════════════════ */
.sec { padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 5rem); }
.sec--dark     { background: var(--dark); }
.sec--ink      { background: #0e0c0b; }
.sec--warm     { background: var(--warm); }
.sec--offwhite { background: var(--offwhite); }
.sec--white    { background: #fff; border-top: 1px solid var(--line); }

.sec__inner { width: min(100%, 78rem); margin: 0 auto; }

.sec__hd { margin-bottom: clamp(3rem, 5vw, 5rem); }
.sec__hd--center { text-align: center; }

.sec__title {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.55rem, 3vw, 2.5rem);
  font-weight: 300; letter-spacing: .08em; line-height: 1.45; margin: 0;
}
.sec__title--dark  { color: var(--ink); }
.sec__title--light { color: rgba(240,236,230,.93); }

.sec__lead {
  font-family: var(--font-jp, sans-serif);
  font-size: .93rem; font-weight: 300; line-height: 1.9;
  color: var(--muted); margin: 1rem 0 0;
}
.sec__lead--dark { color: #6b6560; }

/* ═══════════════════════════════════════════
   SHARED: EYEBROW
═══════════════════════════════════════════ */
.eyebrow {
  font-family: var(--font-ui, sans-serif);
  font-size: .6rem; letter-spacing: .4em; text-transform: uppercase;
  display: block; margin: 0 0 .9rem;
}
.eyebrow--gold { color: var(--gold); }
.eyebrow--warm { color: #9a7858; }
.eyebrow--dim  { color: rgba(240,236,230,.38); }

/* ═══════════════════════════════════════════
   §1  HERO
═══════════════════════════════════════════ */
.hero {
  position: relative; min-height: 100svh;
  display: grid; place-items: center;
  overflow: hidden; background: var(--dark);
}
.hero__bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover; object-position: center 30%;
  animation: heroKen 22s cubic-bezier(.16,1,.3,1) forwards;
}
.hero__bg--fallback { background: linear-gradient(135deg,#1c1a18 0%,#2e2720 100%); }
@keyframes heroKen { from { transform: scale(1.07); } to { transform: scale(1); } }

.hero__scrim {
  position: absolute; inset: 0;
  background:
    linear-gradient(to right, rgba(10,8,6,.82) 0%, rgba(10,8,6,.5) 50%, rgba(10,8,6,.15) 100%),
