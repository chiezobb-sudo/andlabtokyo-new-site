<!-- FAQ アコーディオン生成 -->
<script>
(function () {
  const src = document.querySelector<HTMLElement>('.faq__src');
  const list = document.getElementById('faqList');
  if (!src || !list) return;

  src.querySelectorAll('h2').forEach((h2, i) => {
    const q = h2.textContent?.trim() ?? '';
    const answerNodes: Node[] = [];
    let sib = h2.nextElementSibling;
    while (sib && sib.tagName !== 'H2') {
      answerNodes.push(sib.cloneNode(true));
      sib = sib.nextElementSibling;
    }

    const dt = document.createElement('dt');
    dt.className = 'faq-q';
    dt.setAttribute('role', 'button');
    dt.setAttribute('tabindex', '0');
    dt.setAttribute('aria-expanded', 'false');
    dt.setAttribute('aria-controls', `faq-a-${i}`);
    dt.innerHTML = `<span class="faq-q__text">${q}</span>
      <span class="faq-q__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </span>`;

    const dd = document.createElement('dd');
    dd.className = 'faq-a';
    dd.id = `faq-a-${i}`;
    dd.hidden = true;
    const inner = document.createElement('div');
    inner.className = 'faq-a__inner';
    answerNodes.forEach(n => inner.appendChild(n));
    dd.appendChild(inner);

    const toggle = () => {
      const open = dt.getAttribute('aria-expanded') === 'true';
      dt.setAttribute('aria-expanded', String(!open));
      dd.hidden = open;
    };
    dt.addEventListener('click', toggle);
    dt.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });

    list.appendChild(dt);
    list.appendChild(dd);
  });
})();
</script>

