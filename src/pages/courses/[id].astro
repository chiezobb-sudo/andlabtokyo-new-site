/* CSSカウンターでh2をSTEPカードに自動変換 */
.prose--curr {
  counter-reset: step;
}
.prose--curr :global(h2) {
  counter-increment: step;
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 1.4rem;
  background: #fff;
  border: 1px solid var(--line);
  border-left: none;
  padding: 1.6rem 2rem;
  margin: 2.4rem 0 0;
  font-size: clamp(1rem, 1.6vw, 1.25rem);
  font-weight: 500; letter-spacing: .05em;
  color: var(--ink); line-height: 1.5;
  position: relative;
}
.prose--curr :global(h2)::before {
  content: "STEP " counter(step, decimal-leading-zero);
  font-family: var(--font-ui, sans-serif);
  font-size: .62rem; font-weight: 400;
  letter-spacing: .28em; text-transform: uppercase;
  color: #fff;
  background: var(--gold);
  padding: .55rem 1rem;
  white-space: nowrap;
  align-self: stretch;
  display: flex; align-items: center;
  margin: -1.6rem -2rem -1.6rem 0;
  margin-left: calc(-2rem - 1px);
  min-width: 7rem;
  justify-content: center;
}

/* STEPカード直後のコンテンツ */
.prose--curr :global(h2) ~ :global(p),
.prose--curr :global(h2) ~ :global(ul),
.prose--curr :global(h2) ~ :global(ol) {
  background: var(--offwhite);
  border: 1px solid var(--line); border-top: none;
  padding: 1.4rem 2rem;
  margin: 0;
}
.prose--curr :global(ul), .prose--curr :global(ol) { padding-left: 3.5rem; }
.prose--curr :global(li) { margin-bottom: .55em; }

/* ═══════════════════════════════════════════
   ▸ PROSE 共通（リッチエディタ全体）
═══════════════════════════════════════════ */
.prose {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.93rem, 1.15vw, 1.03rem);
  font-weight: 300; line-height: 2.15; letter-spacing: .04em;
  color: var(--sub);
}

/* strong / b → ブランドゴールド */
.prose :global(strong),
.prose :global(b) {
  font-weight: 600; color: #7a5c35;
  background: rgba(166,138,109,.1);
  padding: .04em .22em; border-radius: 3px;
}

/* 見出し（prose--curr以外） */
.prose:not(.prose--curr) :global(h2) {
  font-size: clamp(1.1rem, 1.9vw, 1.45rem); font-weight: 400;
  color: var(--ink); letter-spacing: .07em; line-height: 1.55;
