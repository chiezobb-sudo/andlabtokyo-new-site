.hero__cta {
  display: inline-flex; align-items: center;
  padding: .85em 2em;
  font-family: var(--font-ui, sans-serif);
  font-size: .78rem; letter-spacing: .18em; text-transform: uppercase;
  text-decoration: none;
  border: 1px solid transparent;
  transition: background .3s, border-color .3s, color .3s;
}
.hero__cta--outline {
  background: rgba(255,255,255,.06);
  border-color: rgba(240,236,226,.38);
  color: rgba(240,236,226,.85);
  backdrop-filter: blur(4px);
}
.hero__cta--outline:hover {
  background: rgba(255,255,255,.11);
  border-color: rgba(166,138,109,.65);
  color: #f8f3ec;
}
.hero__cta--primary {
  background: var(--gold, #a68a6d);
  border-color: var(--gold, #a68a6d);
  color: #fff;
}
.hero__cta--primary:hover {
  background: #8a6e53;
  border-color: #8a6e53;
}

.hero__scroll {
  position: absolute; left: 50%; bottom: 2.2rem;
  transform: translateX(-50%);
}
.hero__scroll span {
  display: block; width: 1px; height: 3.8rem;
  background: linear-gradient(to bottom, transparent, rgba(166,138,109,.7));
  animation: scrollPulse 2.8s ease-in-out infinite;
  transform-origin: top;
}
@keyframes scrollPulse {
  0%   { transform: scaleY(0); opacity: 0; }
  35%  { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(1); opacity: 0; }
}

@media (max-width: 640px) {
  .hero__title { font-size: clamp(2rem, 10vw, 3.2rem); }
  .hero__ctas { flex-direction: column; align-items: flex-start; }
}
@media (prefers-reduced-motion: reduce) {
  .hero__media img { animation: none; }
  .hero__scroll { display: none; }
}

/* ═══════════════════════════════════════════
   §3.5  FEATURES（4つの学びの柱）
═══════════════════════════════════════════ */
.features-sec .sec__inner { max-width: 82rem; }
.sec--linen { background: #f7f4ef; }

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2.4rem;
}
.feature-card {
  border-top: 1px solid rgba(166,138,109,.35);
  padding-top: 1.6rem;
}
.feature-num {
  font-family: var(--font-ui, sans-serif);
  font-size: 2.4rem; letter-spacing: .04em;
  color: var(--gold); opacity: .45;
  display: block; margin-bottom: .5rem;
  line-height: 1;
}
.feature-title {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.98rem, 1.3vw, 1.1rem); font-weight: 400;
  color: var(--ink); margin: 0 0 .75rem; letter-spacing: .04em;
}
.feature-body {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.82rem, 1vw, .9rem); font-weight: 300;
  color: var(--sub); line-height: 1.95;
}

/* ═══════════════════════════════════════════
   §3.8  GALLERY ハードコード
═══════════════════════════════════════════ */
.hc-gallery-sec .sec__inner { max-width: 90rem; }

.hc-gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}
.hc-gallery-item {
  position: relative;
  aspect-ratio: 4/3;
  overflow: hidden;
  border-radius: calc(var(--r) * .6);
}
.hc-gallery-item img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 1s cubic-bezier(.16,1,.3,1);
}
.hc-gallery-item:hover img { transform: scale(1.06); }
.hc-gallery-cap {
  position: absolute; inset: 0;
  display: flex; align-items: flex-end;
  padding: 1.2rem;
  background: linear-gradient(to top, rgba(10,8,4,.75) 0%, transparent 60%);
  opacity: 0; transition: opacity .28s;
}
.hc-gallery-item:hover .hc-gallery-cap { opacity: 1; }
.hc-gallery-cap span {
  font-family: var(--font-jp, sans-serif);
  font-size: .78rem; font-weight: 300;
  color: rgba(248,243,236,.88); line-height: 1.6;
  letter-spacing: .04em;
}

@media (max-width: 760px) {
  .hc-gallery-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 480px) {
  .hc-gallery-grid { grid-template-columns: 1fr; }
  .features-grid { grid-template-columns: 1fr; }
}

/* ═══════════════════════════════════════════
   §2  TARGET（こんな方へ）
═══════════════════════════════════════════ */
.target-sec .sec__inner { max-width: 74rem; }

/* ═══════════════════════════════════════════
   §4  GALLERY
═══════════════════════════════════════════ */
.gallery-sec .sec__inner { max-width: 90rem; }

.gallery {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: 200px;
  gap: .6rem;
}
/* 5パターンのタイル形状を繰り返す */
.gallery__item { overflow: hidden; border-radius: calc(var(--r) * 0.6); }
.gallery__item--1 { grid-column: span 5; grid-row: span 2; }
.gallery__item--2 { grid-column: span 4; grid-row: span 1; }
.gallery__item--3 { grid-column: span 3; grid-row: span 2; }
.gallery__item--4 { grid-column: span 4; grid-row: span 1; }
.gallery__item--5 { grid-column: span 7; grid-row: span 2; }

.gallery__item img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 1s cubic-bezier(.16,1,.3,1);
}
.gallery__item:hover img { transform: scale(1.06); }
.gallery__item figcaption { display: none; }

/* ═══════════════════════════════════════════
   §5  CURRICULUM カードリスト
═══════════════════════════════════════════ */
.curr-sec .sec__inner { max-width: 82rem; }

.curr-list {
  list-style: none; padding: 0; margin: 0;
  display: flex; flex-direction: column; gap: 3rem;
}

/* カード全体 */
.curr-card {
  display: grid;
  grid-template-columns: 38% 1fr;
  border: 1px solid var(--line);
  border-radius: var(--r);
  overflow: hidden;
  background: #fff;
  box-shadow: 0 4px 28px rgba(26,25,23,.06);
  transition: box-shadow .4s;
}
.curr-card:hover { box-shadow: 0 10px 48px rgba(26,25,23,.11); }

/* 左：画像エリア */
.curr-card__img-wrap {
  position: relative; overflow: hidden;
  background: #e8ddd2;
  /* グリッド左列として高さを親に合わせる */
  min-height: 340px;
}
.curr-card__img {
  /* ラッパーいっぱいに引き伸ばす */
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
  transition: transform 1.4s cubic-bezier(.16,1,.3,1);
}
.curr-card:hover .curr-card__img { transform: scale(1.06); }

.curr-card__img-placeholder {
  position: absolute; inset: 0;
  background: linear-gradient(145deg, #e8ddd2 0%, #d4c4b0 100%);
}

/* STEPバッジ（画像左上） */
.curr-card__step-badge {
  position: absolute; top: 0; left: 0;
  background: var(--gold);
  padding: .6rem 1.1rem;
  display: flex; flex-direction: column; align-items: center;
  line-height: 1;
}
.curr-card__step-label {
  font-family: var(--font-ui, sans-serif);
  font-size: .48rem; letter-spacing: .28em; text-transform: uppercase;
  color: rgba(10,8,6,.65); margin-bottom: .2rem;
}
.curr-card__step-num {
  font-family: var(--font-ui, sans-serif);
  font-size: 1.35rem; letter-spacing: .04em; font-weight: 400;
  color: #0a0808;
}

/* 右：テキストエリア */
.curr-card__body {
  padding: clamp(1.8rem, 3.5vw, 2.8rem);
  display: flex; flex-direction: column; gap: 1.8rem;
}

.curr-card__head {
  display: flex; align-items: baseline;
  justify-content: space-between; flex-wrap: wrap; gap: .8rem;
  padding-bottom: 1.2rem;
  border-bottom: 1px solid var(--line);
}
.curr-card__title {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.15rem, 2vw, 1.55rem); font-weight: 400;
  letter-spacing: .07em; color: var(--ink); margin: 0;
}
.curr-card__price {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(.9rem, 1.3vw, 1.05rem); letter-spacing: .06em;
  color: var(--gold); margin: 0; white-space: nowrap;
}

/* 学ぶこと / 作るレシピ 2列 */
.curr-card__cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}

.curr-card__col-label {
  display: flex; align-items: center; gap: .5rem;
  font-family: var(--font-ui, sans-serif);
  font-size: .62rem; letter-spacing: .22em; text-transform: uppercase;
  color: var(--muted); margin: 0 0 .85rem;
}
.curr-card__col-label svg { color: var(--gold); flex-shrink: 0; }

/* prose--curr-list: リッチエディタの箇条書き専用（洗練版） */
.prose--curr-list {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.85rem, 1vw, .94rem);
  font-weight: 300; line-height: 1.95; letter-spacing: .03em;
  color: var(--sub);
}
/* ul/ol → カスタム縦リスト */
.prose--curr-list :global(ul),
.prose--curr-list :global(ol) {
  list-style: none; padding: 0; margin: 0;
  display: flex; flex-direction: column; gap: 0;
}
/* li → ゴールド左ボーダー + 上下セパレーター */
.prose--curr-list :global(li) {
  padding: .6rem 0 .6rem 1.2rem;
  position: relative;
  border-bottom: 1px solid rgba(26,25,23,.07);
}
.prose--curr-list :global(li:first-child) {
  border-top: 1px solid rgba(26,25,23,.07);
}
/* ゴールドドット */
.prose--curr-list :global(li)::before {
  content: '';
  position: absolute; left: 0; top: 50%;
  transform: translateY(-50%);
  width: 4px; height: 4px;
  background: var(--gold); border-radius: 50%;
  flex-shrink: 0;
}
/* p が直接来る場合も対応 */
.prose--curr-list :global(p) { margin: 0; }
/* strong/b */
.prose--curr-list :global(strong),
.prose--curr-list :global(b) {
  font-weight: 500; color: #7a5c35;
}

/* ═══════════════════════════════════════════
   ▸ PROSE 共通（リッチエディタ全体）
═══════════════════════════════════════════ */
.prose {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.95rem, 1.2vw, 1.06rem);
  font-weight: 300; line-height: 2.2; letter-spacing: .04em;
  color: var(--sub);
}

/* strong / b → ブランドゴールドブラウン */
.prose :global(strong),
.prose :global(b) {
  font-weight: 600;
  color: #7a5930;
  background: linear-gradient(to right, rgba(166,138,109,.15), rgba(166,138,109,.06));
  padding: .05em .28em;
  border-radius: 3px;
  border-bottom: 1px solid rgba(166,138,109,.3);
}

/* 見出し */
.prose :global(h2) {
  font-size: clamp(1.15rem, 2vw, 1.5rem); font-weight: 400;
  color: var(--ink); letter-spacing: .07em; line-height: 1.55;
  margin: 3.5rem 0 1.2rem;
  padding: 1rem 1.5rem;
  background: linear-gradient(to right, rgba(166,138,109,.1), rgba(166,138,109,.03));
  border-left: 3px solid var(--gold);
}
.prose :global(h3) {
  font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 400;
  color: var(--ink); margin: 2.5rem 0 .85rem; letter-spacing: .04em;
}

.prose :global(p)  { margin: 0 0 1.65em; }
.prose :global(ul),
.prose :global(ol) { padding-left: 1.6em; margin: 0 0 1.65em; }
.prose :global(li) { margin-bottom: .65em; line-height: 2; }
.prose :global(li::marker) { color: var(--gold); }

/* ★ 画像 → 角丸・レスポンシブ・横並び考慮 */
.prose :global(img) {
  display: block; max-width: 100%; height: auto;
  border-radius: var(--r);
  margin: 2em auto;
  box-shadow: 0 6px 28px rgba(26,25,23,.1);
}
.prose :global(figure) {
  margin: 2em 0; display: flex; flex-direction: column; align-items: center;
}
.prose :global(figure img) { margin: 0; }
.prose :global(figcaption) {
  font-size: .74rem; color: var(--muted); margin-top: .55rem;
}
/* 横並び画像（td内） */
.prose :global(table) { width: 100%; border-collapse: collapse; margin: 2em 0; }
.prose :global(td), .prose :global(th) { vertical-align: top; padding: .5rem; }
.prose :global(td img), .prose :global(th img) {
  border-radius: calc(var(--r) * 0.6); margin: .3em 0;
}

/* ターゲットセクション：li → FEATURES カードと同一スタイル */
.prose--target :global(ul) {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2.4rem; margin: 2.4rem 0 0;
  counter-reset: target-counter;
}
.prose--target :global(li) {
  counter-increment: target-counter;
  border-top: 1px solid rgba(166,138,109,.35);
  padding-top: 1.6rem;
  margin: 0;
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.82rem, 1vw, .9rem);
  font-weight: 300;
  color: var(--sub);
  line-height: 1.95;
}
.prose--target :global(li)::before {
  content: counter(target-counter, decimal-leading-zero);
  display: block;
  font-family: var(--font-ui, sans-serif);
  font-size: 2.4rem; letter-spacing: .04em;
  color: var(--gold); opacity: .45;
  margin-bottom: .5rem; line-height: 1;
}
.prose--target :global(li::marker) { content: none; }

/* ═══════════════════════════════════════════
   §6  INSTRUCTOR
═══════════════════════════════════════════ */
.instructor-sec .sec__inner { max-width: 78rem; }
.instructor-sec__layout {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: clamp(3rem, 6vw, 7rem);
  align-items: start;
}

.instructor-sec__img-wrap { position: sticky; top: 5rem; }
.instructor-sec__photo {
  width: 100%; aspect-ratio: 3/4;
  object-fit: cover; object-position: center top;
  display: block; border-radius: 4px;
}

.instructor-sec__body .sec__hd { margin-bottom: 1.5rem; }

.instructor-sec__name-en {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 300; letter-spacing: .12em;
  color: var(--ink); margin: 0;
}
.instructor-sec__name-jp {
  font-family: var(--font-jp, sans-serif);
  font-size: .85rem; font-weight: 300;
  color: var(--muted); margin: .3rem 0 1.4rem;
  letter-spacing: .12em;
}

.instructor-sec__tags {
  display: flex; flex-wrap: wrap; gap: .5rem;
  margin-bottom: 1.8rem;
}
.tag {
  font-family: var(--font-ui, sans-serif);
  font-size: .62rem; letter-spacing: .12em;
  color: var(--gold); border: 1px solid rgba(166,138,109,.3);
  padding: .3em .85em; border-radius: 50px;
}

.instructor-sec__bio {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.9rem, 1.1vw, .98rem); font-weight: 300;
  line-height: 2.1; color: var(--sub); margin-bottom: 1.8rem;
}
.instructor-sec__bio p { margin: 0 0 1.2em; }

.instructor-sec__awards {
  list-style: none; padding: 0; margin: 0;
  display: flex; flex-direction: column; gap: .65rem;
  border-top: 1px solid var(--line); padding-top: 1.6rem;
}
.instructor-sec__awards li {
  font-family: var(--font-jp, sans-serif);
  font-size: .82rem; font-weight: 300;
  color: var(--muted); padding-left: 1.4rem; position: relative;
}
.instructor-sec__awards li::before {
  content: '—';
  position: absolute; left: 0;
  color: var(--gold); font-size: .65rem;
}

/* ═══════════════════════════════════════════
   §7  VOICES
═══════════════════════════════════════════ */
.voices-sec .sec__inner { max-width: 90rem; }

.voices {
  list-style: none; padding: 0; margin: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.voice {
  background: rgba(240,236,230,.04);
  border: 1px solid rgba(240,236,230,.09);
  padding: 2.2rem;
  display: flex; flex-direction: column; gap: 1.4rem;
  border-radius: calc(var(--r) * 0.5);
  transition: background .3s;
}
.voice:hover { background: rgba(240,236,230,.07); }

.voice__stars {
  font-size: .85rem; color: var(--gold); letter-spacing: .05em;
}
.voice__body {
  margin: 0; flex: 1;
}
.voice__body p {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.85rem, 1vw, .94rem); font-weight: 300;
  line-height: 2.05; color: rgba(240,236,230,.68);
  margin: 0;
}

.voice__footer {}
.voice__name {
  font-family: var(--font-jp, sans-serif);
  font-size: .88rem; font-weight: 400;
  color: rgba(240,236,230,.82); margin: 0;
}
.voice__attr {
  font-family: var(--font-ui, sans-serif);
  font-size: .62rem; letter-spacing: .1em;
  color: rgba(240,236,230,.32); margin: .3rem 0 0;
}

/* ═══════════════════════════════════════════
   §7.5  ASSOCIATION
═══════════════════════════════════════════ */
.assoc-sec { background: #fff; }
.assoc-inner {
  max-width: 80rem;
  display: grid; grid-template-columns: 1fr 1fr;
  gap: clamp(3rem, 6vw, 7rem); align-items: center;
}
.assoc-text .sec__hd { margin-bottom: 1.6rem; }
.assoc-lead {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.92rem, 1.2vw, 1.02rem); font-weight: 300;
  line-height: 2.1; letter-spacing: .04em;
  color: var(--sub); margin: 0 0 2rem;
}
.assoc-marks {
  list-style: none; padding: 0;
  display: flex; flex-direction: column; gap: .6rem; margin: 0 0 1.4rem;
}
.assoc-marks li {
  display: flex; align-items: center; gap: .6rem;
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.88rem, 1.1vw, .96rem); font-weight: 300;
  color: var(--ink);
}
.assoc-mark__reg {
  font-family: var(--font-ui, sans-serif);
  font-size: .62rem; background: var(--gold); color: #fff;
  padding: .12em .45em; border-radius: 2px; flex-shrink: 0;
  letter-spacing: .04em;
}
.assoc-note {
  font-family: var(--font-jp, sans-serif);
  font-size: .78rem; font-weight: 300; line-height: 1.85;
  color: var(--muted);
}
.assoc-img { border-radius: 4px; overflow: hidden; }
.assoc-img img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 4/3; }

/* ═══════════════════════════════════════════
   §7.6  ROADMAP
═══════════════════════════════════════════ */
.roadmap-sec { background: #f7f4ef; }
.roadmap-sec .sec__inner { max-width: 84rem; }
.roadmap {
  display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
  gap: 0; align-items: start;
  margin: clamp(3rem, 5vw, 4.5rem) 0 0;
}
.roadmap__item {
  background: #fff;
  border: 1px solid rgba(166,138,109,.18);
  border-top: 3px solid var(--gold);
  border-radius: 0 0 6px 6px;
  padding: clamp(1.4rem, 2.5vw, 2rem) clamp(1.2rem, 2vw, 1.6rem);
  display: flex; flex-direction: column; gap: .9rem;
  box-shadow: 0 2px 16px rgba(26,25,23,.04);
  height: 100%;
}
.roadmap__item--pro {
  background: linear-gradient(160deg, #fff 0%, #fdf9f3 100%);
  border-top-color: #c9a87a;
}
.roadmap__arrow {
  display: flex; align-items: flex-start; padding-top: 2.2rem;
  color: rgba(166,138,109,.45); flex-shrink: 0;
}
.roadmap__badge {
  font-family: var(--font-ui, sans-serif);
  font-size: .58rem; letter-spacing: .2em; text-transform: uppercase;
  color: #fff; background: var(--gold);
  padding: .25em .8em; border-radius: 2em; display: inline-block;
  align-self: flex-start;
}
.roadmap__badge--mid { background: #4a6fa5; }
.roadmap__badge--adv { background: #7a4a3d; }
.roadmap__badge--pro { background: #5c3d1e; }
.roadmap__step {
  font-family: var(--font-ui, sans-serif);
  font-size: .6rem; letter-spacing: .22em; text-transform: uppercase;
  color: var(--gold); margin: 0;
}
.roadmap__name {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.88rem, 1.2vw, 1rem); font-weight: 400;
  color: var(--ink); margin: 0; line-height: 1.5;
}
.roadmap__price {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(.92rem, 1.3vw, 1.05rem); font-weight: 600;
  color: var(--ink); margin: 0; font-variant-numeric: tabular-nums;
}
.roadmap__price span { font-size: .72em; font-weight: 300; color: var(--muted); margin-left: .2em; }
.roadmap__desc {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.74rem, .9vw, .82rem); font-weight: 300;
  color: var(--sub); line-height: 1.85; margin: 0;
}

/* ═══════════════════════════════════════════
   §10.5  JUNIOR
═══════════════════════════════════════════ */
.junior-sec { background: #fff; }
.junior-inner { max-width: 80rem; }
.junior-hd { max-width: 56rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
.junior-hd .sec__title { margin-bottom: .6rem; }
.junior-price-badge {
