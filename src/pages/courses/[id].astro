---
import Layout from '../../layouts/Layout.astro';
import { getCourseList, getCourse } from '../../lib/microcms';

export async function getStaticPaths() {
  const list = await getCourseList();
  return list.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const c = await getCourse(id!);
if (!c) return Astro.redirect('/listofcourses');
---

<Layout title={c.title} description={c.subtitle ?? c.title} ogImage={c.main_image?.url}>
<main class="lp">

<!-- ════════════════════════════════
  1. HERO
════════════════════════════════ -->
<section class="hero">
  {c.main_image
    ? <img class="hero__bg"
        src={`${c.main_image.url}?w=1920&q=85`}
        alt=""
        width={c.main_image.width}
        height={c.main_image.height}
        fetchpriority="high"
        decoding="async" />
    : <div class="hero__bg hero__bg--fallback" aria-hidden="true"></div>
  }
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__inner">
    <p class="hero__eyebrow">COURSE</p>
    <h1 class="hero__title">{c.title}</h1>
    {c.subtitle && <p class="hero__sub">{c.subtitle}</p>}
    <div class="hero__actions">
      <a href="#form" class="btn btn--gold">今すぐ申し込む</a>
      <a href="#curriculum" class="btn btn--ghost">カリキュラムを見る</a>
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true"><span></span></div>
</section>

<!-- ════════════════════════════════
  2. TARGET（こんな方へ）
════════════════════════════════ -->
{c.target && (
<section class="target">
  <div class="target__inner">
    <header class="sec-header sec-header--center">
      <p class="eyebrow eyebrow--warm">FOR YOU</p>
      <h2 class="sec-title sec-title--dark">こんな方へ</h2>
      <p class="sec-lead">あなたの「学びたい」に、この講座は応えます。</p>
    </header>
    <div class="target__prose prose prose--target" set:html={c.target} />
  </div>
</section>
)}

<!-- ════════════════════════════════
  3. DESCRIPTION（講座について）
════════════════════════════════ -->
{c.description && (
<section class="desc">
  <div class="desc__inner">
    <div class="desc__layout">
      <header class="sec-header">
        <p class="eyebrow">ABOUT</p>
        <h2 class="sec-title">講座について</h2>
      </header>
      <div class="prose prose--light" set:html={c.description} />
    </div>
  </div>
</section>
)}

<!-- ════════════════════════════════
  4. CURRICULUM
════════════════════════════════ -->
{c.curriculum && (
<section class="curr" id="curriculum">
  <div class="curr__inner">
    <header class="sec-header">
      <p class="eyebrow eyebrow--warm">CURRICULUM</p>
      <h2 class="sec-title sec-title--dark">カリキュラム</h2>
    </header>
    <div class="prose prose--curr" set:html={c.curriculum} />
  </div>
</section>
)}

<!-- ════════════════════════════════
  5. ROADMAP（共通・ハードコード）
════════════════════════════════ -->
<section class="road">
  <div class="road__inner">
    <header class="sec-header sec-header--center">
      <p class="eyebrow eyebrow--dim">STEP UP</p>
      <h2 class="sec-title sec-title--light">資格取得までのロードマップ</h2>
      <p class="road__sub">基礎から着実に積み上げ、協会認定プロへ。</p>
    </header>

    <ol class="road__list">
      <li class="road__item">
        <div class="road__num">01</div>
        <div class="road__body">
          <p class="road__tag">BASIC</p>
          <p class="road__name">初級講座</p>
          <p class="road__desc">ローフード・発酵の基礎理論、素材の知識、基本レシピを体系的に習得します。</p>
        </div>
      </li>
      <li class="road__item">
        <div class="road__num">02</div>
        <div class="road__body">
          <p class="road__tag">INTERMEDIATE</p>
          <p class="road__name">中級講座</p>
          <p class="road__desc">応用技術・食材の組み合わせ・商品化レベルのデザイン性を身につけます。</p>
        </div>
      </li>
      <li class="road__item">
        <div class="road__num">03</div>
        <div class="road__body">
          <p class="road__tag">ADVANCE</p>
          <p class="road__name">上級講座</p>
          <p class="road__desc">独自レシピ開発・ブランディング・他者への指導力まで磨き上げます。</p>
        </div>
      </li>
      <li class="road__item road__item--goal">
        <div class="road__num road__num--cert">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <circle cx="12" cy="8" r="6"/><path d="M8.2 14.3 7 22l5-3 5 3-1.2-7.7"/>
          </svg>
        </div>
        <div class="road__body">
          <p class="road__tag">CERTIFICATE</p>
          <p class="road__name">認定資格取得</p>
          <p class="road__desc">ローショコラティエ協会認定プロとして、教室開業・販売・講師活動が可能に。</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- ════════════════════════════════
  6. INFO（開催情報 & 料金）
════════════════════════════════ -->
{(c.schedule || c.price) && (
<section class="info">
  <div class="info__inner">
    <header class="sec-header sec-header--center">
      <p class="eyebrow eyebrow--warm">INFO</p>
      <h2 class="sec-title sec-title--dark">開催情報 & 料金</h2>
    </header>

    <div class="info__grid">
      {c.schedule && (
        <div class="info__card">
          <div class="info__card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <p class="info__card-label">開催日程</p>
          <p class="info__card-val">{c.schedule}</p>
        </div>
      )}
      {c.price && (
        <div class="info__card info__card--price">
          <div class="info__card-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
              <line x1="12" y1="1" x2="12" y2="23"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <p class="info__card-label">受講料金</p>
          <p class="info__card-price">{c.price}</p>
          <p class="info__card-note">
            ※お支払いはクレジットカード決済もしくはお振込のみとなります。<br />
            （分割払いは対応しておりません）
          </p>
        </div>
      )}
    </div>

    <div class="info__cta">
      <a href="#form" class="btn btn--gold btn--lg">このコースに申し込む</a>
    </div>
  </div>
</section>
)}

<!-- ════════════════════════════════
  7. FAQ（アコーディオン）
════════════════════════════════ -->
{c.faq && (
<section class="faq">
  <div class="faq__inner">
    <header class="sec-header sec-header--center">
      <p class="eyebrow eyebrow--warm">FAQ</p>
      <h2 class="sec-title sec-title--dark">よくあるご質問</h2>
    </header>
    <div class="faq__source" aria-hidden="true" style="display:none" set:html={c.faq} />
    <dl class="faq__list" id="faqList"></dl>
  </div>
</section>
)}

<!-- ════════════════════════════════
  8. FORM（お申し込み）
════════════════════════════════ -->
<section class="form-sec" id="form">
  <div class="form-sec__inner">
    <header class="sec-header sec-header--center">
      <p class="eyebrow eyebrow--dim">APPLY</p>
      <h2 class="sec-title sec-title--light">お申し込み・お問い合わせ</h2>
      <p class="form-sec__lead">
        下記フォームよりご連絡ください。<br />
        2営業日以内にご返信いたします。
      </p>
    </header>

    <form
      class="form-sec__form"
      name={`course-apply-${c.id}`}
      method="POST"
      data-netlify="true"
      novalidate
    >
      <input type="hidden" name="form-name" value={`course-apply-${c.id}`} />
      <input type="hidden" name="course" value={c.title} />

      <div class="form-sec__row">
        <div class="form-sec__field">
          <label class="form-sec__label" for="f-name">
            お名前 <span class="req">必須</span>
          </label>
          <input class="form-sec__input" type="text" id="f-name" name="name"
            placeholder="安藤 千英" autocomplete="name" required />
        </div>
        <div class="form-sec__field">
          <label class="form-sec__label" for="f-kana">フリガナ</label>
          <input class="form-sec__input" type="text" id="f-kana" name="kana"
            placeholder="アンドウ チエ" />
        </div>
      </div>

      <div class="form-sec__row">
        <div class="form-sec__field">
          <label class="form-sec__label" for="f-email">
            メールアドレス <span class="req">必須</span>
          </label>
          <input class="form-sec__input" type="email" id="f-email" name="email"
            placeholder="your@email.com" autocomplete="email" required />
        </div>
        <div class="form-sec__field">
          <label class="form-sec__label" for="f-tel">電話番号</label>
          <input class="form-sec__input" type="tel" id="f-tel" name="tel"
            placeholder="090-0000-0000" autocomplete="tel" />
        </div>
      </div>

      <div class="form-sec__field">
        <label class="form-sec__label" for="f-schedule">ご希望の日程・時期</label>
        <input class="form-sec__input" type="text" id="f-schedule" name="schedule"
          placeholder="例：9月以降の週末を希望" />
      </div>

      <div class="form-sec__field">
        <label class="form-sec__label" for="f-msg">お問い合わせ内容</label>
        <textarea class="form-sec__textarea" id="f-msg" name="message"
          rows="5" placeholder="ご質問・ご要望などをご記入ください。"></textarea>
      </div>

      <div class="form-sec__submit">
        <button class="btn btn--gold btn--lg" type="submit">送信する</button>
        <p class="form-sec__privacy">
          送信いただくことで
          <a href="/privacy" target="_blank" rel="noopener">プライバシーポリシー</a>
          に同意したものとみなします。
        </p>
      </div>
    </form>
  </div>
</section>

</main>
</Layout>

<!-- ════════════════════════════════
  FAQ アコーディオン生成スクリプト
════════════════════════════════ -->
<script>
(function () {
  const src = document.querySelector('.faq__source');
  const list = document.getElementById('faqList');
  if (!src || !list) return;

  const h2s = src.querySelectorAll('h2');
  h2s.forEach((h2, i) => {
    const q = h2.textContent?.trim() ?? '';
    const answerNodes: Node[] = [];
    let sib = h2.nextElementSibling;
    while (sib && sib.tagName !== 'H2') {
      answerNodes.push(sib.cloneNode(true));
      sib = sib.nextElementSibling;
    }

    const dt = document.createElement('dt');
    dt.className = 'faq__q';
    dt.setAttribute('role', 'button');
    dt.setAttribute('tabindex', '0');
    dt.setAttribute('aria-expanded', 'false');
    dt.setAttribute('aria-controls', `faq-ans-${i}`);
    dt.innerHTML = `
      <span class="faq__q-text">${q}</span>
      <span class="faq__q-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </span>`;

    const dd = document.createElement('dd');
    dd.className = 'faq__a';
    dd.id = `faq-ans-${i}`;
    dd.setAttribute('role', 'region');
    dd.setAttribute('hidden', '');
    const inner = document.createElement('div');
    inner.className = 'faq__a-inner';
    answerNodes.forEach(n => inner.appendChild(n));
    dd.appendChild(inner);

    function toggle() {
      const open = dt.getAttribute('aria-expanded') === 'true';
      dt.setAttribute('aria-expanded', String(!open));
      if (open) {
        dd.setAttribute('hidden', '');
      } else {
        dd.removeAttribute('hidden');
      }
    }
    dt.addEventListener('click', toggle);
    dt.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });

    list.appendChild(dt);
    list.appendChild(dd);
  });
})();
</script>

<style>
/* ══════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════ */
.lp {
  --gold:    #a68a6d;
  --gold-lt: #c4a882;
  --gold-bg: rgba(166,138,109,.08);
  --dark:    #141413;
  --ink:     #1a1917;
  --muted:   #6b6560;
  --warm-bg: #f4ede3;
  --off-bg:  #fafaf8;
  --line:    rgba(26,25,23,.1);
  --radius:  0.75rem;
}

/* ══════════════════════════════════════
   SHARED BUTTONS
══════════════════════════════════════ */
.btn {
  display: inline-block;
  font-family: var(--font-ui, sans-serif);
  font-size: .82rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  text-decoration: none;
  padding: 1rem 2.4rem;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background .3s, color .3s, opacity .3s, border-color .3s;
  white-space: nowrap;
}
.btn--gold {
  background: var(--gold);
  color: #0a0808;
  border-color: var(--gold);
}
.btn--gold:hover { opacity: .8; }
.btn--ghost {
  background: transparent;
  color: rgba(240,236,230,.7);
  border-color: rgba(240,236,230,.3);
}
.btn--ghost:hover {
  background: rgba(240,236,230,.08);
  border-color: rgba(240,236,230,.6);
  color: rgba(240,236,230,.95);
}
.btn--lg { padding: 1.2rem 3.2rem; font-size: .88rem; }

/* ══════════════════════════════════════
   SHARED SECTION TYPOGRAPHY
══════════════════════════════════════ */
.sec-header { margin-bottom: clamp(3rem, 5vw, 5rem); }
.sec-header--center { text-align: center; }

.eyebrow {
  font-family: var(--font-ui, sans-serif);
  font-size: .62rem;
  letter-spacing: .38em;
  text-transform: uppercase;
  margin: 0 0 .9rem;
  display: block;
}
.eyebrow           { color: var(--gold); }
.eyebrow--warm     { color: #9a7858; }
.eyebrow--dim      { color: rgba(240,236,230,.4); }

.sec-title {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.55rem, 3vw, 2.5rem);
  font-weight: 300;
  letter-spacing: .08em;
  line-height: 1.45;
  margin: 0;
}
.sec-title--dark  { color: var(--ink); }
.sec-title--light { color: rgba(240,236,230,.93); }

.sec-lead {
  font-family: var(--font-jp, sans-serif);
  font-size: .95rem;
  font-weight: 300;
  color: var(--muted);
  margin: 1rem 0 0;
  line-height: 1.9;
}

/* ══════════════════════════════════════
   1. HERO
══════════════════════════════════════ */
.hero {
  position: relative;
  min-height: 100svh;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: var(--dark);
}
.hero__bg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center 30%;
  animation: heroKen 20s cubic-bezier(.16,1,.3,1) forwards;
}
.hero__bg--fallback {
  background: linear-gradient(135deg, #1c1a18 0%, #2e2720 100%);
}
@keyframes heroKen {
  from { transform: scale(1.06); }
  to   { transform: scale(1); }
}
.hero__scrim {
  position: absolute; inset: 0;
  background:
    linear-gradient(to bottom, rgba(14,10,8,.25) 0%, rgba(14,10,8,.55) 60%, rgba(14,10,8,.78) 100%),
    linear-gradient(to right,  rgba(14,10,8,.75) 0%, rgba(14,10,8,.35) 55%, transparent 100%);
}
.hero__inner {
  position: relative; z-index: 1;
  width: min(100% - 3rem, 80rem);
  padding: clamp(8rem,20vh,16rem) 0 clamp(7rem,14vh,12rem);
  display: flex; flex-direction: column;
  align-items: flex-start; gap: 1.6rem;
}
.hero__eyebrow {
  font-family: var(--font-ui, sans-serif);
  font-size: .6rem; letter-spacing: .38em; text-transform: uppercase;
  color: var(--gold); margin: 0;
}
.hero__title {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(2.1rem, 5.8vw, 5rem);
  font-weight: 300; line-height: 1.38; letter-spacing: .07em;
  color: #f2ede7; margin: 0; max-width: 17em;
  text-shadow: 0 4px 50px rgba(0,0,0,.4);
}
.hero__sub {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.98rem, 1.6vw, 1.3rem);
  font-weight: 300; line-height: 1.9; letter-spacing: .05em;
  color: rgba(240,236,230,.65); margin: 0; max-width: 30em;
}
.hero__actions {
  display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .5rem;
}
.hero__scroll {
  position: absolute; left: 50%; bottom: 2.2rem;
  transform: translateX(-50%);
}
.hero__scroll span {
  display: block; width: 1px; height: 4rem;
  background: linear-gradient(to bottom, transparent 0%, rgba(166,138,109,.75) 100%);
  animation: scrollCue 2.6s ease-in-out infinite;
  transform-origin: top;
}
@keyframes scrollCue {
  0%   { transform: scaleY(0); opacity: 0; }
  35%  { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(1); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .hero__bg { animation: none; }
  .hero__scroll { display: none; }
}

/* ══════════════════════════════════════
   2. TARGET
══════════════════════════════════════ */
.target {
  background: var(--warm-bg);
  padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 5rem);
}
.target__inner { width: min(100%, 74rem); margin: 0 auto; }

/* li → カード型 */
.prose--target :global(ul) {
  list-style: none;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1.2rem;
  margin: 0;
}
.prose--target :global(li) {
  background: #fff;
  border: 1px solid rgba(154,120,88,.15);
  border-left: 3px solid var(--gold);
  border-radius: 0 var(--radius) var(--radius) 0;
  padding: 1.4rem 1.6rem;
  font-family: var(--font-jp, sans-serif);
  font-size: .95rem; font-weight: 300; line-height: 1.85;
  color: #3a3532;
  position: relative;
}
.prose--target :global(li)::before { display: none; }

/* ══════════════════════════════════════
   3. DESCRIPTION
══════════════════════════════════════ */
.desc {
  background: var(--off-bg);
  padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 5rem);
}
.desc__inner { width: min(100%, 74rem); margin: 0 auto; }
.desc__layout { display: flex; flex-direction: column; gap: 0; }

/* ══════════════════════════════════════
   4. CURRICULUM
══════════════════════════════════════ */
.curr {
  background: #f4ede3;
  padding: clamp(5rem, 10vw, 9rem) clamp(1.5rem, 5vw, 5rem);
}
.curr__inner { width: min(100%, 74rem); margin: 0 auto; }

/* ══════════════════════════════════════
   ▸ PROSE（共通リッチエディタ本文）
══════════════════════════════════════ */
.prose {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.93rem, 1.15vw, 1.03rem);
  font-weight: 300; line-height: 2.15; letter-spacing: .04em;
  color: #3a3835;
}
.prose--light { color: #3a3835; }
.prose--curr  { color: #2e2a27; }

/* 見出し */
.prose :global(h2) {
  font-size: clamp(1.15rem, 2vw, 1.55rem); font-weight: 400;
  color: var(--ink); letter-spacing: .07em; line-height: 1.55;
  margin: 3rem 0 1.1rem;
  padding: 1.1rem 1.4rem;
  background: rgba(166,138,109,.07);
  border-left: 3px solid var(--gold);
}
.prose :global(h3) {
  font-size: clamp(1rem, 1.5vw, 1.2rem); font-weight: 400;
  color: var(--ink); letter-spacing: .05em;
  margin: 2.2rem 0 .8rem;
}

/* ★ strong / b → ブランドゴールド */
.prose :global(strong),
.prose :global(b) {
  font-weight: 600;
  color: #8a6840;
  background: rgba(166,138,109,.09);
  padding: .05em .2em;
  border-radius: 2px;
}

/* 段落・リスト */
.prose :global(p)  { margin: 0 0 1.5em; }
.prose :global(ul),
.prose :global(ol) { padding-left: 1.6em; margin: 0 0 1.5em; }
.prose :global(li) { margin-bottom: .6em; line-height: 1.9; }
.prose :global(li::marker) { color: var(--gold); }

/* ★ 画像 → 角丸・レスポンシブ */
.prose :global(img) {
  display: block;
  max-width: 100%; height: auto;
  border-radius: var(--radius);
  margin: 2.2em auto;
  box-shadow: 0 4px 24px rgba(26,25,23,.1);
}
/* 横並び画像対応（figure / div が隣接する場合） */
.prose :global(figure) {
