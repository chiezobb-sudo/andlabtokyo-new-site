---
import Layout from '../../layouts/Layout.astro';
import { getCourseList, getCourse } from '../../lib/microcms';
import type { CurriculumItem } from '../../lib/microcms';

export async function getStaticPaths() {
  const list = await getCourseList();
  return list.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const c = await getCourse(id!);
if (!c) return Astro.redirect('/listofcourses');

const hasGallery = c.gallery && c.gallery.length > 0;
const hasCurriculum = c.curriculum_list && c.curriculum_list.length > 0;

/* ── ハードコード：4つの学びの柱 ── */
const features = [
  {
    num: "01",
    title: "定義から教えます",
    body: "ローチョコレートは「生のカカオ」ではありません。高温焙煎（110〜150℃）をしないカカオを使うことが定義です。「48℃以下」と言えない理由も含め、正確な知識を基礎から学びます。",
  },
  {
    num: "02",
    title: "発酵を知らないと、ローは語れません",
    body: "カカオ豆は発酵段階で豆の温度が50℃を超えます。菌が生きて働いた結果の熱です。この事実を知っていることが、素材を正確に理解する出発点になります。",
  },
  {
    num: "03",
    title: "素材を見分ける目を養います",
    body: "「カカオパウダー」と「ココアパウダー」は別物です。重曹テストで判別できるようになるなど、市販素材を正確に読み解く実践的なスキルを身につけます。",
  },
  {
    num: "04",
    title: "衛生も、正面から学びます",
    body: "カカオは屋外で発酵・乾燥され、完全な無菌状態ではありません。低温殺菌の意味と温度の根拠、リスクと向き合い方を正確に学びます。",
  },
];

/* ── ハードコード：ギャラリー画像 ── */
const galleryImages = [
  { src: "/choco-real/01-beginner-flatlay.jpg",    caption: "カカオポッドから学ぶ、ローチョコレートの基礎" },
  { src: "/choco-real/02-beginner-assorted.jpg",   caption: "初級で習得する多彩な成形テクニック" },
  { src: "/choco-real/03-intermediate-mermaid.jpg",caption: "中級で学ぶマーメイドチョコのアレンジ成形" },
  { src: "/choco-real/04-intermediate-hearts.jpg", caption: "色とりどりに仕上げるハート型ボンボンショコラ" },
  { src: "/choco-real/05-advanced-assorted.jpg",   caption: "上級で極める本格ボンボンショコラの数々" },
  { src: "/choco-real/06-junior-plating.jpg",      caption: "ジュニア講座で学ぶ、お店レベルのプレーティング" },
];
---

<Layout
  title={`${c.title} | 東京・オンライン | ローショコラティエ協会`}
  description={`東京（渋谷・表参道）とオンラインで受講できる${c.title}。${c.subtitle ?? ''}BASIC・INTERMEDIATE・ADVANCEの3ステップで協会認定プロ（ローチョコレートマイスター®）を目指します。`}
  ogImage={c.heroImage?.url}
>

<!-- ── 構造化データ ── -->
<script type="application/ld+json" set:html={JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": c.title,
    "description": c.subtitle ?? c.title,
    "provider": {
      "@type": "EducationalOrganization",
      "name": "ローショコラティエ協会 / &LAB TOKYO",
      "url": "https://andlabtokyo.biz"
    },
    "url": `https://andlabtokyo.biz/courses/${c.id}`,
    "image": c.heroImage?.url,
    "inLanguage": "ja",
    "courseMode": ["onsite", "online"],
    "availableLanguage": "ja",
    "locationCreated": { "@type": "Place", "name": "東京都渋谷区（表参道）" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://andlabtokyo.biz/" },
      { "@type": "ListItem", "position": 2, "name": "講座一覧", "item": "https://andlabtokyo.biz/listofcourses" },
      { "@type": "ListItem", "position": 3, "name": c.title, "item": `https://andlabtokyo.biz/courses/${c.id}` }
    ]
  }
])} />

<main class="lp">

<!-- ════════════════════════════
  §1  HERO — トップページ HeroBlock と同一構造
════════════════════════════ -->
<section class="hero">
  <div class="hero__media">
    {c.heroImage
      ? <img
          src={`${c.heroImage.url}?w=1920&q=85`}
          alt={c.title}
          width={c.heroImage.width}
          height={c.heroImage.height}
          fetchpriority="high"
          decoding="async"
        />
      : <div class="hero__media-fallback"></div>
    }
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__inner">
    <p class="hero__eyebrow">COURSE · &LAB TOKYO</p>
    <h1 class="hero__title">{c.title}</h1>
    {c.subtitle && <p class="hero__sub">{c.subtitle}</p>}
    <div class="hero__ctas">
      <a href="#curriculum" class="hero__cta hero__cta--outline">講座内容を見る</a>
      <a href="#form" class="hero__cta hero__cta--primary">今すぐ申し込む</a>
    </div>
  </div>
  <div class="hero__scroll" aria-hidden="true"><span></span></div>
</section>

<!-- ════════════════════════════
  §2  TARGET — CMS
════════════════════════════ -->
{c.target && (
<section class="sec sec--warm target-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">FOR YOU</p>
      <h2 class="sec__title">こんな方へ</h2>
      <p class="sec__lead">あなたの「学びたい」に、この講座は応えます。</p>
    </header>
    <div class="prose prose--target" set:html={c.target} />
  </div>
</section>
)}

<!-- ════════════════════════════
  §3  DESCRIPTION — CMS
════════════════════════════ -->
{c.description && (
<section class="sec sec--offwhite">
  <div class="sec__inner">
    <header class="sec__hd">
      <p class="eyebrow">ABOUT</p>
      <h2 class="sec__title sec__title--dark">講座について</h2>
    </header>
    <div class="prose prose--desc" set:html={c.description} />
  </div>
</section>
)}

<!-- ════════════════════════════
  §3.5  FEATURES — ハードコード（4つの学びの柱）
════════════════════════════ -->
<section class="sec features-sec">
  <div class="sec__inner">
    <header class="sec__hd">
      <p class="eyebrow eyebrow--warm">FEATURES</p>
      <h2 class="sec__title sec__title--dark">4つの学びの柱</h2>
      <p class="sec__lead sec__lead--dark">「なぜそうなのか」を知っていること——それが、教える力にも、販売する自信にもつながります。</p>
    </header>
    <div class="features-grid">
      {features.map(f => (
        <div class="feature-card">
          <span class="feature-num">{f.num}</span>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-body">{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §3.8  GALLERY — ハードコード（作品写真）
════════════════════════════ -->
<section class="sec sec--linen hc-gallery-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">GALLERY</p>
      <h2 class="sec__title sec__title--dark">講座で作るローチョコレートの世界</h2>
      <p class="sec__lead">初級〜上級まで、実際にレッスンで仕上げる作品の一部をご紹介します。</p>
    </header>
    <div class="hc-gallery-grid">
      {galleryImages.map(g => (
        <div class="hc-gallery-item">
          <img src={g.src} alt={g.caption} loading="lazy" decoding="async" />
          <div class="hc-gallery-cap"><span>{g.caption}</span></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §4  GALLERY — CMS（gallery[]）
════════════════════════════ -->
{hasGallery && (
<section class="sec sec--dark gallery-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--dim">GALLERY</p>
      <h2 class="sec__title sec__title--light">講座で作るローチョコレートの世界</h2>
    </header>
    <div class="gallery">
      {c.gallery!.map((img, i) => (
        <figure class={`gallery__item gallery__item--${(i % 5) + 1}`}>
          <img
            src={`${img.url}?w=900&q=85`}
            alt={`作品 ${i + 1}`}
            width={img.width}
            height={img.height}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
)}

<!-- ════════════════════════════
  §5  CURRICULUM — CMS（curriculum_list 配列カード）
════════════════════════════ -->
{hasCurriculum && (
<section class="sec sec--white curr-sec" id="curriculum">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--warm">CURRICULUM</p>
      <h2 class="sec__title sec__title--dark">
        {c.curriculum_list!.length}ステップで確実に身につくカリキュラム
      </h2>
      <p class="sec__lead sec__lead--dark">基礎から段階を踏んで、プロレベルの知識と技術を習得します。</p>
    </header>

    <ol class="curr-list">
      {c.curriculum_list!.map((item: CurriculumItem, i: number) => (
        <li class="curr-card">
          <!-- カード画像 -->
          <div class="curr-card__img-wrap">
            {item.image
              ? <img
                  class="curr-card__img"
                  src={`${item.image.url}?w=800&q=85`}
                  alt={item.title}
                  width={item.image.width}
                  height={item.image.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              : <div class="curr-card__img-placeholder" aria-hidden="true"></div>
            }
            <div class="curr-card__step-badge">
              <span class="curr-card__step-label">STEP</span>
              <span class="curr-card__step-num">{String(i + 1).padStart(2, '0')}</span>
            </div>
          </div>

          <!-- カード本文 -->
          <div class="curr-card__body">
            <div class="curr-card__head">
              <h3 class="curr-card__title">{item.title}</h3>
              {item.price && (
                <p class="curr-card__price">{item.price}</p>
              )}
            </div>

            <div class="curr-card__cols">
              {item.learnings && (
                <div class="curr-card__col">
                  <p class="curr-card__col-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                    学ぶこと
                  </p>
                  <div class="prose prose--curr-list" set:html={item.learnings} />
                </div>
              )}
              {item.recipes && (
                <div class="curr-card__col">
                  <p class="curr-card__col-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                      <line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/>
                      <line x1="14" y1="1" x2="14" y2="4"/>
                    </svg>
                    作るレシピ
                  </p>
                  <div class="prose prose--curr-list" set:html={item.recipes} />
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
)}

<!-- ════════════════════════════
  §5.5  NEXT STEP — カリキュラムの直後
════════════════════════════ -->
<section class="sec nextstep-sec">
  <div class="sec__inner nextstep-sec__inner">
    <div class="road">
      <header class="sec__hd sec__hd--center">
        <p class="eyebrow eyebrow--warm">STEP UP</p>
        <h2 class="sec__title sec__title--dark">次のステップへ</h2>
        <p class="sec__lead sec__lead--dark">基礎から着実に積み上げ、協会認定プロへ。</p>
      </header>
      <ol class="road__steps">
        <li class="road__step">
          <div class="road__num">01</div>
          <div class="road__body">
            <p class="road__tag">BASIC</p>
            <p class="road__name">初級講座</p>
            <p class="road__desc">基礎理論・素材・基本レシピを体系的に習得</p>
          </div>
        </li>
        <li class="road__step">
          <div class="road__num">02</div>
          <div class="road__body">
            <p class="road__tag">INTERMEDIATE</p>
            <p class="road__name">中級講座</p>
            <p class="road__desc">応用技術・商品化レベルのデザイン性を習得</p>
          </div>
        </li>
        <li class="road__step">
          <div class="road__num">03</div>
          <div class="road__body">
            <p class="road__tag">ADVANCE</p>
            <p class="road__name">上級講座</p>
            <p class="road__desc">独自開発・ブランディング・指導力を習得</p>
          </div>
        </li>
        <li class="road__step road__step--cert">
          <div class="road__num road__num--cert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <circle cx="12" cy="8" r="6"/>
              <path d="M8.2 14.3 7 22l5-3 5 3-1.2-7.7"/>
            </svg>
          </div>
          <div class="road__body">
            <p class="road__tag">PRO</p>
            <p class="road__name">ジュニアローショコラティエ養成講座</p>
            <p class="road__desc">ジュニアローショコラティエ養成講座へ進み、協会認定のプロとして教室開講・販売・講師活動を目指します</p>
          </div>
        </li>
      </ol>
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §5.6  JUNIOR — ジュニアローショコラティエ養成講座
════════════════════════════ -->
<section class="sec junior-sec">
  <div class="sec__inner junior-inner">
    <div class="junior-hd">
      <p class="eyebrow eyebrow--warm">NEXT STEP · PRO COURSE</p>
      <h2 class="sec__title sec__title--dark">さらにステップアップ<br/>ジュニアローショコラティエ養成講座</h2>
      <p class="sec__lead sec__lead--dark">3ステップ講座修了後、<strong>教える・販売する・広める</strong>ためのインストラクター講座へ進めます。</p>
      <p class="junior-price-badge">PRO · 受講料 ¥85,000（税別）</p>
    </div>
    <div class="junior-cards">
      <div class="junior-card">
        <p class="junior-card__title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
          </svg>
          学べること
        </p>
        <ul class="junior-list">
          <li>ローチョコレートの正しい指導法</li>
          <li>レッスン開催・自分ブランドの作り方</li>
          <li>販売の基礎知識（食品表示・価格設定）</li>
          <li>公式テキスト使用OK（講師専用特典）</li>
        </ul>
      </div>
      <div class="junior-card junior-card--benefit">
        <p class="junior-card__title">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          修了後の特典
        </p>
        <ul class="junior-list">
          <li>年会費<strong>無料</strong></li>
          <li>「ローチョコレートマイスター®」公式ロゴ使用OK</li>
          <li>最新版テキスト<strong>無料提供</strong>（追加レシピ掲載）</li>
          <li>レシピの<strong>商用利用OK</strong></li>
          <li>SNS集客バックアップ</li>
        </ul>
      </div>
    </div>
    <p class="junior-note">
      ※ 受講条件：3ステップ講座の修了者　／　受講期間：1〜3ヶ月　／　開催形式：オンラインまたは対面<br/>
      ※ 特典は当スクールの理念に基づいた指導を行い、規定の条件を満たす場合に受けることができます。
    </p>
    <div class="junior-cta">
      <a href="#form" class="btn btn--gold btn--lg">プロコースについて問い合わせる</a>
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §6  INSTRUCTOR — ハードコード（共通）
════════════════════════════ -->
<section class="sec sec--warm instructor-sec">
  <div class="sec__inner instructor-sec__layout">
    <div class="instructor-sec__img-wrap">
      <img
        class="instructor-sec__photo"
        src="/images/chie-ando-instructor.jpg"
        alt="安藤千英 — &LAB TOKYO 主宰・食と哲学のプロデューサー"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="instructor-sec__body">
      <header class="sec__hd">
        <p class="eyebrow eyebrow--warm">INSTRUCTOR</p>
        <h2 class="sec__title sec__title--dark">講師紹介</h2>
      </header>
      <p class="instructor-sec__name-en">Chie Ando</p>
      <p class="instructor-sec__name-jp">安藤 千英</p>
      <p class="instructor-sec__tags">
        <span class="tag">ELLE gourmet 認定料理家</span>
        <span class="tag">&LAB TOKYO 主宰</span>
        <span class="tag">食と哲学のプロデューサー</span>
      </p>
      <div class="instructor-sec__bio">
        <p>ローチョコレート・ロースイーツ・発酵料理の専門家。ELLE gourmet認定料理家として、食と哲学を融合させたユニークなアプローチで、食の本質と身体への深い理解を伝えています。</p>
        <p>ローショコラティエ協会主宰として、ローチョコレートマイスター®・ローショコラティエ®・ローパティシエ®・発酵創家®の各認定資格を監修。1,000名以上の受講生を輩出し、その哲学は国内外で支持されています。</p>
      </div>
      <ul class="instructor-sec__awards">
        <li>ローチョコレートマイスター® 登録商標取得</li>
        <li>ローショコラティエ® 登録商標取得</li>
        <li>発酵創家® 登録商標取得</li>
        <li>NHK・雑誌・ウェブメディア多数掲載</li>
      </ul>
    </div>
  </div>
</section>

<!-- ════════════════════════════
  §7  VOICES — ハードコード（共通）
════════════════════════════ -->
<section class="sec sec--dark voices-sec">
  <div class="sec__inner">
    <header class="sec__hd sec__hd--center">
      <p class="eyebrow eyebrow--dim">VOICES</p>
      <h2 class="sec__title sec__title--light">生徒さんの声</h2>
    </header>
    <ul class="voices" role="list">
      <li class="voice">
        <div class="voice__stars" aria-label="評価5">★★★★★</div>
        <blockquote class="voice__body">
          <p>チョコレートがこんなに奥深いものだと知らなかった。安藤先生の哲学的な視点から食を学ぶことで、料理への向き合い方が根本から変わりました。認定を取得してから自分のアトリエを開くことができ、今では毎月満席です。</p>
        </blockquote>
        <footer class="voice__footer">
          <p class="voice__name">K.M. さん</p>
          <p class="voice__attr">ローチョコレートマイスター® 取得／東京都</p>
        </footer>
      </li>
      <li class="voice">
        <div class="voice__stars" aria-label="評価5">★★★★★</div>
        <blockquote class="voice__body">
          <p>食と身体の繋がりを科学的かつ哲学的に学べる唯一無二の講座。素材選びから発酵の仕組みまで、「なぜ」を徹底的に教えてくれるので、応用が効く本物の知識が身につきます。仕事にする自信がつきました。</p>
        </blockquote>
        <footer class="voice__footer">
          <p class="voice__name">A.T. さん</p>
          <p class="voice__attr">発酵創家® 取得／神奈川県</p>
        </footer>
      </li>
      <li class="voice">
        <div class="voice__stars" aria-label="評価5">★★★★★</div>
        <blockquote class="voice__body">
