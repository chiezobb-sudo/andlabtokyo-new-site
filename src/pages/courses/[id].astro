  color: var(--ink); margin: 2rem 0 .75rem;
}

.prose :global(p)  { margin: 0 0 1.5em; }
.prose :global(ul),
.prose :global(ol) { padding-left: 1.7em; margin: 0 0 1.5em; }
.prose :global(li) { margin-bottom: .55em; }
.prose :global(li::marker) { color: var(--gold); }

/* ★ 画像 → 角丸・レスポンシブ・横並び考慮 */
.prose :global(img) {
  display: block; max-width: 100%; height: auto;
  border-radius: var(--r);
  margin: 2em auto;
  box-shadow: 0 6px 28px rgba(26,25,23,.1);
