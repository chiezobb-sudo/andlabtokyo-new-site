---
/**
 * お問い合わせ（総合窓口）
 *
 * 位置づけ（2026-09-04・Chie と確認）:
 *   各講座ページのフォーム = 「その講座に決めている人」の申し込み口
 *   このページ            = 「まだ決めていない人」と「取材・企業・書籍」の総合窓口
 *   フォームが複数あること自体は正しい。役割が違うので統合しない。
 *
 * Wix 版（/contact）にあった問題をここで潰している:
 *   - ご住所が必須だった（レッスンの問い合わせに住所は要らない・最大の離脱要因）
 *   - 電話番号が必須だった（海外からの問い合わせが実際に来ている）
 *   - お問い合わせ種別が「任意」で、受信箱で仕分けできなかった → 先頭・必須にした
 *   - 「お名前（性）」の誤字 → （姓）
 *   - 迷子の白文字リンク2つが本文に重なっていた → 持ち込まない
 *
 * 種別を先頭に置いているのは、通知メールの冒頭に用件が出るようにするため。
 */
import Layout from '../layouts/Layout.astro';
import FormGate from '../components/FormGate.astro';
import '../styles/course.css';

const url = 'https://www.andlabtokyo.com/contact';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${url}#page`,
      name: 'お問い合わせ',
      url,
      inLanguage: 'ja',
      about: { '@id': 'https://www.andlabtokyo.com/#org' },
    },
    {
      '@type': 'EducationalOrganization',
      '@id': 'https://www.andlabtokyo.com/#org',
      name: '&LAB TOKYO',
      url: 'https://www.andlabtokyo.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '神宮前',
        addressLocality: '渋谷区',
        addressRegion: '東京都',
        addressCountry: 'JP',
      },
      availableLanguage: ['ja', 'en'],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://www.andlabtokyo.com/' },
        { '@type': 'ListItem', position: 2, name: 'お問い合わせ' },
      ],
    },
  ],
};
---
<Layout
  title="お問い合わせ｜ローフード・発酵・ローチョコレート講座 | &LAB TOKYO"
  description="&LAB TOKYO へのお問い合わせ窓口です。講座のご相談、体験レッスンのご予約、企業コラボ・商品監修、取材・メディア、書籍に関するご相談はこちらから。東京・渋谷（神宮前）。3営業日以内にご返信します。"
  canonical={url}
  ogImage="/images/contact/hero.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="hero hero--short">
    <img src="/images/contact/hero.jpg" alt="エディブルフラワーを添えたローフードのサラダ" width="1800" height="719" fetchpriority="high" />
    <div class="hero-veil"></div>
    <div class="hero-body">
      <span class="eyebrow eyebrow--light">CONTACT</span>
      <h1>お問い合わせ</h1>
      <p class="hero-lead">講座のご相談から、取材・企業のご依頼まで。どのご用件もこのページから承ります。</p>
    </div>
  </section>

  <section class="sec sec--linen">
    <div class="inner">
      <header class="sec-head">
        <span class="eyebrow">WHERE TO START</span>
        <h2>ご用件に合わせて、3つの入口があります</h2>
        <p class="sec-lead">受けたい講座が決まっている方は、その講座のページからお申し込みいただくのが一番早く進みます。迷っている段階の方と、お仕事のご相談は、このページの窓口へどうぞ。</p>
      </header>
      <div class="routes">
        <a class="route" href="/alllesson">
          <span class="route-en">01 — APPLY</span>
          <h3>受ける講座が決まっている</h3>
          <p>各講座ページに、その講座専用のお申し込みフォームがあります。日程や受講形式まで一度で伝わるので、やりとりが少なく済みます。</p>
          <span class="route-more">全講座一覧から探す →</span>
        </a>
        <a class="route" href="/experiencelessons">
          <span class="route-en">02 — TRY FIRST</span>
          <h3>まず一度、体験したい</h3>
          <p>一回完結の体験レッスンをご用意しています。持ち物は不要、はじめての方が対象です。</p>
          <span class="route-more">体験レッスンを見る →</span>
        </a>
        <div class="route route--here">
          <span class="route-en">03 — ASK</span>
          <h3>相談したい・お仕事の依頼</h3>
          <p>どの講座が合うか分からない方、企業コラボ・商品監修、取材、書籍についてのご相談は、下のフォームからお願いします。</p>
          <span class="route-more">↓ このページのフォームへ</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--cream" id="form">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">CONTACT FORM</span>
        <h2>お問い合わせフォーム</h2>
        <p class="sec-lead">3営業日以内にご返信します。入会費・登録費はありません。</p>
      </header>

      <FormGate
        subject="【&LAB TOKYO】お問い合わせ（総合窓口）"
        mailBody={'ご用件：\nお名前：\nメールアドレス：\nお電話番号（任意）：\nご興味のある分野：\nお問い合わせ内容：\n'}
        class="form-grid"
      >
        <label class="full">ご用件<span>*</span>
          <select name="subject_type" required>
            <option value="">選択してください</option>
            <option>講座について相談したい</option>
            <option>体験レッスンを予約したい</option>
            <option>企業コラボ・商品監修のご依頼</option>
            <option>取材・メディアのご依頼</option>
            <option>書籍について</option>
            <option>その他</option>
          </select>
        </label>

        <label>お名前<span>*</span><input type="text" name="name" required placeholder="山田 花子" /></label>
        <label>メールアドレス<span>*</span><input type="email" name="email" required placeholder="example@email.com" /></label>
        <label>お電話番号（任意）<input type="tel" name="tel" placeholder="090-0000-0000" /></label>
        <label>会社名・団体名（任意）<input type="text" name="company" /></label>

        <label class="full">ご興味のある分野（任意・いくつでも）
          <div class="choice-grid">
            <label class="choice"><input type="checkbox" name="field" value="ローフード" />ローフード</label>
            <label class="choice"><input type="checkbox" name="field" value="発酵・麹" />発酵・麹</label>
            <label class="choice"><input type="checkbox" name="field" value="ロースイーツ・ローチョコレート" />ロースイーツ・ローチョコレート</label>
            <label class="choice"><input type="checkbox" name="field" value="UMAMI &amp; KOJI LAB（英語）" />UMAMI &amp; KOJI LAB（英語）</label>
          </div>
        </label>

        <label>ご希望の受講形式（任意）
          <select name="mode">
            <option value="">選択してください</option>
            <option>対面（東京・神宮前）</option>
            <option>オンライン</option>
            <option>どちらでも可</option>
          </select>
        </label>
        <label>ご希望の日程（任意）<input type="text" name="date1" placeholder="例：10月中旬の平日" /></label>

        <label class="full">お問い合わせ内容<span>*</span>
          <textarea name="message" rows="6" required placeholder="ご質問、ご希望の日程、アレルギーなど、お書き添えください。"></textarea>
        </label>

        <label class="full consent">
          <input type="checkbox" name="privacy" required />
          <span><a href="/privacypolicy">個人情報の取り扱い</a>に同意します。いただいた情報は、お問い合わせへのご返信にのみ使用します。</span>
        </label>

        <button type="submit" class="btn btn--solid">送信する</button>
      </FormGate>

      <p class="note">送信後、自動返信は行っていません。3営業日を過ぎても返信が届かない場合は、迷惑メールフォルダをご確認ください。届いていないことがありますので、そのときはお手数ですが、もう一度このフォームからお送りください。</p>
    </div>
  </section>

  <section class="sec sec--linen">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">FOR INTERNATIONAL GUESTS</span>
        <h2>In English</h2>
      </header>
      <div class="en-note">
        <h3>You can write to us in English.</h3>
        <p>Please use the form above — it reaches us the same way. Tell us your preferred dates and the number of guests, and we will reply within three business days.</p>
        <p>Our koji fermentation experience runs in English: <a href="/koji-fermentation-experience-tokyo">UMAMI &amp; KOJI LAB</a>.</p>
      </div>
    </div>
  </section>

  <section class="sec sec--cream">
    <div class="inner inner--narrow">
      <header class="sec-head">
        <span class="eyebrow">ACCESS</span>
        <h2>教室について</h2>
      </header>
      <table class="spec">
        <tbody>
          <tr><th scope="row">教室</th><td>&LAB TOKYO（ローフード発酵LAB東京／ローショコラティエ協会 本部）</td></tr>
          <tr><th scope="row">場所</th><td>東京都渋谷区神宮前<br />表参道・青山・千駄ヶ谷からもアクセスできます。詳しい会場はお申し込み後にご案内します。</td></tr>
          <tr><th scope="row">クラス</th><td>少人数制</td></tr>
          <tr><th scope="row">対応言語</th><td>日本語／英語（UMAMI &amp; KOJI LAB は英語で開催）</td></tr>
          <tr><th scope="row">返信</th><td>3営業日以内</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <style is:global>
    body { background: #FAF9F6; }
  </style>
</Layout>
