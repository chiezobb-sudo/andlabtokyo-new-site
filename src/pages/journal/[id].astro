---
import Layout from '../../layouts/Layout.astro';
import { getJournalList, getJournal } from '../../lib/microcms';
import { buildToc, injectHeadingIds } from '../../lib/toc';

export async function getStaticPaths() {
  const list = await getJournalList();
  return list.map((a) => ({ params: { id: a.id } }));
}

const { id } = Astro.params;
const a = await getJournal(id!);
const toc = buildToc(a.content);
const bodyWithIds = injectHeadingIds(a.content);

function fmtDate(iso: string) {
  const d = new Date(iso);
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
}
---

<Layout
  title={a.title}
  description={a.title}
  ogImage={a.thumbnail?.url}
>
  <main>

    <!-- ── ヒーロー ── -->
    <header class="hero">
      <div class="hero__media">
        {a.thumbnail
          ? <img
              src={`${a.thumbnail.url}?w=1600&q=85`}
              alt={a.title}
              width={a.thumbnail.width}
              height={a.thumbnail.height}
              fetchpriority="high"
              decoding="async"
            />
          : <div class="hero__placeholder" aria-hidden="true"></div>
        }
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__inner">
        {a.category && <p class="hero__cat">{a.category}</p>}
        <h1 class="hero__title">{a.title}</h1>
        <p class="hero__date">{fmtDate(a.publishedAt)}</p>
      </div>
      <div class="hero__cue" aria-hidden="true"><span></span></div>
    </header>

    <!-- ── 記事本体 ── -->
    <article class="jb">

      <!-- パンくず -->
      <nav class="crumb" aria-label="パンくず">
        <a href="/">ホーム</a>
        <span>／</span>
        <a href="/journal">JOURNAL</a>
        <span>／</span>
        <span>{a.title}</span>
      </nav>

      <!-- 目次 -->
      {toc.length > 0 && (
        <nav class="toc" aria-label="目次">
          <p class="toc__label">CONTENTS</p>
          <ol class="toc__list">
            {toc.map((item, i) => (
              <li>
                <a href={`#${item.id}`} class="toc__link">
                  <span class="toc__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="toc__text">{item.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- 本文 -->
      <div class="jb-body prose" set:html={bodyWithIds} />

      <!-- フッターナビ -->
      <footer class="jb-foot">
        <a href="/journal" class="jb-foot__back">← JOURNAL 一覧へ</a>
      </footer>

    </article>

  </main>
</Layout>

<style>
/* ── ヒーロー ── */
.hero {
  position: relative;
  min-height: clamp(28rem, 68svh, 48rem);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  background: #1a1917;
}
.hero__media { position: absolute; inset: 0; }
.hero__media img {
  width: 100%; height: 100%;
  object-fit: cover;
  animation: heroZoom 18s cubic-bezier(.16,1,.3,1) forwards;
}
.hero__placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #1a1917 0%, #2a2723 100%);
}
@keyframes heroZoom { from { transform: scale(1.06); } to { transform: scale(1); } }

.hero__scrim {
  position: absolute; inset: 0;
  background:
    linear-gradient(to top, rgba(16,12,10,.9) 0%, rgba(16,12,10,.55) 38%, rgba(16,12,10,.15) 70%, transparent 100%);
}
.hero__inner {
  position: relative;
  width: min(100% - 2.4rem, 74rem);
  margin: 0 auto;
  padding-bottom: clamp(3.5rem, 9vh, 7rem);
  color: #fff;
}
.hero__cat {
  font-family: var(--font-ui, sans-serif);
  font-size: .65rem;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin: 0 0 1.2rem;
}
.hero__title {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.7rem, 4.5vw, 3.4rem);
  font-weight: 300;
  line-height: 1.45;
  letter-spacing: .06em;
  margin: 0 0 1.2rem;
  max-width: 22em;
  text-shadow: 0 2px 30px rgba(0,0,0,.3);
}
.hero__date {
  font-family: var(--font-ui, sans-serif);
  font-size: .65rem;
  letter-spacing: .18em;
  color: rgba(255,255,255,.45);
  margin: 0;
}
.hero__cue { position: absolute; left: 50%; bottom: 1.6rem; translate: -50% 0; }
.hero__cue span {
  display: block; width: 1px; height: 3.2rem;
  background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,.8));
  animation: cue 2.6s cubic-bezier(.16,1,.3,1) infinite;
  transform-origin: top;
}
@keyframes cue {
  0%   { transform: scaleY(0); opacity: 0; }
  35%  { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(1); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .hero__media img { animation: none; }
  .hero__cue { display: none; }
}

/* ── 記事本体 ── */
.jb {
  width: min(100% - 2.4rem, 68rem);
  margin: 0 auto;
  padding: clamp(3rem, 7vw, 6rem) 0 clamp(5rem, 10vw, 9rem);
}

/* ── パンくず ── */
.crumb {
  font-family: var(--font-ui, sans-serif);
  font-size: .72rem;
  letter-spacing: .1em;
  color: rgba(26,25,23,.4);
  margin: 0 0 clamp(2.5rem, 5vw, 4rem);
  display: flex;
  flex-wrap: wrap;
  gap: .3em;
}
.crumb a {
  color: rgba(26,25,23,.45);
  text-decoration: none;
  transition: color .3s;
}
.crumb a:hover { color: #1a1917; }

/* ── 目次 ── */
.toc {
  border-top: 1px solid rgba(26,25,23,.1);
  border-bottom: 1px solid rgba(26,25,23,.1);
  padding: 2rem 0;
  margin: 0 0 clamp(3.5rem, 6vw, 5.5rem);
}
.toc__label {
  font-family: var(--font-ui, sans-serif);
  font-size: .65rem;
  letter-spacing: .32em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin: 0 0 1.4rem;
}
.toc__list {
  list-style: none;
  margin: 0; padding: 0;
}
.toc__list li + li { margin-top: .1rem; }
.toc__link {
  display: grid;
  grid-template-columns: 2.8rem 1fr;
  align-items: baseline;
  padding: .8em 0;
  text-decoration: none;
  color: #1a1917;
  border-bottom: 1px solid transparent;
  transition: border-color .4s, color .4s;
}
.toc__link:hover { border-bottom-color: rgba(26,25,23,.1); }
.toc__num {
  font-family: var(--font-ui, sans-serif);
  font-size: .75rem;
  letter-spacing: .12em;
  color: var(--gold, #a68a6d);
}
.toc__text {
  font-family: var(--font-jp, sans-serif);
  font-size: .94rem;
  line-height: 1.75;
  transition: color .3s;
}
.toc__link:hover .toc__text { color: #6b6560; }

/* ── 本文（prose） ── */
.prose {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.95rem, 1.1vw, 1.05rem);
  font-weight: 300;
  line-height: 2.15;
  letter-spacing: .04em;
  color: #2e2c2a;
}
.prose :global(h2) {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.25rem, 2.2vw, 1.7rem);
  font-weight: 400;
  letter-spacing: .06em;
  color: #1a1917;
  margin: clamp(3.5rem, 7vw, 5.5rem) 0 1.4rem;
  padding-top: clamp(3rem, 5vw, 4rem);
  border-top: 1px solid rgba(26,25,23,.1);
  line-height: 1.55;
  scroll-margin-top: 7rem;
}
.prose :global(h3) {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.05rem, 1.6vw, 1.3rem);
  font-weight: 400;
  color: #1a1917;
  margin: 2.5rem 0 1rem;
  line-height: 1.6;
}
.prose :global(p) { margin: 0 0 1.7em; }
.prose :global(ul),
.prose :global(ol) { margin: 0 0 1.7em; padding-left: 1.6em; }
.prose :global(li) { margin-bottom: .5em; }
.prose :global(strong) { font-weight: 500; color: #1a1917; }
.prose :global(a) { color: var(--gold, #a68a6d); text-decoration: underline; text-underline-offset: 3px; }
.prose :global(img) { width: 100%; height: auto; display: block; margin: 2.5em 0; }
.prose :global(blockquote) {
  border-left: 3px solid var(--gold, #a68a6d);
  margin: 2.5em 0;
  padding: .8em 1.4em;
  color: #6b6560;
  font-style: italic;
}

/* ── フッター ── */
.jb-foot {
  margin-top: clamp(4rem, 8vw, 7rem);
  padding-top: 2rem;
  border-top: 1px solid rgba(26,25,23,.1);
}
.jb-foot__back {
  font-family: var(--font-ui, sans-serif);
  font-size: .75rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(26,25,23,.45);
  text-decoration: none;
  transition: color .3s;
}
.jb-foot__back:hover { color: var(--gold, #a68a6d); }
</style>

<script>
/* スムーススクロール（scroll-margin-top はCSSで設定済み）*/
document.querySelectorAll('.toc__link').forEach(link => {
  link.addEventListener('click', (e) => {
    const href = (link as HTMLAnchorElement).getAttribute('href');
    if (!href?.startsWith('#')) return;
    const target = document.getElementById(href.slice(1));
    if (!target) return;
    e.preventDefault();
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    history.pushState(null, '', href);
  });
});
</script>
