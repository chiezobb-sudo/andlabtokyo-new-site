---
/**
 * UMAMI & KOJI LAB（麹の体験レッスン・英語ページ）
 *
 * 本文は Wix の /koji-fermentation-experience-tokyo からそのまま移設。
 * 3か月 13クリック・209表示。英語で検索を取っているページなので文言は変えず、
 * 見た目だけ新サイトの体裁に揃える。料金は 2026-08-31 時点の実ページ
 * （1名¥100,000／2名¥80,000／3〜4名¥65,000・いずれも1名あたり・税込）が正。
 * 2026-08-22 のメモにある「セッション一括料金」は古いので使わない。
 *
 * 文言・写真の指定は src/data/courses/koji-lab.json。
 */
import Layout from '../layouts/Layout.astro';
import CoursePage from '../components/course/CoursePage.astro';
import { courseJsonLd } from '../lib/course-jsonld';
import d from '../data/courses/koji-lab.json';

const url = 'https://www.andlabtokyo.com/koji-fermentation-experience-tokyo';
const jsonLd = courseJsonLd({
  path: '/koji-fermentation-experience-tokyo',
  name: 'UMAMI & KOJI LAB — Koji Fermentation Experience in Tokyo',
  description: d.summary,
  image: d.meta.ogImage,
  lang: 'en',
  taxLabel: 'Tax included',
  teaches: [
    'What koji is and how it works',
    'Yellow, black, white and red koji compared side by side',
    'Inoculating steamed rice with tane-koji by hand',
    'Observing koji-no-hana alive under a microscope',
    'Making shio-koji, ama-koji, shoyu-koji and shoyu',
    'Tasting amazake, black-koji amazake, shio-koji and shoyu-koji',
    'Cooking a koji-seasoned lunch you can repeat at home',
    'How miso differs across the regions of Japan',
  ],
  offers: [
    { name: '1 guest (per person)', price: '100000' },
    { name: '2 guests (per person)', price: '80000' },
    { name: '3–4 guests (per person)', price: '65000' },
  ],
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: 'UMAMI & KOJI LAB' }],
  online: false,
  onsite: true,
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout lang="en" title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
