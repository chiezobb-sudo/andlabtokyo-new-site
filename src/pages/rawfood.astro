---
/**
 * 「〜とは」解説記事
 *
 * 中身は microCMS の knowledge 記事 `rawfood`。
 * Wix 時代からこのURLで公開されており、KNOWLEDGE ハブ（/knoweledge）からも
 * このURLで張られている（3か月 10クリック / 1,746表示）。URLは変えない。
 * /knowledge/rawfood は vercel.json で 301。
 */
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import KnowledgeArticle from '../components/knowledge/KnowledgeArticle.astro';
import { getKnowledge } from '../lib/microcms';

const a = await getKnowledge('rawfood');
const url = 'https://www.andlabtokyo.com/rawfood';
---
<Layout
  title={a.seoTitle ?? a.title}
  description={a.seoDescription}
  canonical={url}
  ogImage={(a.ogImage ?? a.heroImage).url}
>
  <JsonLd slot="head" article={a} url={url} />
  <KnowledgeArticle article={a} />
</Layout>
