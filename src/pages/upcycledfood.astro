---
/**
 * アップサイクルフードとは（FUFP／Vin & Céréales）
 *
 * 本文は Wix の /upcycledfood からそのまま移設。3か月 9クリック・表示あり。
 * 旧版は黒背景の独自デザインだったが、Chie の指示（黒背景は圧迫感がある）で
 * 他ページと同じリネン系の配色に統一した。
 *
 * 文言・写真の指定は src/data/pages/upcycledfood.json。
 */
import Layout from '../layouts/Layout.astro';
import CoursePage from '../components/course/CoursePage.astro';
import { articleJsonLd } from '../lib/article-jsonld';
import d from '../data/pages/upcycledfood.json';

const url = 'https://www.andlabtokyo.com/upcycledfood';
const jsonLd = articleJsonLd({
  path: '/upcycledfood',
  headline: 'アップサイクルフードとは｜ワインパミスから生まれる循環の食文化',
  description: d.summary,
  image: d.meta.ogImage,
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: 'アップサイクルフードとは' }],
  published: d.dates.published,
  modified: d.dates.modified,
});
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
