---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="メールマガジン | &LAB TOKYO"
  description="発酵・ローフード・リビングフードの考え方、レッスンのご案内、レシピなどをお届けする&LAB TOKYOのメールマガジン。バックナンバーも公開中。"
  canonical="https://www.andlabtokyo.com/newsletter"
>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .nl-hero {
      background: var(--sumi);
      padding: 6rem 5vw 4rem;
      text-align: center;
    }
    .nl-hero-eyebrow {
      font-family: var(--f-sans); font-size: .72rem; letter-spacing: .22em;
      text-transform: uppercase; color: var(--green); display: block; margin-bottom: 1.2rem;
    }
    .nl-hero-title {
      font-family: var(--f-serif); font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 300; color: #F4F2EE; letter-spacing: .06em;
    }
    .nl-hero-sub {
      font-family: var(--f-sans); font-size: .92rem; color: rgba(244,242,238,.6);
      margin-top: 1.2rem; line-height: 1.9; max-width: 520px; margin-left: auto; margin-right: auto;
    }

    .nl-embed-wrap {
      padding: 4rem 5vw; display: flex; justify-content: center; background: var(--linen-2);
    }
    .nl-embed-inner { width: 100%; max-width: 640px; }

    .archive-link-section {
      padding: 4rem 5vw 6rem; text-align: center;
    }
    .archive-link-cta {
      display: inline-flex; align-items: center; gap: .6rem;
      font-family: var(--f-sans); font-size: .88rem; font-weight: 700; letter-spacing: .06em;
      color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--ink);
      padding-bottom: .3rem; transition: opacity .2s;
    }
    .archive-link-cta:hover { opacity: .65; }

    @media (max-width: 600px) {
      .nl-hero { padding: 4rem 1.5rem 3rem; }
    }
  </style>

  <div class="nl-hero">
    <span class="nl-hero-eyebrow">&amp;LAB Letter</span>
    <h1 class="nl-hero-title">メールマガジン</h1>
    <p class="nl-hero-sub">
      発酵・ローフード・リビングフードの考え方、レッスンのご案内、レシピなどを不定期でお届けします。<br />
      安藤千英からの読み物を、ぜひ登録してお楽しみください。
    </p>
  </div>

  <div class="nl-embed-wrap">
    <div class="nl-embed-inner">
      <script async src="https://forms.us.benchmarksend.com/assets/embed.js"></script>
      <div data-bme-form-id="MO0xqDkYIW5PgaKh6tW4C"></div>
    </div>
  </div>

  <div class="archive-link-section">
    <a href="/newsletter/archive" class="archive-link-cta">バックナンバーを見る →</a>
  </div>
</Layout>
