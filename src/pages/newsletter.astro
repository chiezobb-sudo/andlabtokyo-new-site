---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('blog');
const issues = allPosts
  .filter(p => p.data.category === 'メルマガ')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title="メールマガジン | &LAB TOKYO"
  description="発酵・ローフード・リビングフードの考え方、レッスンのご案内、レシピなどをお届けする&LAB TOKYOのメールマガジン。バックナンバーも公開中。"
  canonical="https://www.andlabtokyo.com/newsletter"
>
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .nl-hero {
      background: var(--sumi);
      padding: 6rem 5vw 4rem;
      text-align: center;
    }
    .nl-hero-eyebrow {
      font-family: var(--f-sans); font-size: .72rem; letter-spacing: .22em;
      text-transform: uppercase; color: var(--green); display: block; margin-bottom: 1.2rem;
    }
    .nl-hero-title {
      font-family: var(--f-serif); font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 300; color: #F4F2EE; letter-spacing: .06em;
    }
    .nl-hero-sub {
      font-family: var(--f-sans); font-size: .92rem; color: rgba(244,242,238,.6);
      margin-top: 1.2rem; line-height: 1.9; max-width: 520px; margin-left: auto; margin-right: auto;
    }

    .nl-embed-wrap {
      padding: 4rem 5vw; display: flex; justify-content: center; background: var(--linen-2);
    }
    .nl-embed-inner { width: 100%; max-width: 640px; }

    .archive-section { padding: 5rem 5vw 6rem; max-width: 900px; margin: 0 auto; }
    .archive-title {
      font-family: var(--f-serif); font-size: 1.5rem; font-weight: 400;
      letter-spacing: .06em; color: var(--ink); margin-bottom: .6rem;
    }
    .archive-sub { font-family: var(--f-sans); font-size: .85rem; color: var(--ink-3); margin-bottom: 2.5rem; }

    .issue-list { display: flex; flex-direction: column; gap: 1.6rem; }
    .issue-card {
      display: grid; grid-template-columns: 160px 1fr; gap: 1.6rem;
      text-decoration: none; color: inherit; padding-bottom: 1.6rem;
      border-bottom: 1px solid var(--divider);
    }
    .issue-thumb { aspect-ratio: 4/3; overflow: hidden; border-radius: 2px; background: var(--linen-2); }
    .issue-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
    .issue-card:hover .issue-thumb img { transform: scale(1.05); }
    .issue-date {
      font-family: var(--f-sans); font-size: .72rem; color: var(--ink-3);
      letter-spacing: .06em; margin-bottom: .5rem; display: block;
    }
    .issue-title {
      font-family: var(--f-serif); font-size: 1.1rem; font-weight: 400;
      line-height: 1.6; color: var(--ink);
    }
    .issue-desc {
      font-family: var(--f-sans); font-size: .82rem; color: var(--ink-3);
      line-height: 1.8; margin-top: .6rem;
    }

    .empty-state {
      font-family: var(--f-sans); font-size: .88rem; color: var(--ink-3);
      text-align: center; padding: 3rem 0; line-height: 1.9;
    }

    @media (max-width: 600px) {
      .nl-hero { padding: 4rem 1.5rem 3rem; }
      .archive-section { padding: 3.5rem 1.5rem 4rem; }
      .issue-card { grid-template-columns: 100px 1fr; gap: 1rem; }
    }
  </style>

  <div class="nl-hero">
    <span class="nl-hero-eyebrow">&amp;LAB Letter</span>
    <h1 class="nl-hero-title">メールマガジン</h1>
    <p class="nl-hero-sub">
      発酵・ローフード・リビングフードの考え方、レッスンのご案内、レシピなどを不定期でお届けします。<br />
      安藤千英からの読み物を、ぜひ登録してお楽しみください。
    </p>
  </div>

  <div class="nl-embed-wrap">
    <div class="nl-embed-inner">
      <script async src="https://forms.us.benchmarksend.com/assets/embed.js"></script>
      <div data-bme-form-id="MO0xqDkYIW5PgaKh6tW4C"></div>
    </div>
  </div>

  <div class="archive-section">
    <h2 class="archive-title">バックナンバー</h2>
    <p class="archive-sub">{issues.length}件のメールマガジンを公開中</p>

    {issues.length > 0 ? (
      <div class="issue-list">
        {issues.map(issue => {
          const slug = issue.id.replace(/\.md$/, '');
          const date = new Date(issue.data.date).toLocaleDateString('ja-JP', {
            year: 'numeric', month: 'long', day: 'numeric'
          });
          return (
            <a href={`/post/${slug}`} class="issue-card">
              <div class="issue-thumb">
                {issue.data.image && <img src={issue.data.image} alt={issue.data.title} loading="lazy" />}
              </div>
              <div>
                <span class="issue-date">{date}</span>
                <h3 class="issue-title">{issue.data.title}</h3>
                {issue.data.description && <p class="issue-desc">{issue.data.description}</p>}
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="empty-state">まだバックナンバーはありません。配信が始まり次第、こちらに公開していきます。</p>
    )}
  </div>
</Layout>
