---
/**
 * 講座一覧（講座マップ）
 *
 * 構成は andlab_講座案内_叩き台.pdf（2026-09-04 のパンフレット）に合わせている。
 * 背骨は「知る → 深める → 創る → 伝える」の4ステップ。
 *
 * 旧版は写真の上に濃い暗幕を敷いて白文字を重ねており、
 * 写真も文字も潰れて読みにくいと指摘を受けた（Chie 2026-09-05）。
 * このページでは文字を写真に重ねない。見出しは masthead（無地）、
 * 写真は band とカタログカード（文字は写真の下）で見せる。
 * 旧版は scratchpad/alllesson_旧版.astro.bak に退避。
 *
 * 文言・写真の指定は src/data/pages/alllesson.json。
 */
import Layout from '../layouts/Layout.astro';
import CoursePage from '../components/course/CoursePage.astro';
import { articleJsonLd } from '../lib/article-jsonld';
import d from '../data/pages/alllesson.json';

const url = 'https://www.andlabtokyo.com/alllesson';

const tracks = d.blocks.find((b: any) => b.id === 'tracks')?.items ?? [];
const itemList = {
  '@type': 'ItemList',
  '@id': `${url}#courses`,
  name: '&LAB TOKYO の講座',
  itemListElement: tracks.map((t: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.title,
    url: `https://www.andlabtokyo.com${t.href}`,
  })),
};

const jsonLd = articleJsonLd({
  path: '/alllesson',
  headline: '講座一覧｜発酵・ローフード・ロースイーツ・ローチョコレート',
  description: d.summary,
  image: d.meta.ogImage,
  faq: d.blocks.find((b: any) => b.type === 'faq')?.items,
  breadcrumb: [{ name: '講座一覧' }],
  published: d.dates.published,
  modified: d.dates.modified,
});
jsonLd['@graph'].push(itemList);
---
<Layout title={d.meta.title} description={d.meta.description} canonical={url} ogImage={d.meta.ogImage}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <CoursePage data={d} />
</Layout>
