---
import type { HeroBlock } from '../../lib/microcms';

interface Props { block: HeroBlock }
const { block: b } = Astro.props;

// mainCopy の改行を <br> に変換
const mainLines = b.mainCopy.split('\n');
---

<section class="hero-blk">
  {b.videoUrl ? (
    <div class="hero-blk__media">
      <video
        class="hero-blk__video"
        autoplay
        muted
        loop
        playsinline
        poster={b.bgImage?.url}
        preload="auto"
      >
        <source src={b.videoUrl} type="video/mp4" />
      </video>
    </div>
  ) : b.bgImage ? (
    <div class="hero-blk__media">
      <img src={b.bgImage.url} alt="" width={b.bgImage.width} height={b.bgImage.height} fetchpriority="high" decoding="async" />
    </div>
  ) : null}
  <div class="hero-blk__scrim" aria-hidden="true"></div>

  <div class="hero-blk__inner">
    {b.eyebrow && <p class="hero-blk__eyebrow">{b.eyebrow}</p>}

    <h1 class="hero-blk__title">
      {mainLines.map((line, i) => (
        <>
          {b.accentWord && line.includes(b.accentWord)
            ? line.split(b.accentWord).map((part, j, arr) => (
                <>
                  {part}
                  {j < arr.length - 1 && <em class="hero-blk__accent">{b.accentWord}</em>}
                </>
              ))
            : line}
          {i < mainLines.length - 1 && <br />}
        </>
      ))}
    </h1>

    {b.subCopy && <p class="hero-blk__sub">{b.subCopy}</p>}

    {(b.ctaLabel || b.ctaLabel2) && (
      <div class="hero-blk__ctas">
        {b.ctaUrl && b.ctaLabel && (
          <a href={b.ctaUrl} class="hero-blk__cta hero-blk__cta--primary">{b.ctaLabel}</a>
        )}
        {b.ctaUrl2 && b.ctaLabel2 && (
          <a href={b.ctaUrl2} class="hero-blk__cta hero-blk__cta--outline">{b.ctaLabel2}</a>
        )}
      </div>
    )}
  </div>

  <div class="hero-blk__scroll" aria-hidden="true"><span></span></div>
</section>

<style>
.hero-blk {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  background: var(--bg-dark, #141413);
  overflow: hidden;
}

.hero-blk__media {
  position: absolute;
  inset: 0;
}
.hero-blk__media img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center top;
  animation: heroZoom 20s cubic-bezier(.16,1,.3,1) forwards;
}
.hero-blk__video {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
}
@keyframes heroZoom {
  from { transform: scale(1.07); }
  to   { transform: scale(1); }
}

.hero-blk__scrim {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to right,
      rgba(20,12,10,.92) 0%,
      rgba(20,12,10,.72) 40%,
      rgba(20,12,10,.4)  70%,
      rgba(20,12,10,.2)  100%
    ),
    linear-gradient(
      to top,
      rgba(20,12,10,.6) 0%,
      transparent 50%
    );
}

.hero-blk__inner {
  position: relative;
  z-index: 1;
  width: min(100% - 3rem, 80rem);
  margin: 0 auto;
  padding: clamp(8rem, 18vh, 14rem) 0 clamp(6rem, 12vh, 10rem);
}

.hero-blk__eyebrow {
  font-family: var(--font-ui, sans-serif);
  font-size: .72rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin: 0 0 2rem;
}

.hero-blk__title {
  font-family: var(--font-jp, serif);
  font-size: clamp(2.2rem, 6vw + 1rem, 5.2rem);
  font-weight: 300;
  line-height: 1.42;
  letter-spacing: .06em;
  color: #f0ece6;
  margin: 0 0 2rem;
  max-width: 18em;
  text-shadow: 0 2px 40px rgba(0,0,0,.4);
}

.hero-blk__accent {
  font-style: normal;
  color: var(--gold, #a68a6d);
}

.hero-blk__sub {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(.9rem, 1.2vw, 1.1rem);
  line-height: 2;
  color: rgba(240,236,230,.72);
  margin: 0 0 3rem;
  max-width: 30em;
}

.hero-blk__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.hero-blk__cta {
  display: inline-block;
  font-family: var(--font-ui, sans-serif);
  font-size: .82rem;
  letter-spacing: .14em;
  text-decoration: none;
  padding: .9rem 2.4rem;
  transition: opacity .3s, background .3s;
}

.hero-blk__cta--primary {
  background: var(--gold, #a68a6d);
  color: #0a0808;
}
.hero-blk__cta--primary:hover { opacity: .82; }

.hero-blk__cta--outline {
  background: transparent;
  color: rgba(240,236,230,.85);
  border: 1px solid rgba(240,236,230,.32);
}
.hero-blk__cta--outline:hover {
  border-color: var(--gold, #a68a6d);
  color: var(--gold, #a68a6d);
}

/* スクロールキュー */
.hero-blk__scroll {
  position: absolute;
  left: 50%;
  bottom: 2rem;
  transform: translateX(-50%);
}
.hero-blk__scroll span {
  display: block;
  width: 1px;
  height: 3.6rem;
  background: linear-gradient(to bottom, transparent, rgba(166,138,109,.8));
  animation: scrollCue 2.4s ease-in-out infinite;
  transform-origin: top;
}
@keyframes scrollCue {
  0%   { transform: scaleY(0); opacity: 0; }
  30%  { transform: scaleY(1); opacity: 1; }
  100% { transform: scaleY(1); opacity: 0; }
}

@media (max-width: 48rem) {
  .hero-blk__scrim {
    background: rgba(20,12,10,.72);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-blk__media img { animation: none; }
  .hero-blk__scroll { display: none; }
}
</style>
