---
import type { ProfileBandBlock } from '../../lib/microcms';

interface Props { block: ProfileBandBlock }
const { block: b } = Astro.props;
---

<section class="pb">
  <div class="pb__inner">
    {b.image && (
      <div class="pb__img">
        <img
          src={b.image.url + '?w=800&h=1000&fit=crop'}
          alt={b.name}
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="pb__text">
      {b.label && <p class="pb__label">{b.label}</p>}

      <div class="pb__nameblock">
        <p class="pb__name">{b.name}</p>
        {b.nameEn && <p class="pb__name-en">{b.nameEn}</p>}
      </div>

      {b.subText && <p class="pb__sub">{b.subText}</p>}

      <p class="pb__desc">{b.description}</p>

      {b.ctaUrl && b.ctaLabel && (
        <a href={b.ctaUrl} class="pb__cta">{b.ctaLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
.pb {
  background: #fafaf8;
  padding: clamp(5rem, 9vw, 10rem) clamp(1.5rem, 5vw, 5rem);
}

.pb__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(3rem, 6vw, 7rem);
  align-items: center;
  width: min(100%, 78rem);
  margin: 0 auto;
}

.pb__img {
  aspect-ratio: 4/5;
  overflow: hidden;
}
.pb__img img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: grayscale(8%) contrast(1.02);
  transition: transform 1s cubic-bezier(.16,1,.3,1);
}
.pb__img:hover img { transform: scale(1.03); }

.pb__label {
  font-family: var(--font-ui, sans-serif);
  font-size: .7rem;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin: 0 0 2rem;
}

.pb__nameblock {
  margin-bottom: 1.2rem;
}

.pb__name {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  letter-spacing: .1em;
  color: #1a1917;
  margin: 0;
  line-height: 1.2;
}

.pb__name-en {
  font-family: var(--font-en, sans-serif);
  font-size: clamp(.9rem, 1.5vw, 1.2rem);
  font-weight: 300;
  letter-spacing: .2em;
  color: var(--gold, #a68a6d);
  margin: .4rem 0 0;
}

.pb__sub {
  font-family: var(--font-ui, sans-serif);
  font-size: .82rem;
  letter-spacing: .06em;
  color: #6b6560;
  margin: 0 0 2rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid rgba(26,25,23,.1);
}

.pb__desc {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.9rem, 1.2vw, 1rem);
  font-weight: 300;
  line-height: 2.2;
  color: #3a3835;
  margin: 0 0 2.5rem;
}

.pb__cta {
  display: inline-block;
  font-family: var(--font-ui, sans-serif);
  font-size: .78rem;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  text-decoration: none;
  border-bottom: 1px solid rgba(166,138,109,.45);
  padding-bottom: .2rem;
  transition: opacity .3s;
}
.pb__cta:hover { opacity: .65; }

@media (max-width: 56rem) {
  .pb__inner {
    grid-template-columns: 1fr;
  }
  .pb__img {
    max-height: 420px;
    aspect-ratio: unset;
  }
}
</style>
