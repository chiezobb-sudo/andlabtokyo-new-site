---
import type { SliderAreaBlock } from '../../lib/microcms';

interface Props { block: SliderAreaBlock }
const { block: b } = Astro.props;
const slides = b.slides ?? [];
---

{slides.length > 0 && (
<section class="sl">

  <!-- ── セクションヘッダー ── -->
  <header class="sl__header">
    <p class="sl__eyebrow">COURSES</p>
    <div class="sl__header-row">
      <h2 class="sl__section-title">講座のご案内</h2>
      <a href="/alllesson" class="sl__all-link" aria-label="全ての講座を見る">
        全ての講座を見る
        <svg width="28" height="1" viewBox="0 0 28 1" aria-hidden="true">
          <line x1="0" y1="0.5" x2="28" y2="0.5" stroke="currentColor"/>
        </svg>
      </a>
    </div>
  </header>

  <!-- ── 2カラムグリッド ── -->
  <div class="sl__grid">
    {slides.map((s, i) => (
      <a href={s.url ?? '#'} class="sl__panel">
        <!-- メディア -->
        <div class="sl__panel-media">
          {s.videoUrl
            ? <video class="sl__panel-video" autoplay muted loop playsinline
                poster={s.image?.url} preload="auto">
                <source src={s.videoUrl} type="video/mp4" />
              </video>
            : s.image
              ? <img class="sl__panel-img"
                  src={`${s.image.url}?w=1200&q=85`}
                  alt={s.title ?? ''}
                  width={s.image.width}
                  height={s.image.height}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async" />
              : <div class="sl__panel-placeholder" aria-hidden="true"></div>
          }
          <div class="sl__panel-scrim" aria-hidden="true"></div>
        </div>

        <!-- テキスト -->
        <div class="sl__panel-body">
          {s.text && <p class="sl__panel-text">{s.text}</p>}
          {s.title && <h3 class="sl__panel-title">{s.title}</h3>}
          <span class="sl__panel-btn" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
              <circle cx="22" cy="22" r="21" stroke="currentColor" stroke-width="1"/>
              <path d="M17 22h10M23 18l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>

</section>
)}

<style>
/* ─── セクション全体 ─── */
.sl {
  background: #fafaf8;
  padding-top: clamp(5rem, 10vw, 9rem);
  padding-bottom: clamp(4rem, 8vw, 7rem);
}

/* ─── ヘッダー ─── */
.sl__header {
  padding: 0 clamp(1.5rem, 6vw, 6rem);
  margin-bottom: clamp(2.5rem, 4vw, 4rem);
}

.sl__eyebrow {
  font-family: var(--font-ui, sans-serif);
  font-size: .68rem;
  letter-spacing: .36em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin: 0 0 .9rem;
}

.sl__header-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 2rem;
}

.sl__section-title {
  font-family: var(--font-jp, serif);
  font-size: clamp(1.5rem, 3vw, 2.4rem);
  font-weight: 300;
  letter-spacing: .1em;
  color: #1a1917;
  margin: 0;
}

/* ─── 「全ての講座を見る」リンク ─── */
.sl__all-link {
  display: inline-flex;
  align-items: center;
  gap: .9rem;
  font-family: var(--font-ui, sans-serif);
  font-size: .72rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(26, 25, 23, .38);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color .35s, gap .35s;
}
.sl__all-link svg { flex-shrink: 0; transition: transform .35s; }
.sl__all-link:hover {
  color: var(--gold, #a68a6d);
  gap: 1.4rem;
}
.sl__all-link:hover svg { transform: translateX(4px); }

/* ─── 2カラムグリッド ─── */
.sl__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3px;
}

.sl__panel {
  position: relative;
  display: block;
  overflow: hidden;
  text-decoration: none;
  aspect-ratio: 4 / 3;
  background: #1a1917;
}

/* ─── メディア ─── */
.sl__panel-media {
  position: absolute;
  inset: 0;
}

.sl__panel-img,
.sl__panel-video {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform .8s cubic-bezier(.16,1,.3,1);
}
.sl__panel:hover .sl__panel-img,
.sl__panel:hover .sl__panel-video { transform: scale(1.05); }

.sl__panel-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #1e1c1a 0%, #2a2723 100%);
}

.sl__panel-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10,8,7,.88) 0%,
    rgba(10,8,7,.45) 45%,
    rgba(10,8,7,.05) 100%
  );
}

/* ─── テキスト ─── */
.sl__panel-body {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: clamp(1.5rem, 3vw, 2.5rem);
}

.sl__panel-text {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(.68rem, .9vw, .78rem);
  line-height: 1.9;
  letter-spacing: .06em;
  color: rgba(240,236,230,.5);
  margin: 0 0 .5rem;
}

.sl__panel-title {
  font-family: var(--font-jp, serif);
  font-size: clamp(1.1rem, 2vw, 1.55rem);
  font-weight: 300;
  line-height: 1.6;
  letter-spacing: .08em;
  color: rgba(240,236,230,.95);
  margin: 0 0 1.2rem;
  white-space: pre-line;
}

.sl__panel-btn {
  display: block;
  width: 44px;
  color: var(--gold, #a68a6d);
  opacity: 0;
  transform: translateY(8px);
  transition: opacity .3s, transform .3s;
}
.sl__panel:hover .sl__panel-btn { opacity: 1; transform: translateY(0); }

/* ─── レスポンシブ ─── */
@media (max-width: 48rem) {
  .sl__grid { grid-template-columns: 1fr; }
  .sl__panel { aspect-ratio: 3 / 2; }
  .sl__panel-btn { opacity: 1; transform: none; }
  .sl__all-link { display: none; }
  .sl__section-title { font-size: 1.4rem; }
}

@media (prefers-reduced-motion: reduce) {
  .sl__card-img,
  .sl__card-video,
  .sl__card-cta { transition: none; }
}
</style>

