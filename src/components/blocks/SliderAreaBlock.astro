---
import type { SliderAreaBlock } from '../../lib/microcms';

interface Props { block: SliderAreaBlock }
const { block: b } = Astro.props;
const slides = b.slides ?? [];
---

{slides.length > 0 && (
<section class="sl">

  <!-- ── セクションヘッダー ── -->
  <header class="sl__header">
    <p class="sl__eyebrow">COURSES</p>
    <div class="sl__header-row">
      <h2 class="sl__section-title">講座のご案内</h2>
      <a href="/listofcourses" class="sl__all-link" aria-label="全ての講座を見る">
        全ての講座を見る
        <svg width="28" height="1" viewBox="0 0 28 1" aria-hidden="true">
          <line x1="0" y1="0.5" x2="28" y2="0.5" stroke="currentColor"/>
        </svg>
      </a>
    </div>
  </header>

  <!-- ── スクロールカルーセル ── -->
  <div class="sl__viewport" tabindex="0" role="region" aria-label="講座一覧スライダー">
    <ul class="sl__track" role="list">
      {slides.map((s, i) => (
        <li class="sl__card" role="listitem">
          <a href={s.url ?? '#'} class="sl__card-inner" tabindex="0">

            <!-- メディア -->
            <div class="sl__card-media">
              {s.videoUrl
                ? <video class="sl__card-video" autoplay muted loop playsinline
                    poster={s.image?.url} preload="auto">
                    <source src={s.videoUrl} type="video/mp4" />
                  </video>
                : s.image
                  ? <img class="sl__card-img"
                      src={`${s.image.url}?w=900&q=85`}
                      alt={s.title ?? ''}
                      width={s.image.width}
                      height={s.image.height}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async" />
                  : <div class="sl__card-placeholder" aria-hidden="true"></div>
              }
              <div class="sl__card-scrim" aria-hidden="true"></div>
            </div>

            <!-- テキスト -->
            <div class="sl__card-body">
              {s.text && <p class="sl__card-text">{s.text}</p>}
              {s.title && <h3 class="sl__card-title">{s.title}</h3>}
              <span class="sl__card-cta" aria-hidden="true">
                詳しく見る
                <svg width="18" height="1" viewBox="0 0 18 1" aria-hidden="true">
                  <line x1="0" y1="0.5" x2="18" y2="0.5" stroke="currentColor"/>
                </svg>
              </span>
            </div>

          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- ── プログレスバー（モバイル） ── -->
  <div class="sl__progress" aria-hidden="true">
    <div class="sl__progress-bar"></div>
  </div>

</section>
)}

<style>
/* ─── セクション全体 ─── */
.sl {
  background: var(--bg-dark, #141413);
  padding-top: clamp(5rem, 10vw, 9rem);
  padding-bottom: clamp(4rem, 8vw, 7rem);
}

/* ─── ヘッダー ─── */
.sl__header {
  padding: 0 clamp(1.5rem, 6vw, 6rem);
  margin-bottom: clamp(2.5rem, 4vw, 4rem);
}

.sl__eyebrow {
  font-family: var(--font-ui, sans-serif);
  font-size: .68rem;
  letter-spacing: .36em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin: 0 0 .9rem;
}

.sl__header-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 2rem;
}

.sl__section-title {
  font-family: var(--font-jp, serif);
  font-size: clamp(1.5rem, 3vw, 2.4rem);
  font-weight: 300;
  letter-spacing: .1em;
  color: rgba(240, 236, 230, .88);
  margin: 0;
}

/* ─── 「全ての講座を見る」リンク ─── */
.sl__all-link {
  display: inline-flex;
  align-items: center;
  gap: .9rem;
  font-family: var(--font-ui, sans-serif);
  font-size: .72rem;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(240, 236, 230, .45);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: color .35s, gap .35s;
}
.sl__all-link svg { flex-shrink: 0; transition: transform .35s; }
.sl__all-link:hover {
  color: var(--gold, #a68a6d);
  gap: 1.4rem;
}
.sl__all-link:hover svg { transform: translateX(4px); }

/* ─── ビューポート（横スクロール） ─── */
.sl__viewport {
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  cursor: grab;
}
.sl__viewport:active { cursor: grabbing; }
.sl__viewport::-webkit-scrollbar { display: none; }

/* ─── トラック ─── */
.sl__track {
  display: flex;
  gap: clamp(1rem, 1.5vw, 1.5rem);
  padding: 0 clamp(1.5rem, 6vw, 6rem);
  /* 末尾にも余白（最後のカードがぴったりくっつかないように） */
  padding-right: clamp(1.5rem, 6vw, 6rem);
  list-style: none;
  margin: 0;
  /* scroll-padding は viewport 側に効かせる */
}

/* ─── カード ─── */
.sl__card {
  /* PC: 2枚 */
  flex: 0 0 calc((100vw - 2 * clamp(1.5rem,6vw,6rem) - clamp(1rem,1.5vw,1.5rem)) / 2);
  scroll-snap-align: start;
  min-width: 220px;
}

.sl__card-inner {
  display: block;
  text-decoration: none;
  outline-offset: 4px;
  /* カードの縦比 */
  aspect-ratio: 3 / 4;
  position: relative;
  overflow: hidden;
  background: #1a1917;
}

/* ─── メディア層 ─── */
.sl__card-media {
  position: absolute;
  inset: 0;
}

.sl__card-img,
.sl__card-video {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 1s cubic-bezier(.16,1,.3,1);
}
.sl__card-inner:hover .sl__card-img,
.sl__card-inner:hover .sl__card-video {
  transform: scale(1.05);
}

.sl__card-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #1e1c1a 0%, #2a2723 100%);
}

.sl__card-scrim {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10,8,7,.92) 0%,
    rgba(10,8,7,.55) 40%,
    rgba(10,8,7,.1)  70%,
    transparent      100%
  );
  transition: opacity .4s;
}
.sl__card-inner:hover .sl__card-scrim {
  opacity: .85;
}

/* ─── テキスト ─── */
.sl__card-body {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: clamp(1.4rem, 2.5vw, 2rem);
  display: flex;
  flex-direction: column;
  gap: .6rem;
}

.sl__card-text {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(.68rem, .9vw, .78rem);
  line-height: 2;
  letter-spacing: .06em;
  color: rgba(240, 236, 230, .48);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color .3s;
}
.sl__card-inner:hover .sl__card-text {
  color: rgba(240, 236, 230, .65);
}

.sl__card-title {
  font-family: var(--font-jp, serif);
  font-size: clamp(1.1rem, 1.8vw, 1.5rem);
  font-weight: 300;
  line-height: 1.6;
  letter-spacing: .1em;
  color: rgba(240, 236, 230, .95);
  margin: 0;
  text-shadow: 0 2px 20px rgba(0,0,0,.4);
  white-space: pre-line;
}

.sl__card-cta {
  display: inline-flex;
  align-items: center;
  gap: .7rem;
  font-family: var(--font-ui, sans-serif);
  font-size: .65rem;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--gold, #a68a6d);
  margin-top: .4rem;
  opacity: 0;
  transform: translateY(.4rem);
  transition: opacity .35s, transform .35s;
}
.sl__card-inner:hover .sl__card-cta,
.sl__card-inner:focus-visible .sl__card-cta {
  opacity: 1;
  transform: none;
}

/* ─── プログレスバー（モバイルのみ表示） ─── */
.sl__progress {
  display: none;
  height: 1px;
  background: rgba(240,236,230,.1);
  margin: 2rem clamp(1.5rem, 6vw, 6rem) 0;
}
.sl__progress-bar {
  height: 100%;
  background: var(--gold, #a68a6d);
  width: 33%;
  transition: width .2s;
}

/* ─── レスポンシブ ─── */
@media (max-width: 48rem) {
  /* スマホ: 1枚（画面幅いっぱい） */
  .sl__card {
    flex: 0 0 calc(100vw - 2 * 1.5rem);
  }
  .sl__all-link { display: none; }
  .sl__section-title { font-size: 1.4rem; }
  .sl__progress { display: block; }
}

@media (prefers-reduced-motion: reduce) {
  .sl__card-img,
  .sl__card-video,
  .sl__card-cta { transition: none; }
}
</style>

<script>
(function () {
  const viewports = document.querySelectorAll<HTMLElement>('.sl__viewport');

  viewports.forEach(vp => {
    const track    = vp.querySelector<HTMLElement>('.sl__track');
    const bar      = vp.closest('.sl')?.querySelector<HTMLElement>('.sl__progress-bar');

    /* ── プログレスバー更新 ── */
    function updateBar() {
      if (!bar) return;
      const ratio = vp.scrollLeft / (vp.scrollWidth - vp.clientWidth);
      bar.style.width = `${Math.round(ratio * 100)}%`;
    }
    vp.addEventListener('scroll', updateBar, { passive: true });

    /* ── マウスドラッグ ── */
    let isDown = false, startX = 0, scrollLeft = 0;
    vp.addEventListener('mousedown', e => {
      isDown = true;
      startX = e.pageX - vp.offsetLeft;
      scrollLeft = vp.scrollLeft;
    });
    document.addEventListener('mouseup',   () => { isDown = false; });
    document.addEventListener('mousemove', e => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - vp.offsetLeft;
      vp.scrollLeft = scrollLeft - (x - startX);
    });

    updateBar();
  });
})();
</script>
