---
import type { ConceptBandBlock } from '../../lib/microcms';

interface Props { block: ConceptBandBlock }
const { block: b } = Astro.props;
---

<section class="cb">
  <div class="cb__inner">
    <h2 class="cb__catchcopy">{b.catchcopy}</h2>
    {b.leadText && <p class="cb__lead">{b.leadText}</p>}
  </div>
</section>

<style>
.cb {
  background: #ffffff;
  padding: clamp(5rem, 9vw, 8rem) clamp(1.5rem, 5vw, 5rem);
  text-align: center;
}

.cb__inner {
  width: min(100%, 52rem);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(1.8rem, 3vw, 2.6rem);
}

.cb__catchcopy {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(1.7rem, 4.2vw, 3.2rem);
  font-weight: 300;
  line-height: 1.75;
  letter-spacing: .08em;
  color: #1a1917;
  margin: 0;
  text-wrap: balance;
  white-space: pre-line;
}

.cb__lead {
  font-family: var(--font-jp, sans-serif);
  font-size: clamp(.88rem, 1.1vw, 1rem);
  font-weight: 300;
  line-height: 2.4;
  color: #6b6560;
  margin: 0;
  max-width: 34em;
  letter-spacing: .04em;
}

@media (max-width: 48rem) {
  .cb__catchcopy {
    letter-spacing: .05em;
  }
}
</style>
