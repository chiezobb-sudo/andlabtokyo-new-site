---
import type { ConceptBandBlock } from '../../lib/microcms';

interface Props { block: ConceptBandBlock }
const { block: b } = Astro.props;
---

<section class="cb">
  <div class="cb__inner">
    <h2 class="cb__catchcopy">{b.catchcopy}</h2>
    {b.leadText && <p class="cb__lead">{b.leadText}</p>}
  </div>
</section>

<style>
.cb {
  background: var(--bg-dark, #141413);
  padding: clamp(8rem, 16vw, 16rem) clamp(1.5rem, 5vw, 5rem);
  text-align: center;
}

.cb__inner {
  width: min(100%, 52rem);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(2.4rem, 4vw, 3.6rem);
}

.cb__catchcopy {
  font-family: var(--font-jp, serif);
  font-size: clamp(1.9rem, 5vw, 3.8rem);
  font-weight: 300;
  line-height: 1.8;
  letter-spacing: .12em;
  color: rgba(240, 236, 230, .92);
  margin: 0;
  text-wrap: balance;
  white-space: pre-line;
}

.cb__lead {
  font-family: var(--font-ui, sans-serif);
  font-size: clamp(.9rem, 1.2vw, 1.05rem);
  line-height: 2.6;
  color: rgba(240, 236, 230, .48);
  margin: 0;
  max-width: 34em;
  letter-spacing: .06em;
}

@media (max-width: 48rem) {
  .cb__catchcopy {
    letter-spacing: .08em;
  }
}
</style>
