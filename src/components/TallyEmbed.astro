---
/**
 * Tally フォームの埋め込み。
 *
 * ページ内にそのまま入力欄が出る形（別タブに飛ばさない）。
 *
 * 実装メモ（2026-09-05・実機で確認）:
 *   Tally 公式の「data-tally-src + embed.js + Tally.loadEmbeds()」方式は、
 *   このサイトでは src が入らず iframe が空のまま表示された。
 *   loadEmbeds() を手で呼んでも同じ（loading="lazy" の有無も無関係）。
 *   src を直接入れると Tally.FormLoaded が飛んできて正常に描画されるため、
 *   JS を使わず素の iframe にしている。壊れる余地が少ない。
 *
 *   代わりに自動リサイズ（dynamicHeight）は使えないので、高さは height で指定する。
 *   フォームが伸びた場合は iframe 内でスクロールする。
 *   項目を増やしたときは height を見直すこと。
 */
interface Props {
  /** tally.so/r/XXXXXX の XXXXXX */
  id: string;
  /** iframe のタイトル（スクリーンリーダー用） */
  title?: string;
  /** 表示する高さ(px)。フォームの項目数に合わせる */
  height?: number;
}
const { id, title = 'お申し込みフォーム', height = 900 } = Astro.props;
const src = `https://tally.so/embed/${id}?alignLeft=1&hideTitle=1&transparentBackground=1`;
---
<div class="tally-wrap">
  <iframe
    src={src}
    width="100%"
    height={height}
    loading="lazy"
    frameborder="0"
    marginheight="0"
    marginwidth="0"
    title={title}
  ></iframe>
</div>
<p class="tally-alt">
  うまく表示されない場合は <a href={`https://tally.so/r/${id}`} target="_blank" rel="noopener">別ページでフォームを開く →</a>
</p>

<style>
  .tally-wrap { background: #fff; border: 1px solid rgba(198,161,91,.28); border-radius: 4px; overflow: hidden; }
  .tally-wrap iframe { display: block; width: 100%; border: 0; }
  .tally-alt { margin: 12px 0 0; font-size: 12.5px; line-height: 1.8; color: #6E6862; }
  .tally-alt a { color: #A8794A; }
</style>
