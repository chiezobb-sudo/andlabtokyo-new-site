---
/**
 * InstagramFeed コンポーネント
 *
 * 使い方（どのページにも埋め込み可能）:
 * import InstagramFeed from '../components/InstagramFeed.astro';
 * <InstagramFeed />
 * <InstagramFeed limit={8} />
 *
 * 【動作】
 * ブラウザ側から /api/instagram を叩いて最新投稿を並べる。
 * 環境変数（IG_USER_ID / IG_ACCESS_TOKEN）が未設定・トークン期限切れ・
 * 取得失敗のときは、下のリンクボタン表示に自動で戻る。
 * アクセストークンはサーバー側（api/instagram.js）だけで扱い、
 * このファイルには絶対に書かないこと。
 *
 * セットアップ手順は docs/instagram-setup.md を参照。
 */

interface Props {
  limit?: number;
}

const { limit = 8 } = Astro.props;

// Instagram の設定
const INSTAGRAM_HANDLE = "@chie_andlab"; // Instagramのアカウント名
const INSTAGRAM_URL = "https://www.instagram.com/chie_andlab/";
---

<section class="ig-sec">
  <div class="ig-inner">
    <div class="ig-head">
      <div>
        <span class="ig-eyebrow">Instagram</span>
        <h2 class="ig-title">日々の発酵と、食の美意識。</h2>
      </div>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="ig-follow">
        {INSTAGRAM_HANDLE} をフォロー →
      </a>
    </div>

    <!-- 取得できた場合はここに投稿が入る -->
    <div class="ig-grid" data-ig-grid hidden></div>

    <!-- フォールバック: Instagramへのリンクボタン -->
    <div class="ig-placeholder" data-ig-fallback>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="ig-link-btn">
        <span class="ig-icon">📸</span>
        <span>
          <strong>{INSTAGRAM_HANDLE}</strong><br />
          <small>Instagramで最新の投稿を見る</small>
        </span>
        <span class="ig-arrow">→</span>
      </a>
      <p class="ig-note">
        発酵・ローフード・日々のレシピを毎日更新中
      </p>
    </div>
  </div>
</section>

<script define:vars={{ limit }}>
  (async function () {
    const grid = document.querySelector('[data-ig-grid]');
    const fallback = document.querySelector('[data-ig-fallback]');
    if (!grid || !fallback) return;

    try {
      const res = await fetch(`/api/instagram?limit=${limit}`);
      if (!res.ok) return;

      const { posts } = await res.json();
      if (!Array.isArray(posts) || posts.length === 0) return;

      for (const post of posts) {
        if (!post.image) continue;

        const link = document.createElement('a');
        link.className = 'ig-card';
        link.href = post.permalink;
        link.target = '_blank';
        link.rel = 'noopener';

        const img = document.createElement('img');
        img.src = post.image;
        img.loading = 'lazy';
        img.decoding = 'async';
        // キャプション冒頭を代替テキストに（装飾記号・改行は落とす）
        img.alt = (post.caption || 'Instagram の投稿')
          .replace(/\s+/g, ' ')
          .trim()
          .slice(0, 80);

        link.appendChild(img);
        if (post.mediaType === 'VIDEO') {
          const badge = document.createElement('span');
          badge.className = 'ig-badge';
          badge.textContent = '▶';
          link.appendChild(badge);
        }
        grid.appendChild(link);
      }

      if (grid.childElementCount === 0) return;

      grid.hidden = false;
      fallback.hidden = true;
    } catch {
      // 何もしない = フォールバック表示のまま
    }
  })();
</script>

<style>
  .ig-sec {
    padding: 5rem clamp(1rem,4vw,2.8rem);
    background: #F4F2EE;
  }
  .ig-inner { max-width: 1040px; margin: 0 auto; }
  .ig-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;
  }
  .ig-eyebrow {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: .68rem; font-weight: 500;
    letter-spacing: .18em; text-transform: uppercase;
    color: #7AAF2A; display: block; margin-bottom: .5rem;
  }
  .ig-title {
    font-family: 'Noto Serif JP', serif;
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    font-weight: 600; letter-spacing: .08em;
    color: #1C1C1A;
  }
  .ig-follow {
    font-size: .8rem; font-weight: 500;
    color: #7A7A72; text-decoration: none;
    transition: color .2s;
  }
  .ig-follow:hover { color: #A9D159; }

  .ig-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
  }
  @media (max-width: 720px) {
    .ig-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .ig-card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #E4E1DA;
  }
  .ig-card img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform .5s ease, opacity .3s;
  }
  .ig-card:hover img { transform: scale(1.05); opacity: .85; }
  .ig-badge {
    position: absolute; top: .55rem; right: .6rem;
    font-size: .7rem; color: #F4F2EE;
    text-shadow: 0 1px 3px rgba(0,0,0,.5);
    pointer-events: none;
  }

  .ig-placeholder {
    background: #1C1C1A;
    padding: 3rem 2.4rem;
    display: flex; flex-direction: column; align-items: center; gap: 1.2rem;
  }
  .ig-link-btn {
    display: flex; align-items: center; gap: 1.4rem;
    text-decoration: none;
    border: 1px solid rgba(244,242,238,.15);
    padding: 1.4rem 2rem;
    width: 100%; max-width: 480px;
    transition: border-color .2s;
  }
  .ig-link-btn:hover { border-color: #A9D159; }
  .ig-icon { font-size: 1.8rem; flex-shrink: 0; }
  .ig-link-btn strong { color: #F4F2EE; font-size: .95rem; }
  .ig-link-btn small { color: rgba(244,242,238,.5); font-size: .78rem; }
  .ig-arrow { color: #A9D159; font-size: 1.1rem; margin-left: auto; }
  .ig-note { font-size: .78rem; color: rgba(244,242,238,.4); text-align: center; }

  [hidden] { display: none !important; }
</style>
